    // Hotbar slots (0-4) — match TOOLS order: hoe, seeds, water, sickle, axe
    { id: 'hoe',       name: 'Cangkul',       quantity: 1, assetKey: 'tool_hoe',     type: 'tool' },
    { id: 'seeds',     name: 'Benih ' + selectedSeed,  quantity: player.seeds[selectedSeed] ?? 0, assetKey: getCropIconKey(selectedSeed), type: 'seed' },
    { id: 'water',     name: 'Penyiram',      quantity: player.water, assetKey: 'tool_water', type: 'tool' },
    { id: 'sickle',    name: 'Sabit',         quantity: 1, assetKey: 'tool_sickle',  type: 'tool' },
    { id: 'axe',       name: 'Kapak',         quantity: 1, assetKey: 'tool_axe',     type: 'tool' },
    // Bag-only slots (5-17) — crop collection, each with a real asset icon
    { id: 'cabbage',    name: 'Kubis',          quantity: player.inventory.cabbage || 0, assetKey: 'crop_cabbage', type: 'crop' },
    { id: 'parsnip',   name: 'Parsnip',       quantity: player.inventory.parsnip, assetKey: 'crop_parsnip', type: 'crop' },
    { id: 'potato',    name: 'Kentang',       quantity: player.inventory.potato,  assetKey: 'crop_potato',  type: 'crop' },
    { id: 'tomato',    name: 'Tomat',          quantity: player.inventory.tomato, assetKey: 'crop_potato',  type: 'crop' },
    { id: 'corn',      name: 'Jagung',         quantity: player.inventory.corn,   assetKey: 'crop_parsnip', type: 'crop' },
    { id: 'carrot',    name: 'Wortel',          quantity: player.inventory.carrot || 0, assetKey: 'crop_carrot', type: 'crop' },
    { id: 'pumpkin',   name: 'Labu',            quantity: player.inventory.pumpkin || 0, assetKey: 'crop_pumpkin', type: 'crop' },
    { id: 'beetroot', name: 'Bit', quantity: player.inventory.beetroot || 0, assetKey: 'crop_beetroot', type: 'crop' },
    { id: 'cauliflower', name: 'Kembang Kol', quantity: player.inventory.cauliflower || 0, assetKey: 'crop_cauliflower', type: 'crop' },
    { id: 'kale', name: 'Kale', quantity: player.inventory.kale || 0, assetKey: 'crop_kale', type: 'crop' },
    { id: 'radish', name: 'Lobak', quantity: player.inventory.radish || 0, assetKey: 'crop_radish', type: 'crop' },
    { id: 'sunflower', name: 'Bunga Matahari', quantity: player.inventory.sunflower || 0, assetKey: 'crop_sunflower', type: 'crop' },
    { id: 'wheat', name: 'Gandum', quantity: player.inventory.wheat || 0, assetKey: 'crop_wheat', type: 'crop' },
  ];
}
