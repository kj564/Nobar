// ===== World Items (dropped items on ground) =====
// Each: {id, x, y, pickupRadius, bobOffset}
// Items dropped via right-click in Bag, or spawned by other systems.
// Checked each frame for pickup via Euclidean distance.
let itemsInWorld = [];

// ---------- Map generation ----------
function generateMap() {
  map = [];
  cropMap = [];
  canopyMap = [];
  decorMap = [];
  for (let y = 0; y < MAP_H; y++) {
    const row = [], cRow = [], canRow = [], decRow = [];
    for (let x = 0; x < MAP_W; x++) {
      let t = T.GRASS;
      // Random grass variation
      if (Math.random() < 0.18) t = T.GRASS2;
      if (Math.random() < 0.04) t = T.FLOWER;
      if (Math.random() < 0.06) t = T.BUSH;
      row.push(t);
      cRow.push(null);
      canRow.push(C.NONE);
      decRow.push(D.NONE);
    }
    map.push(row);
    cropMap.push(cRow);
    canopyMap.push(canRow);
    decorMap.push(decRow);
  }

  // Border trees
  for (let x = 0; x < MAP_W; x++) {
    map[0][x] = T.TREE;
    map[MAP_H-1][x] = T.TREE;
  }
  for (let y = 0; y < MAP_H; y++) {
    map[y][0] = T.TREE;
    map[y][MAP_W-1] = T.TREE;
  }

  // Pond (top-left area)
  const pondX = 3, pondY = 3, pondW = 6, pondH = 4;
  for (let y = pondY; y < pondY + pondH; y++) {
    for (let x = pondX; x < pondX + pondW; x++) {
      map[y][x] = T.WATER;
    }
  }
  // Pond edges (sand)
  for (let y = pondY - 1; y < pondY + pondH + 1; y++) {
    for (let x = pondX - 1; x < pondX + pondW + 1; x++) {
      if (y < 0 || y >= MAP_H || x < 0 || x >= MAP_W) continue;
      if (map[y][x] !== T.WATER) map[y][x] = T.SAND;
    }
  }
  // Re-apply pond (sand override would replace water)
  for (let y = pondY; y < pondY + pondH; y++) {
    for (let x = pondX; x < pondX + pondW; x++) {
      map[y][x] = T.WATER;
    }
  }

  // Player house (bottom-left)
  const houseX = 4, houseY = 22, houseW = 7, houseH = 5;
  for (let y = houseY; y < houseY + houseH; y++) {
    for (let x = houseX; x < houseX + houseW; x++) {
      if (y === houseY || y === houseY + houseH - 1 || x === houseX || x === houseX + houseW - 1) {
        map[y][x] = T.WALL;
      } else {
        map[y][x] = T.FLOOR;
      }
    }
  }
  // Door
  map[houseY + houseH - 1][houseX + Math.floor(houseW/2)] = T.FLOOR;

  // Shop building (top-right)
  const shopX = 30, shopY = 4, shopW = 7, shopH = 5;
  for (let y = shopY; y < shopY + shopH; y++) {
    for (let x = shopX; x < shopX + shopW; x++) {
      if (y === shopY || y === shopY + shopH - 1 || x === shopX || x === shopX + shopW - 1) {
        map[y][x] = T.SHOP_WALL;
      } else {
        map[y][x] = T.SHOP_FLOOR;
      }
    }
  }
  // Shop door
  map[shopY + shopH - 1][shopX + Math.floor(shopW/2)] = T.SHOP_FLOOR;

  // ===== Blacksmith building (top-center, between shop and farm) =====
  // fomt farmer.cc func_0800E550 — tool upgrade NPC. We reuse SHOP_WALL/SHOP_FLOOR
  // tiles (no separate BLACKSMITH tile type needed). Position: x=22-28, y=4-8.
  const blackX = 22, blackY = 4, blackW = 7, blackH = 5;
  for (let y = blackY; y < blackY + blackH; y++) {
    for (let x = blackX; x < blackX + blackW; x++) {
      if (y === blackY || y === blackY + blackH - 1 || x === blackX || x === blackX + blackW - 1) {
        map[y][x] = T.SHOP_WALL;   // reuse shop wall tile
      } else {
        map[y][x] = T.SHOP_FLOOR;  // reuse shop floor tile
      }
    }
  }
  // Blacksmith door (bottom-center, same pattern as shop)
  map[blackY + blackH - 1][blackX + Math.floor(blackW/2)] = T.SHOP_FLOOR;

  // ===== fomt Barn building (barn.hh) — 8x6 building at top-left =====
  // fomt Barn struct: MAX_CAPACITY=16 (8 initial + 8 upgrade). Houses cows + sheep.
  // Reuse SHOP_WALL/SHOP_FLOOR tiles (no separate BARN tile type needed).
  // Position: x=2-9, y=4-9 (mirrors shop position on opposite side).
  const barnX = 2, barnY = 4, barnW = 8, barnH = 6;
  for (let y = barnY; y < barnY + barnH; y++) {
    for (let x = barnX; x < barnX + barnW; x++) {
      if (y === barnY || y === barnY + barnH - 1 || x === barnX || x === barnX + barnW - 1) {
        map[y][x] = T.SHOP_WALL;
      } else {
        map[y][x] = T.SHOP_FLOOR;
      }
    }
  }
  // Barn door (bottom-center)
  map[barnY + barnH - 1][barnX + Math.floor(barnW/2)] = T.SHOP_FLOOR;

  // ===== fomt Coop building (coop.hh) — 6x5 building at top-center-left =====
  // fomt Coop struct: MAX_CAPACITY=8 (4 initial + 4 upgrade). Houses chickens + incubator.
  // Position: x=11-16, y=4-8 (just right of barn, left of blacksmith).
  const coopX = 11, coopY = 4, coopW = 6, coopH = 5;
  for (let y = coopY; y < coopY + coopH; y++) {
    for (let x = coopX; x < coopX + coopW; x++) {
      if (y === coopY || y === coopY + coopH - 1 || x === coopX || x === coopX + coopW - 1) {
        map[y][x] = T.SHOP_WALL;
      } else {
        map[y][x] = T.SHOP_FLOOR;
      }
    }
  }
  // Coop door (bottom-center)
  map[coopY + coopH - 1][coopX + Math.floor(coopW/2)] = T.SHOP_FLOOR;

  // ===== fomt Carpenter building (farm_house.hh Carpenter "Gotz") — 7x5 building =====
  // Position: bottom-right (x=30-36, y=22-26) — mirrors player house on opposite side.
  // Sells house upgrades + furniture + kitchen tools + makers + vase flowers.
  // Reuse SHOP_WALL/SHOP_FLOOR tiles (no separate CARPENTER tile type needed).
  const carpX = 30, carpY = 22, carpW = 7, carpH = 5;
  for (let y = carpY; y < carpY + carpH; y++) {
    for (let x = carpX; x < carpX + carpW; x++) {
      if (y === carpY || y === carpY + carpH - 1 || x === carpX || x === carpX + carpW - 1) {
        map[y][x] = T.SHOP_WALL;
      } else {
        map[y][x] = T.SHOP_FLOOR;
      }
    }
  }
  // Carpenter door (bottom-center, same pattern as shop)
  map[carpY + carpH - 1][carpX + Math.floor(carpW/2)] = T.SHOP_FLOOR;

  // ===== fomt Harvest Sprite hut (harvest_sprite.hh) — small 1-tile building in the forest area =====
  // Placed at (37, 4): just east of the Shop building (x=30-36, y=4-8), in the top-right "forest"
  // corner of the map (between the Shop wall and the right border trees). Player approaches from
  // the south (y >= 5) and presses E to open openSpriteHut().
  // (Spec said (35, 5) but that overlaps the Shop interior — relocated 2 tiles east.)
  const spriteHutX = 37, spriteHutY = 4;
  map[spriteHutY][spriteHutX] = T.SPRITE_HUT;

  // Paths connecting house -> center farm, shop -> center, blacksmith -> center
  for (let x = houseX + Math.floor(houseW/2); x < 20; x++) {
    if (map[houseY - 1][x] === T.GRASS || map[houseY - 1][x] === T.GRASS2) {
      map[houseY - 1][x] = T.PATH;
    }
  }
  for (let y = shopY + shopH; y < 20; y++) {
    if (map[y][shopX + Math.floor(shopW/2)] === T.GRASS || map[y][shopX + Math.floor(shopW/2)] === T.GRASS2) {
      map[y][shopX + Math.floor(shopW/2)] = T.PATH;
    }
  }
  // Blacksmith path: from blacksmith door (x = blackX + Math.floor(blackW/2)) south to y=11
  for (let y = blackY + blackH; y < 12; y++) {
    const bx = blackX + Math.floor(blackW/2);
    if (map[y][bx] === T.GRASS || map[y][bx] === T.GRASS2) {
      map[y][bx] = T.PATH;
    }
  }
  // Barn path: from barn door (x = barnX + Math.floor(barnW/2)) south to y=11
  for (let y = barnY + barnH; y < 12; y++) {
    const bx = barnX + Math.floor(barnW/2);
    if (map[y][bx] === T.GRASS || map[y][bx] === T.GRASS2) {
      map[y][bx] = T.PATH;
    }
  }
  // Coop path: from coop door (x = coopX + Math.floor(coopW/2)) south to y=11
  for (let y = coopY + coopH; y < 12; y++) {
    const bx = coopX + Math.floor(coopW/2);
    if (map[y][bx] === T.GRASS || map[y][bx] === T.GRASS2) {
      map[y][bx] = T.PATH;
    }
  }
  // Carpenter path: from carpenter door (x = carpX + Math.floor(carpW/2)) north to y=21
  // (carpenter is at bottom-right; path leads from door (y=26) up to row 21, joining
  // the same approach as the house's east-west path strip)
  for (let y = 21; y < carpY; y++) {
    const bx = carpX + Math.floor(carpW/2);
    if (map[y][bx] === T.GRASS || map[y][bx] === T.GRASS2) {
      map[y][bx] = T.PATH;
    }
  }

  // Fences around farmable area (center)
  const farmX = 14, farmY = 12, farmW = 12, farmH = 8;
  for (let x = farmX; x < farmX + farmW; x++) {
    if (map[farmY][x] !== T.PATH) map[farmY][x] = T.FENCE;
    if (map[farmY + farmH - 1][x] !== T.PATH) map[farmY + farmH - 1][x] = T.FENCE;
  }
  for (let y = farmY; y < farmY + farmH; y++) {
    if (map[y][farmX] !== T.PATH) map[y][farmX] = T.FENCE;
    if (map[y][farmX + farmW - 1] !== T.PATH) map[y][farmX + farmW - 1] = T.FENCE;
  }
  // Fence opening (gate) at bottom-center
  map[farmY + farmH - 1][farmX + Math.floor(farmW/2)] = T.PATH;
  map[farmY + farmH - 1][farmX + Math.floor(farmW/2) + 1] = T.PATH;

  // A few decorative trees inside border
  // (Note: [6,8] removed — would now collide with the Barn building at x=2-9, y=4-9)
  // (Note: [35,24] removed — would now collide with the Carpenter building at x=30-36, y=22-26)
  const treeSpots = [[3,12],[33,18],[8,18],[18,5],[26,26],[36,18]];
  for (const [x,y] of treeSpots) {
    if (map[y] && map[y][x] !== T.WATER) map[y][x] = T.TREE;
  }

  // ===== Layer 4 (WalkBehind): Tree canopies + building roof overhangs =====
  // For each tree at (x, y), add canopy leaves at the tile ABOVE the trunk.
  // Player walking onto a canopy tile is covered by Layer 4 (rendered above player).
  function addTreeCanopy(tx, ty) {
    // Crown extends 1 tile upward from trunk (canopy overhangs down to meet trunk)
    if (ty - 1 >= 0) canopyMap[ty - 1][tx] = C.TREE_CANOPY;
  }
  // Scan map for all tree tiles and grow their canopies
  for (let y = 0; y < MAP_H; y++) {
    for (let x = 0; x < MAP_W; x++) {
      if (map[y][x] === T.TREE) addTreeCanopy(x, y);
    }
  }

  // Building roof overhangs: roof extends 1 tile ABOVE the top wall.
  // Player walking above the building is covered by the roof (walk-behind).
  // House roof
  for (let x = houseX; x < houseX + houseW; x++) {
    if (houseY - 1 >= 0) canopyMap[houseY - 1][x] = C.ROOF_HOUSE;
  }
  // Shop roof
  for (let x = shopX; x < shopX + shopW; x++) {
    if (shopY - 1 >= 0) canopyMap[shopY - 1][x] = C.ROOF_SHOP;
  }
  // Blacksmith roof (reuse SHOP roof overhang tile)
  for (let x = blackX; x < blackX + blackW; x++) {
    if (blackY - 1 >= 0) canopyMap[blackY - 1][x] = C.ROOF_SHOP;
  }
  // Barn roof (reuse SHOP roof overhang tile)
  for (let x = barnX; x < barnX + barnW; x++) {
    if (barnY - 1 >= 0) canopyMap[barnY - 1][x] = C.ROOF_SHOP;
  }
  // Coop roof (reuse SHOP roof overhang tile)
  for (let x = coopX; x < coopX + coopW; x++) {
    if (coopY - 1 >= 0) canopyMap[coopY - 1][x] = C.ROOF_SHOP;
  }
  // Carpenter roof (reuse SHOP roof overhang tile — fomt carpenter "Gotz" cottage)
  for (let x = carpX; x < carpX + carpW; x++) {
    if (carpY - 1 >= 0) canopyMap[carpY - 1][x] = C.ROOF_SHOP;
  }

  // ===== Layer 5 (Decor): sparkles near flowers (top-most) =====
  for (let y = 0; y < MAP_H; y++) {
    for (let x = 0; x < MAP_W; x++) {
      if (map[y][x] === T.FLOWER && Math.random() < 0.3) {
        decorMap[y][x] = D.SPARKLE;
      }
    }
  }
  // Nighttime fireflies are spawned dynamically in updateDecor() based on time of day

  // NPCs - now use Ninja Adventure complete character sprites (16x16 frames in 4x4 grid)
  // Sprite names map to: assets/ninja-adventure/Characters/<Name>_walk.png
  // ===== fomt NPC gift preferences (npc_entity.cc affinity tables) =====
  // Each NPC has loved/liked/neutral/disliked/hated gift lists. Affinity deltas
  // match fomt: loved +300, liked +100, neutral +50, disliked -20, hated -500.
  // Lists are arrays of game crop keys (parsnip/potato/tomato/.../wheat).
  // Maya (bachelorette-type): loves Strawberry (game key: radish), likes all crops, hates nothing.
  // Pak Tom (old man): loves Potato, likes all crops, hates nothing specific.
  const ALL_CROP_KEYS = SEED_LIST.slice();
  npcs = [
    { id: 'maya', name: 'Maya', x: 18 * TILE + TILE/2, y: 6 * TILE + TILE/2, color: '#e36a8a', hair: '#3a2030', dir: 'down',
      sprite: 'Princess',  // female character with complete body sprite
      // fomt NPC affinity (npc.hh:11-45): friendship 0..255 init 50
      friendship: 50, days_since_last_spoken: 0,
      spoken_today: false, spoken_just_now: false, gifted_today: false, met: false,
      // ===== fomt NPC daily schedule (ScheduleInfo → Schedule → time_entries) =====
      // Simplified fomt-faithful: each entry is {hour, x, y, dir}. The largest hour
      // <= current game hour wins. NPC walks toward that target (x, y) at scheduleSpeed;
      // once arrived it faces `dir` and idles. After midnight (hour 0-5) the NPC stays
      // at the last entry (sleeping). If !met, NPC stays at schedule[0] (home).
      // NOTE: positions are tile CENTERS (col*TILE + TILE/2) so the NPC's 0.35*TILE
      // collision box never straddles an adjacent non-walkable tile (border tree, etc.).
      schedule: [
        { hour: 6,  x: 18*TILE + TILE/2, y: 6*TILE  + TILE/2, dir: 'down' },   // morning: home area
        { hour: 9,  x: 14*TILE + TILE/2, y: 10*TILE + TILE/2, dir: 'down' },   // morning: west of field (north of fence)
        { hour: 12, x: 20*TILE + TILE/2, y: 10*TILE + TILE/2, dir: 'down' },   // noon: town center (north of fenced field)
        { hour: 15, x: 25*TILE + TILE/2, y: 8*TILE  + TILE/2, dir: 'left' },    // afternoon: near blacksmith/shop
        { hour: 18, x: 18*TILE + TILE/2, y: 6*TILE  + TILE/2, dir: 'down' },   // evening: returns home
        { hour: 22, x: 18*TILE + TILE/2, y: 6*TILE  + TILE/2, dir: 'down' },   // night: sleeping
      ],
      scheduleSpeed: 1.5,   // pixels per frame at 60fps baseline
      moving: false, walkTime: 0, walkFrame: 0,
      scheduleTargetX: 18*TILE + TILE/2, scheduleTargetY: 6*TILE + TILE/2, scheduleTargetDir: 'down',
      // fomt gift preferences (npc_entity.cc): loved=+300, liked=+100, neutral=+50, disliked=-20, hated=-500
      giftLoves: ['radish'],                  // Strawberry (game: radish) → +300
      giftLikes: ALL_CROP_KEYS.filter(k => k !== 'radish'),  // all other crops → +100
      giftDislikes: [],                       // none
      giftHates: [],                          // none (Maya hates Junk Ore in fomt, but we have no mineral gifts yet)
      dialog: [
        'Halo petani baru! Selamat datang di Harvest Vale.',
        'Aku Maya. Kalau butuh benih, datangi toko di utara.',
        'Tanaman butuh air setiap hari supaya tumbuh. Jangan lupa siram ya!'
      ],
      // ===== fomt 1:1 Bachelorette system (bachelorette.hh:8-32 — Bachelorette extends Npc) =====
      // love: 16-bit (0..65535), init 0 (bachelorette.cc:8)
      // player_events: 3-bit (0..6), init 0
      // days_since_player_event: 3-bit (0..7), init 0
      // rival_events: 3-bit (0..5), init 0
      // days_since_rival_event: 3-bit (0..7), init 0
      // unk_17_4: 3-bit (0..5), init 0 (fomt method_0809E550 counter — cap 5)
      isBachelorette: true,
      love: 0,
      playerEvents: 0,
      daysSincePlayerEvent: 0,
      rivalEvents: 0,
      daysSinceRivalEvent: 0,
      unk_17_4: 0,
      _bachProposeToastShown: false,  // local UI flag (not saved): tracks marriage-toast shown
    },
    { id: 'tom', name: 'Pak Tom', x: 28 * TILE + TILE/2, y: 18 * TILE + TILE/2, color: '#5a8a4a', hair: '#888070', dir: 'down',
      sprite: 'OldMan',  // older male character with complete body sprite
      // fomt NPC affinity (npc.hh:11-45): friendship 0..255 init 50
      friendship: 50, days_since_last_spoken: 0,
      spoken_today: false, spoken_just_now: false, gifted_today: false, met: false,
      // ===== fomt NPC daily schedule (same format as Maya above) =====
      // NOTE: Pak Tom's region is the south grass area (south of the fenced field).
      // Targets avoid the fenced field interior (rows 12-19, cols 14-25) — entering
      // would require pathfinding around the perimeter fence. Original spec
      // positions (20, 16), (15, 11) moved to south-side equivalents.
      schedule: [
        { hour: 6,  x: 28*TILE + TILE/2, y: 18*TILE + TILE/2, dir: 'down' },  // morning: home
        { hour: 8,  x: 30*TILE + TILE/2, y: 20*TILE + TILE/2, dir: 'down' },  // morning: garden
        { hour: 11, x: 20*TILE + TILE/2, y: 22*TILE + TILE/2, dir: 'down' },  // midday: south town (south of fenced field)
        { hour: 14, x: 15*TILE + TILE/2, y: 21*TILE + TILE/2, dir: 'right' }, // afternoon: near south field edge
        { hour: 17, x: 28*TILE + TILE/2, y: 18*TILE + TILE/2, dir: 'down' },  // evening: returns home
        { hour: 21, x: 28*TILE + TILE/2, y: 18*TILE + TILE/2, dir: 'down' },  // night: sleeping
      ],
      scheduleSpeed: 1.2,
      moving: false, walkTime: 0, walkFrame: 0,
      scheduleTargetX: 28*TILE + TILE/2, scheduleTargetY: 18*TILE + TILE/2, scheduleTargetDir: 'down',
      // fomt gift preferences (npc_entity.cc): loved=+300, liked=+100, neutral=+50, disliked=-20, hated=-500
      giftLoves: ['potato'],                  // Potato → +300
      giftLikes: ALL_CROP_KEYS.filter(k => k !== 'potato'),  // all other crops → +100
      giftDislikes: [],
      giftHates: [],
      dialog: [
        'Hmm... musim ini tanahnya cukup subur.',
        'Jangan lupa istirahat. Tidur di rumah biar energi pulih.'
      ]},
  ];
}

// ---------- Ambient wildlife & scenery ----------
function findAmbientTile(tx, ty) {
  // Search outward from the preferred location for a safe, visible tile.
  for (let radius = 0; radius <= 6; radius++) {
    for (let oy = -radius; oy <= radius; oy++) {
      for (let ox = -radius; ox <= radius; ox++) {
        if (Math.max(Math.abs(ox), Math.abs(oy)) !== radius) continue;
        const x = tx + ox, y = ty + oy;
        if (x < 1 || y < 1 || x >= MAP_W - 1 || y >= MAP_H - 1) continue;
        const tile = map[y]?.[x];
        if (tile == null || tile === T.WATER || tileRenderLayer(tile) === 3) continue;
        // Avoid placing scenery directly in the fenced crop rows.
        if (x >= 14 && x <= 25 && y >= 12 && y <= 19) continue;
        return { x, y };
      }
    }
  }
  return { x: Math.max(1, Math.min(MAP_W - 2, tx)), y: Math.max(1, Math.min(MAP_H - 2, ty)) };
}

function createAmbientLife() {
  ambientAnimals = [];
  ambientProps = [];
  const animals = [
    { id: 'bird-1', type: 'bird', path: 'Elements/Animals/spr_deco_bird_01_strip4.png', frames: 4, at: [11, 8], radius: 1.5, speed: 13 },
    { id: 'chicken-1', type: 'chicken', path: 'Elements/Animals/spr_deco_chicken_01_strip4.png', frames: 4, at: [12, 10], radius: 1.8, speed: 10 },
    { id: 'duck-1', type: 'duck', path: 'Elements/Animals/spr_deco_duck_01_strip4.png', frames: 4, at: [10, 8], radius: 1.2, speed: 8 },
    { id: 'cow-1', type: 'cow', path: 'Elements/Animals/spr_deco_cow_strip4.png', frames: 4, at: [27, 7], radius: 1.5, speed: 6 },
    { id: 'sheep-1', type: 'sheep', path: 'Elements/Animals/spr_deco_sheep_01_strip4.png', frames: 4, at: [28, 24], radius: 1.4, speed: 7 },
    { id: 'pig-1', type: 'pig', path: 'Elements/Animals/spr_deco_pig_01_strip4.png', frames: 4, at: [27, 26], radius: 1.2, speed: 7 },
  ];
  for (const def of animals) {
    const p = findAmbientTile(def.at[0], def.at[1]);
    const x = p.x * TILE, y = p.y * TILE;
    ambientAnimals.push({
      ...def, x, y, homeX: x, homeY: y, targetX: x, targetY: y,
      dir: 1, wait: Math.random() * 2, phase: Math.random() * 10,
    });
  }
  const props = [
    { id: 'windmill', path: 'Elements/Other/spr_deco_windmill_withshadow_strip9.png', frames: 9, at: [25, 4], size: 64, animated: true },
    { id: 'mushroom-blue', path: 'Elements/Plants/spr_deco_mushroom_blue_01_strip4.png', frames: 4, at: [12, 7], size: 30, animated: true },
    { id: 'mushroom-red', path: 'Elements/Plants/spr_deco_mushroom_red_01_strip4.png', frames: 4, at: [29, 23], size: 28, animated: true },
    { id: 'mushroom-blue-2', path: 'Elements/Plants/spr_deco_mushroom_blue_02_strip4.png', frames: 4, at: [13, 25], size: 28, animated: true },
    { id: 'mushroom-blue-3', path: 'Elements/Plants/spr_deco_mushroom_blue_03_strip4.png', frames: 4, at: [9, 18], size: 26, animated: true },
    { id: 'glint-1', path: 'Elements/VFX/Glint/spr_deco_glint_01_strip6.png', frames: 6, at: [16, 8], size: 22, animated: true },
    { id: 'glint-2', path: 'Elements/VFX/Glint/spr_deco_glint_02_strip4.png', frames: 4, at: [27, 18], size: 18, animated: true },
    { id: 'glint-3', path: 'Elements/VFX/Glint/spr_deco_glint_01_strip6.png', frames: 6, at: [11, 26], size: 20, animated: true },
    { id: 'home-smoke', path: 'Elements/VFX/Chimney Smoke/chimneysmoke_01.gif', frames: 1, at: [7, 21], size: 42, animated: false },
  ];
  for (const def of props) {
    const p = findAmbientTile(def.at[0], def.at[1]);
    ambientProps.push({ ...def, x: p.x * TILE, y: p.y * TILE, phase: Math.random() * 8 });
  }
}

function updateAmbientLife(dt) {
  for (const a of ambientAnimals) {
    a.wait = Math.max(0, a.wait - dt);
    const dx = a.targetX - a.x, dy = a.targetY - a.y;
    const distance = Math.hypot(dx, dy);
    if (distance < 2) {
      if (a.wait > 0) continue;
      const radiusPx = a.radius * TILE;
      let foundTarget = false;
      for (let attempt = 0; attempt < 6; attempt++) {
        const tx = a.homeX + (Math.random() * 2 - 1) * radiusPx;
        const ty = a.homeY + (Math.random() * 2 - 1) * radiusPx;
        const gx = Math.floor(tx / TILE), gy = Math.floor(ty / TILE);
        if (gx < 1 || gy < 1 || gx >= MAP_W - 1 || gy >= MAP_H - 1) continue;
        const tile = map[gy]?.[gx];
        if (tile == null || tile === T.WATER || tileRenderLayer(tile) === 3) continue;
        if (gx >= 14 && gx <= 25 && gy >= 12 && gy <= 19) continue;
        a.targetX = tx; a.targetY = ty;
        foundTarget = true;
        break;
      }
      a.wait = foundTarget ? 0 : 0.8;
      continue;
    }
    if (a.wait > 0) continue;
    const step = Math.min(distance, a.speed * dt);
    a.x += dx / distance * step;
    a.y += dy / distance * step;
    if (Math.abs(dx) > 0.5) a.dir = dx < 0 ? -1 : 1;
    if (step >= distance) a.wait = 0.5 + Math.random() * 2.2;
  }
}

function drawAmbientAnimal(a) {
  const img = getAsset(a.path);
  if (!img || !img.naturalWidth) return;
  const frameW = img.naturalWidth / a.frames;
  const frameH = img.naturalHeight;
  if (!(frameW > 0 && frameH > 0)) return;
  const frame = Math.floor((performance.now() / 220) + a.phase) % a.frames;
  const scale = Math.min(1.25, 32 / Math.max(frameW, frameH));
  const dw = frameW * scale, dh = frameH * scale;
  const sx = a.x - camera.x + (TILE - dw) / 2;
  const sy = a.y - camera.y + TILE - dh;
  if (sx < -TILE || sy < -TILE || sx > canvas.clientWidth + TILE || sy > canvas.clientHeight + TILE) return;
  ctx.save();
  if (a.dir < 0) {
    ctx.translate(sx + dw, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(img, frame * frameW, 0, frameW, frameH, 0, sy, dw, dh);
  } else {
    ctx.drawImage(img, frame * frameW, 0, frameW, frameH, sx, sy, dw, dh);
  }
  ctx.restore();
}

// ===== fomt Record Player furniture tile renderer (furniture.hh:75) =====
// Draws the record player furniture at RECORD_PLAYER_INTERIOR_TILE when the player owns
// it. Visual is a small wooden box with a spinning vinyl disc when an album is inserted.
// Tile-locked: drawn at the same world position each frame; follows camera like other tiles.
function drawRecordPlayerFurniture() {
  if (!farmHouse.hasRecordPlayer) return;
  const { tx, ty } = RECORD_PLAYER_INTERIOR_TILE;
  const px = tx * TILE - camera.x;
  const py = ty * TILE - camera.y;
  // Cull if off-screen
  if (px < -TILE || py < -TILE || px > canvas.clientWidth + TILE || py > canvas.clientHeight + TILE) return;
  // Wooden base box (24x16)
  ctx.fillStyle = '#6a3a1a';
  ctx.fillRect(px + 4, py + 12, 24, 16);
  ctx.fillStyle = '#4a2a0a';
  ctx.fillRect(px + 4, py + 12, 24, 2);   // top edge
  ctx.fillStyle = '#3a1a00';
  ctx.fillRect(px + 4, py + 26, 24, 2);   // bottom shadow
  // Turntable platter (vinyl disc) — spinning when an album is inserted
  if (rpHasAlbum()) {
    const cx = px + 16, cy = py + 20;
    const t = performance.now() / 1000;
    const rot = t * 4;   // ~4 rad/s rotation
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(rot);
    // Vinyl: black disc with red center label
    ctx.fillStyle = '#1a1a1a';
    ctx.beginPath(); ctx.arc(0, 0, 7, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#c0303a';
    ctx.beginPath(); ctx.arc(0, 0, 3, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = '#1a1a1a';
    ctx.beginPath(); ctx.arc(0, 0, 1, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
    // Tonearm (small line from upper-right corner to disc)
    ctx.strokeStyle = '#8a8a8a';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(px + 22, py + 14);
    ctx.lineTo(cx + 4, cy - 3);
    ctx.stroke();
    ctx.lineWidth = 1;
  } else {
    // Empty platter: gray circle
    ctx.fillStyle = '#5a5a5a';
    ctx.beginPath();
    ctx.arc(px + 16, py + 20, 6, 0, Math.PI * 2);
    ctx.fill();
  }
}

function drawAmbientProp(p) {
  const img = getAsset(p.path);
  if (!img || !img.naturalWidth) return;
  const frameW = img.naturalWidth / p.frames;
  const frameH = img.naturalHeight;
  if (!(frameW > 0 && frameH > 0)) return;
  const frame = p.animated ? Math.floor((performance.now() / (p.id === 'windmill' ? 130 : 430)) + p.phase) % p.frames : 0;
  const scale = Math.min(p.size / Math.max(frameW, frameH), p.id === 'windmill' ? 2 : 1.5);
  const dw = frameW * scale, dh = frameH * scale;
  const sx = p.x - camera.x + TILE / 2 - dw / 2;
  const sy = p.y - camera.y + TILE - dh;
  if (sx < -p.size || sy < -p.size || sx > canvas.clientWidth + p.size || sy > canvas.clientHeight + p.size) return;
  ctx.drawImage(img, frame * frameW, 0, frameW, frameH, sx, sy, dw, dh);
}

// ---------- Save / Load ----------
const SAVE_VERSION = 3;  // v3 = fomt-faithful stamina/fatigue/power berries/kappa berry + NPC friendship
function save() {
  try {
    const data = {
      v: SAVE_VERSION,
      map, cropMap, canopyMap, decorMap,
      player, day, season, seasonDay, timeOfDay,
      selectedTool, selectedSeed,
      // fomt collectibles state (power berries + kappa berry)
      powerBerrySpots, kappaBerrySpot,
      // fomt 1:1 storage/rucksack/shippingBin/toolLevels state
      rucksack: {
        itemSlotsUsed: rucksack.itemSlotsUsed,
        toolSlotsUsed: rucksack.toolSlotsUsed,
        items: rucksack.items,
        tools: rucksack.tools,
      },
      fridge, shelf, toolChest,
      shippingBin: {
        valueShipped: shippingBin.valueShipped,
        stats: shippingBin.stats.map(s => ({ amountShipped: s.amountShipped, displayEnabled: s.displayEnabled })),
      },
      toolLevels: toolLevels.map(t => ({ usage: t.usage, committedLevel: t.committedLevel, pendingLevel: t.pendingLevel })),
      // fomt 1:1 livestock state (animal.hh, livestock.hh, cow/sheep/chicken, barn/coop structs)
      livestock: {
        cows: livestock.cows.map(cloneAnimalForSave),
        sheep: livestock.sheep.map(cloneAnimalForSave),
        chickens: livestock.chickens.map(cloneAnimalForSave),
      },
      barnState: { upgradeLevel: barnState.upgradeLevel, fodder: barnState.fodder },
      coopState: {
        upgradeLevel: coopState.upgradeLevel, feed: coopState.feed,
        incubator: coopState.incubator.map(i => ({ occupied: i.occupied, daysLeft: i.daysLeft })),
      },
      // fomt 1:1 Harvest Sprite team (harvest_sprite.hh + harvest_sprite.cc)
      harvestSprites: harvestSprites.map(s => ({
        name: s.name, friendship: s.friendship, met: !!s.met,
        spoken_today: !!s.spoken_today, gifted_today: !!s.gifted_today,
        days_since_last_spoken: s.days_since_last_spoken || 0,
        task_exp: s.task_exp.slice(),
        minigame_exp: s.minigame_exp.slice(),
        current_task: s.current_task,
        work_days_left: s.work_days_left,
        played_minigame: !!s.played_minigame,
      })),
      // fomt 1:1 Maker system (food.def + article.def + product.def)
      makers: { mayonnaise: makers.mayonnaise, cheese: makers.cheese, yarn: makers.yarn },
      // fomt 1:1 FarmHouse (farm_house.hh + farm_house.cc)
      farmHouse: {
        upgradeLevel: farmHouse.upgradeLevel,
        hasBathroom: farmHouse.hasBathroom, hasFridge: farmHouse.hasFridge,
        hasShelf: farmHouse.hasShelf, hasRecordPlayer: farmHouse.hasRecordPlayer,
        hasLargeBed: farmHouse.hasLargeBed, hasCarpet: farmHouse.hasCarpet,
        hasVase: farmHouse.hasVase,
        vaseArticleId: farmHouse.vaseArticleId, vaseArticleLifespan: farmHouse.vaseArticleLifespan,
        hasMirror: farmHouse.hasMirror, hasClock: farmHouse.hasClock,
        hasStocking: farmHouse.hasStocking, stockingArticleId: farmHouse.stockingArticleId,
        fireplaceLighted: farmHouse.fireplaceLighted, hasKitchen: farmHouse.hasKitchen,
        hasKitchenKnife: farmHouse.hasKitchenKnife, hasKitchenFryingPan: farmHouse.hasKitchenFryingPan,
        hasKitchenPot: farmHouse.hasKitchenPot, hasKitchenMixer: farmHouse.hasKitchenMixer,
        hasKitchenWhisk: farmHouse.hasKitchenWhisk, hasKitchenRollingPin: farmHouse.hasKitchenRollingPin,
        hasKitchenOven: farmHouse.hasKitchenOven, hasKitchenSeasoningSet: farmHouse.hasKitchenSeasoningSet,
        // fomt RecordPlayer state (furniture.hh:75-86, record_player.cc)
        recordPlayerHasAlbum: farmHouse.recordPlayerHasAlbum,
        recordPlayerAlbumId: farmHouse.recordPlayerAlbumId,
      },
      // fomt NPC affinity state (friendship, met, days_since_last_spoken, etc.)
      // Bachelorette fields (bachelorette.hh:26-31) only saved when isBachelorette=true.
      npcs: npcs.map(n => ({
        id: n.id, x: n.x, y: n.y, dir: n.dir,
        friendship: n.friendship, days_since_last_spoken: n.days_since_last_spoken,
        spoken_today: n.spoken_today, gifted_today: n.gifted_today, met: n.met,
        ...(n.isBachelorette ? {
          isBachelorette: true,
          love: n.love || 0,
          playerEvents: n.playerEvents || 0,
          daysSincePlayerEvent: n.daysSincePlayerEvent || 0,
          rivalEvents: n.rivalEvents || 0,
          daysSinceRivalEvent: n.daysSinceRivalEvent || 0,
          unk_17_4: n.unk_17_4 || 0,
        } : {}),
      })),
    };
    localStorage.setItem(SAVE_KEY, JSON.stringify(data));
  } catch(e) {}
}
// cloneAnimalForSave(a): produce a plain object copy of an animal with all fomt fields
// (so JSON.stringify can serialize — no methods, no circular refs).
function cloneAnimalForSave(a) {
  const out = { kind: a.kind, name: a.name,
    affection: a.affection, age: a.age, days_fed: a.days_fed,
    fed: a.fed, brushed: a.brushed, talked: a.talked,
    sick: a.sick, unhappy: a.unhappy, days_sick: a.days_sick, days_unhappy: a.days_unhappy,
    festival_winner: a.festival_winner,
    outdoor_minutes: a.outdoor_minutes, total_outdoor_minutes: a.total_outdoor_minutes,
    growthStage: a.growthStage,
  };
  if (a.kind === 'cow') out.milked = a.milked;
  if (a.kind === 'cow' || a.kind === 'sheep') {
    out.pregnant = a.pregnant;
    out.days_pregnant = a.days_pregnant;
    out.days_pregnant_healthy = a.days_pregnant_healthy;
  }
  if (a.kind === 'sheep') out.days_until_product = a.days_until_product;
  if (a.kind === 'chicken') out.hasEgg = a.hasEgg;
  return out;
}
function load() {
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return false;
    const d = JSON.parse(raw);
    if (!d || !d.map) return false;
    map = d.map; cropMap = d.cropMap;
    // v2 saves include canopyMap & decorMap; v1 saves regenerate them from map
    if (d.canopyMap && d.decorMap) {
      canopyMap = d.canopyMap;
      decorMap = d.decorMap;
    } else {
      // Migration: rebuild canopy/decor from existing map (trees + buildings)
      rebuildCanopyFromMap();
      rebuildDecorFromMap();
    }
    player = Object.assign(player, d.player);
    // Save migration: preserve newly added crop keys when loading older saves.
    player.inventory = Object.assign({}, player.inventory || {});
    player.seeds = Object.assign({}, player.seeds || {});
    for (const cropKey of SEED_LIST) {
      if (!Number.isFinite(player.inventory[cropKey])) player.inventory[cropKey] = 0;
      if (!Number.isFinite(player.seeds[cropKey])) player.seeds[cropKey] = 0;
    }
    // v3 migration: fomt stamina/fatigue/powerBerries/kappaBerry/maxStamina
    if (!Number.isFinite(player.stamina))    player.stamina = 150;
    if (!Number.isFinite(player.fatigue))    player.fatigue = 0;
    if (!Number.isFinite(player.powerBerries)) player.powerBerries = 0;
    if (typeof player.kappaBerry !== 'boolean') player.kappaBerry = false;
    if (!Number.isFinite(player.maxStamina))  player.maxStamina = 150 + (player.powerBerries || 0) * 10;
    // Remove legacy energy field if present (v1/v2 saves)
    if ('energy' in player && !('stamina' in d.player)) {
      // Convert old energy (0..100) → stamina proportionally
      player.stamina = Math.round((player.energy / 100) * player.maxStamina);
      delete player.energy;
    } else {
      delete player.energy;  // always strip legacy field
    }
    day = d.day; season = d.season || 'spring'; seasonDay = d.seasonDay || 1;
    timeOfDay = d.timeOfDay || 6*60;
    selectedTool = d.selectedTool || 'hoe';
    selectedSeed = d.selectedSeed || 'parsnip';
    // v3: restore fomt NPC affinity state (friendship, met, days_since_last_spoken, etc.)
    if (d.npcs) {
      for (const sn of d.npcs) {
        const n = npcs.find(x => x.id === sn.id);
        if (n) {
          n.x = sn.x; n.y = sn.y; n.dir = sn.dir;
          if (Number.isFinite(sn.friendship)) n.friendship = sn.friendship;
          if (Number.isFinite(sn.days_since_last_spoken)) n.days_since_last_spoken = sn.days_since_last_spoken;
          if (typeof sn.met === 'boolean') n.met = sn.met;
          if (typeof sn.spoken_today === 'boolean') n.spoken_today = sn.spoken_today;
          if (typeof sn.gifted_today === 'boolean') n.gifted_today = sn.gifted_today;
          // ===== fomt Bachelorette state (bachelorette.hh:26-31) =====
          // Only restore if this NPC was saved as a bachelorette (isBachelorette=true).
          // Maya is always a bachelorette in generateMap, so this restores her love,
          // playerEvents, rivalEvents, etc. Pak Tom stays a regular NPC.
          if (n.isBachelorette && sn.isBachelorette) {
            if (Number.isFinite(sn.love)) n.love = sn.love;
            if (Number.isFinite(sn.playerEvents)) n.playerEvents = sn.playerEvents;
            if (Number.isFinite(sn.daysSincePlayerEvent)) n.daysSincePlayerEvent = sn.daysSincePlayerEvent;
            if (Number.isFinite(sn.rivalEvents)) n.rivalEvents = sn.rivalEvents;
            if (Number.isFinite(sn.daysSinceRivalEvent)) n.daysSinceRivalEvent = sn.daysSinceRivalEvent;
            if (Number.isFinite(sn.unk_17_4)) n.unk_17_4 = sn.unk_17_4;
          }
        }
      }
    }
    // v3: restore fomt BLUE_FEATHER (player.blueFeather) — default false for old saves
    if (typeof player.blueFeather !== 'boolean') player.blueFeather = false;
    // v3: restore fomt collectibles state (power berries + kappa berry)
    if (Array.isArray(d.powerBerrySpots)) {
      for (let i = 0; i < powerBerrySpots.length && i < d.powerBerrySpots.length; i++) {
        if (d.powerBerrySpots[i] && d.powerBerrySpots[i].taken) powerBerrySpots[i].taken = true;
      }
    }
    if (d.kappaBerrySpot && d.kappaBerrySpot.taken) kappaBerrySpot.taken = true;
    // v3: restore fomt storage/rucksack/shippingBin/toolLevels state
    if (d.rucksack) {
      rucksack.itemSlotsUsed = d.rucksack.itemSlotsUsed || 2;
      rucksack.toolSlotsUsed = d.rucksack.toolSlotsUsed || 2;
      rucksack.items = d.rucksack.items || rucksack.items;
      rucksack.tools = d.rucksack.tools || rucksack.tools;
      // Ensure arrays are correct length
      while (rucksack.items.length < RUCKSACK_MAX_SLOTS) rucksack.items.push(null);
      while (rucksack.tools.length < RUCKSACK_MAX_TOOL_SLOTS) rucksack.tools.push(null);
    }
    if (d.fridge)    fridge = d.fridge;
    if (d.shelf)     shelf = d.shelf;
    if (d.toolChest)  toolChest = d.toolChest;
    if (d.shippingBin) {
      shippingBin.valueShipped = d.shippingBin.valueShipped || 0;
      if (Array.isArray(d.shippingBin.stats)) {
        for (let i = 0; i < 103 && i < d.shippingBin.stats.length; i++) {
          shippingBin.stats[i].amountShipped = d.shippingBin.stats[i].amountShipped || 0;
          shippingBin.stats[i].displayEnabled = !!d.shippingBin.stats[i].displayEnabled;
        }
      }
    }
    if (Array.isArray(d.toolLevels)) {
      for (let i = 0; i < 6 && i < d.toolLevels.length; i++) {
        toolLevels[i].usage = d.toolLevels[i].usage || 0;
        toolLevels[i].committedLevel = d.toolLevels[i].committedLevel || 0;
        toolLevels[i].pendingLevel = d.toolLevels[i].pendingLevel || 0;
      }
    }
    // Restore fomt livestock state (cow/sheep/chicken arrays + barn/coop buildings).
    // Animals are stored as plain objects (no methods), restored verbatim.
    if (d.livestock) {
      livestock.cows = Array.isArray(d.livestock.cows) ? d.livestock.cows : [];
      livestock.sheep = Array.isArray(d.livestock.sheep) ? d.livestock.sheep : [];
      livestock.chickens = Array.isArray(d.livestock.chickens) ? d.livestock.chickens : [];
    }
    if (d.barnState) {
      barnState.upgradeLevel = d.barnState.upgradeLevel || 0;
      barnState.fodder = d.barnState.fodder || 0;
    }
    if (d.coopState) {
      coopState.upgradeLevel = d.coopState.upgradeLevel || 0;
      coopState.feed = d.coopState.feed || 0;
      if (Array.isArray(d.coopState.incubator)) {
        for (let i = 0; i < coopState.incubator.length && i < d.coopState.incubator.length; i++) {
          coopState.incubator[i].occupied = !!d.coopState.incubator[i].occupied;
          coopState.incubator[i].daysLeft = d.coopState.incubator[i].daysLeft || 0;
        }
      }
    }
    // Restore medicine count (added in livestock patch — default 0 for old saves)
    if (!Number.isFinite(player.medicine)) player.medicine = 0;
    // Restore fomt Harvest Sprite team (harvest_sprite.hh — defaults: friendship 50, no tasks)
    if (Array.isArray(d.harvestSprites)) {
      for (let i = 0; i < harvestSprites.length && i < d.harvestSprites.length; i++) {
        const ss = d.harvestSprites[i];
        const ts = harvestSprites[i];
        // Preserve runtime name (Chef/Timid/Staid) — only restore state fields.
        ts.friendship = Number.isFinite(ss.friendship) ? ss.friendship : 50;
        ts.met = !!ss.met;
        ts.spoken_today = !!ss.spoken_today;
        ts.gifted_today = !!ss.gifted_today;
        ts.days_since_last_spoken = Number.isFinite(ss.days_since_last_spoken) ? ss.days_since_last_spoken : 0;
        // task_exp[3] + minigame_exp[3] — restore with bounds checks (0..255 / 0..31)
        if (Array.isArray(ss.task_exp)) {
          for (let t = 0; t < 3; t++) {
            ts.task_exp[t] = Number.isFinite(ss.task_exp[t])
              ? Math.max(0, Math.min(255, ss.task_exp[t])) : 0;
          }
        }
        if (Array.isArray(ss.minigame_exp)) {
          for (let t = 0; t < 3; t++) {
            ts.minigame_exp[t] = Number.isFinite(ss.minigame_exp[t])
              ? Math.max(0, Math.min(31, ss.minigame_exp[t])) : 0;
          }
        }
        // current_task 2-bit (0..3) + work_days_left 3-bit (0..7)
        ts.current_task = Number.isFinite(ss.current_task)
          ? Math.max(0, Math.min(3, ss.current_task)) : 3;   // TASK_NONE = 3 default
        ts.work_days_left = Number.isFinite(ss.work_days_left)
          ? Math.max(0, Math.min(7, ss.work_days_left)) : 0;
        ts.played_minigame = !!ss.played_minigame;
      }
    }
    // Restore fomt Maker system (Mayo/Cheese/Yarn — default false for old saves)
    if (d.makers) {
      makers.mayonnaise = !!d.makers.mayonnaise;
      makers.cheese     = !!d.makers.cheese;
      makers.yarn       = !!d.makers.yarn;
    }
    // Restore fomt FarmHouse state (farm_house.hh — defaults: level 0, no furniture)
    if (d.farmHouse) {
      const fh = d.farmHouse;
      farmHouse.upgradeLevel           = Number.isFinite(fh.upgradeLevel) ? fh.upgradeLevel : 0;
      farmHouse.hasBathroom            = !!fh.hasBathroom;
      farmHouse.hasFridge              = !!fh.hasFridge;
      farmHouse.hasShelf               = !!fh.hasShelf;
      farmHouse.hasRecordPlayer        = !!fh.hasRecordPlayer;
      farmHouse.hasLargeBed            = !!fh.hasLargeBed;
      farmHouse.hasCarpet              = !!fh.hasCarpet;
      farmHouse.hasVase                = !!fh.hasVase;
      farmHouse.vaseArticleId          = (fh.vaseArticleId == null) ? null : fh.vaseArticleId;
      farmHouse.vaseArticleLifespan    = Number.isFinite(fh.vaseArticleLifespan) ? fh.vaseArticleLifespan : 0;
      farmHouse.hasMirror              = !!fh.hasMirror;
      farmHouse.hasClock               = !!fh.hasClock;
      farmHouse.hasStocking            = !!fh.hasStocking;
      farmHouse.stockingArticleId      = (fh.stockingArticleId == null) ? null : fh.stockingArticleId;
      farmHouse.fireplaceLighted       = !!fh.fireplaceLighted;
      farmHouse.hasKitchen             = !!fh.hasKitchen;
      farmHouse.hasKitchenKnife        = !!fh.hasKitchenKnife;
      farmHouse.hasKitchenFryingPan    = !!fh.hasKitchenFryingPan;
      farmHouse.hasKitchenPot          = !!fh.hasKitchenPot;
      farmHouse.hasKitchenMixer        = !!fh.hasKitchenMixer;
      farmHouse.hasKitchenWhisk        = !!fh.hasKitchenWhisk;
      farmHouse.hasKitchenRollingPin   = !!fh.hasKitchenRollingPin;
      farmHouse.hasKitchenOven         = !!fh.hasKitchenOven;
      farmHouse.hasKitchenSeasoningSet = !!fh.hasKitchenSeasoningSet;
      // fomt RecordPlayer state (furniture.hh:75-86, record_player.cc) — defaults for old saves
      farmHouse.recordPlayerHasAlbum   = !!fh.recordPlayerHasAlbum;
      farmHouse.recordPlayerAlbumId    = Number.isFinite(fh.recordPlayerAlbumId)
        ? Math.max(0, Math.min(RECORD_PLAYER_ALBUM_COUNT - 1, fh.recordPlayerAlbumId))
        : 0;
    }
    return true;
  } catch(e) { return false; }
}

// Rebuild canopyMap from existing map (for migrating v1 saves → v2 architecture)
function rebuildCanopyFromMap() {
  canopyMap = [];
  for (let y = 0; y < MAP_H; y++) {
    const row = [];
    for (let x = 0; x < MAP_W; x++) row.push(C.NONE);
    canopyMap.push(row);
  }
  // Tree canopies (1 tile above each trunk — canopy overhangs down to meet trunk)
  for (let y = 0; y < MAP_H; y++) {
    for (let x = 0; x < MAP_W; x++) {
      if (map[y][x] === T.TREE) {
        if (y - 1 >= 0) canopyMap[y - 1][x] = C.TREE_CANOPY;
      }
    }
  }
  // Building roof overhangs (1 tile above top wall)
  const houseX = 4, houseY = 22, houseW = 7;
  for (let x = houseX; x < houseX + houseW; x++) {
    if (houseY - 1 >= 0) canopyMap[houseY - 1][x] = C.ROOF_HOUSE;
  }
  const shopX = 30, shopY = 4, shopW = 7;
  for (let x = shopX; x < shopX + shopW; x++) {
    if (shopY - 1 >= 0) canopyMap[shopY - 1][x] = C.ROOF_SHOP;
  }
  // Blacksmith roof (matches generateMap placement — used for v1→v2 save migration)
  const blackX = 22, blackY = 4, blackW = 7;
  for (let x = blackX; x < blackX + blackW; x++) {
    if (blackY - 1 >= 0) canopyMap[blackY - 1][x] = C.ROOF_SHOP;
  }
  // Barn roof (matches generateMap placement — used for v1→v2 save migration)
  const barnX = 2, barnY = 4, barnW = 8;
  for (let x = barnX; x < barnX + barnW; x++) {
    if (barnY - 1 >= 0) canopyMap[barnY - 1][x] = C.ROOF_SHOP;
  }
  // Coop roof (matches generateMap placement — used for v1→v2 save migration)
  const coopX = 11, coopY = 4, coopW = 6;
  for (let x = coopX; x < coopX + coopW; x++) {
    if (coopY - 1 >= 0) canopyMap[coopY - 1][x] = C.ROOF_SHOP;
  }
  // Carpenter roof (matches generateMap placement — used for save migration)
  const carpX = 30, carpY = 22, carpW = 7;
  for (let x = carpX; x < carpX + carpW; x++) {
    if (carpY - 1 >= 0) canopyMap[carpY - 1][x] = C.ROOF_SHOP;
  }
}

// Rebuild decorMap (sparkles near flowers)
function rebuildDecorFromMap() {
  decorMap = [];
  for (let y = 0; y < MAP_H; y++) {
    const row = [];
    for (let x = 0; x < MAP_W; x++) {
      row.push(map[y][x] === T.FLOWER && Math.random() < 0.3 ? D.SPARKLE : D.NONE);
    }
    decorMap.push(row);
  }
}

// ---------- Input ----------
window.addEventListener('keydown', (e) => {
  // Initialize AudioContext on first user gesture
  AudioManager.init(); AudioManager.resume();
  // ===== Tab key — toggle UI menu (prevent browser tab focus) =====
  if (e.key === 'Tab') {
    e.preventDefault();
    isMenuOpen = !isMenuOpen;
    AudioManager.playUI();
    document.getElementById('ui-menu').classList.toggle('open', isMenuOpen);
    if (isMenuOpen) {
      // Sync quantities from player state (preserve swap positions, update counts only)
      syncInvQuantities();
      renderInventory();
      renderStatusTab();
      toast('🎒 Menu dibuka — pergerakan di-freeze');
    } else {
      toast('✅ Menu ditutup — lanjut main');
    }
    return;
  }
  // Esc — Pause toggle (top priority). If Bag open, close it first.
  if (e.key === 'Escape') {
    e.preventDefault();
    if (isMenuOpen) {
      isMenuOpen = false;
      document.getElementById('ui-menu').classList.remove('open');
      toast('✅ Menu ditutup');
      return;
    }
    if (menuOpen) { closeMenu(); return; }
    if (dialogActive) { closeDialog(); return; }
    // Toggle pause
    isPaused = !isPaused;
    AudioManager.playUI();
    document.getElementById('pause-menu').classList.toggle('open', isPaused);
    toast(isPaused ? '⏸ Game dijeda' : '▶ Game dilanjutkan', 'info');
    return;
  }
  // Tab switch (1/2/3) only when menu open
  if (isMenuOpen) {
    const k = e.key.toLowerCase();
    if (k === '1') { switchTab('status'); return; }
    if (k === '2') { switchTab('bag'); return; }
    if (k === '3') { switchTab('map'); return; }
    e.preventDefault();
    return;   // block all other input while menu open
  }
  if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key)) e.preventDefault();
  const k = e.key.toLowerCase();
  keys[k] = true;
  if (dialogActive) {
    if (k === ' ' || k === 'e' || k === 'enter') advanceDialog();
    return;
  }
  if (menuOpen) {
    if (k === 'escape' || k === 'b') closeMenu();
    return;
  }
  if (k === '1') selectFromHotbar(0);
  else if (k === '2') selectFromHotbar(1);
  else if (k === '3') selectFromHotbar(2);
  else if (k === '4') selectFromHotbar(3);
  else if (k === '5') selectFromHotbar(4);
  else if (k === ' ' || k === 'e') useHotbarItem();   // Use item from active hotbar slot
  else if (k === 'b') tryOpenShop();
  else if (k === 't') trySleep();
  else if (k === 'g') tryGiftNpc();   // fomt gift-giving: give selectedSeed to nearest NPC
  else if (k === 'm') { scheduleDebug = !scheduleDebug; toast(scheduleDebug ? '🗺️ Schedule debug ON' : 'Schedule debug OFF'); }  // fomt NPC schedule overlay
  else if (k === 'h' || k === '?') toggleHelp(true);
  else if (k === 'escape') toggleHelp(false);
});
window.addEventListener('keyup', (e) => {
  const k = e.key.toLowerCase();
  keys[k] = false;
});

// Mobile controls
function bindMobile() {
  if (!isTouchDevice) return;
  document.getElementById('dpad').classList.add('has-touch');
  document.getElementById('action-btn').classList.add('has-touch');
  const dirs = ['up','down','left','right'];
  for (const d of dirs) {
    const el = document.querySelector(`#dpad .${d}`);
    const press = (e) => { e.preventDefault(); mobileMove[d] = true; el.classList.add('pressed'); };
    const release = (e) => { e.preventDefault(); mobileMove[d] = false; el.classList.remove('pressed'); };
    el.addEventListener('touchstart', press, {passive:false});
    el.addEventListener('touchend', release, {passive:false});
    el.addEventListener('touchcancel', release, {passive:false});
    el.addEventListener('mousedown', press);
    el.addEventListener('mouseup', release);
    el.addEventListener('mouseleave', release);
  }
  const ab = document.getElementById('action-btn');
  ab.addEventListener('touchstart', (e) => { e.preventDefault(); useToolOrInteract(); }, {passive:false});
  ab.addEventListener('click', (e) => { if (!isTouchDevice) useToolOrInteract(); });
}
bindMobile();

// Canvas swipe to move? Not needed; dpad. But allow tap-to-face-direction.
canvas.addEventListener('touchstart', (e) => {
  if (e.touches.length === 1) {
    // Track for potential swipe-to-use-tool later
    canvas._touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY, t: Date.now() };
  }
}, {passive: true});
canvas.addEventListener('touchend', (e) => {
  if (!canvas._touchStart) return;
  const t = e.changedTouches[0];
  const dx = t.clientX - canvas._touchStart.x;
  const dy = t.clientY - canvas._touchStart.y;
  const dist = Math.hypot(dx, dy);
  canvas._touchStart = null;
  if (dist < 18) {
    // tap = use tool at facing tile
    useToolOrInteract();
  }
}, {passive: true});

// ---------- Toolbar UI ----------
function renderToolbar() {
  const tb = document.getElementById('toolbar');
  tb.innerHTML = '';
  // Hotbar renders from inventoryData[0..4] — syncs with Bag swaps.
  // Keys 1-5 map to these slots. Click slot to select tool.
  const HOTBAR_KEY = ['1','2','3','4','5'];
  for (let i = 0; i < 5; i++) {
    const item = inventoryData[i];
    const toolId = item ? item.id : null;
    const slot = document.createElement('div');
    // Highlight active hotbar slot (selected via keys 1-5) OR matching selectedTool
    const isActiveSlot = i === activeHotbarIndex;
    const isSelectedTool = selectedTool === toolId && toolId;
    slot.className = 'tool-slot' + ((isActiveSlot || isSelectedTool) ? ' active' : '');
    slot.dataset.tool = toolId || ('empty' + i);
    slot.dataset.slotIndex = i;
    // Empty slot visual
    if (!item) {
      slot.innerHTML = `
        <div class="tool-key">${HOTBAR_KEY[i]}</div>
        <div class="tool-icon" style="opacity:0.3">—</div>
      `;
      slot.addEventListener('click', () => {
        toast('Slot kosong — drag item dari Bag ke sini', 'warn');
      });
      tb.appendChild(slot);
      continue;
    }
    // Count badge
    let count = '';
    if (item.id === 'seeds') count = item.quantity;
    else if (item.id === 'water') count = `${item.quantity}/${player.maxWater}`;
    else if (item.quantity > 1) count = item.quantity;
    slot.innerHTML = `
      <div class="tool-key">${HOTBAR_KEY[i]}</div>
      <div class="tool-icon"></div>
      ${count !== '' ? `<div class="tool-count">${count}</div>` : ''}
    `;
    // Render real sprite icon
    const assetKey = INV_ASSET_KEY_MAP[item.id] || item.assetKey;
    if (assetKey && invAssets[assetKey]) {
      const icon = document.createElement('img');
      icon.alt = item.name;
      icon.width = 22;
      icon.height = 22;
      icon.style.objectFit = 'contain';
      icon.style.imageRendering = 'pixelated';
      icon.src = invAssets[assetKey].src;
      const target = slot.querySelector('.tool-icon');
      if (target) target.appendChild(icon);
    } else {
      // Fallback: emoji from TOOLS
      const toolDef = TOOLS.find(t => t.id === item.id);
      if (toolDef) slot.querySelector('.tool-icon').textContent = toolDef.icon;
    }
    // Click → select tool (only if it's a usable tool)
    slot.addEventListener('click', () => {
      if (item.id === 'hoe' || item.id === 'seeds' || item.id === 'water' || item.id === 'sickle' || item.id === 'axe') {
        selectTool(item.id);
        if (item.id === 'seeds') {
          // cycle seed type
          const idx = SEED_LIST.indexOf(selectedSeed);
          selectedSeed = SEED_LIST[(idx + 1) % SEED_LIST.length];
          // Update inventoryData seed slot to reflect new selected seed
          inventoryData[1] = {
            id: 'seeds',
            name: 'Benih ' + selectedSeed,
            quantity: player.seeds[selectedSeed] ?? 0,
            assetKey: getCropIconKey(selectedSeed),
            type: 'seed',
          };
          renderToolbar();
        }
      } else {
        toast(`${item.name} bukan alat yang bisa dipakai`, 'warn');
      }
    });
    tb.appendChild(slot);
  }
}

// Map tool id → inventory asset key (for hotbar icon rendering)
const INV_ASSET_KEY_MAP = {
  hoe: 'tool_hoe',
  seeds: 'crop_parsnip',  // default, updated by selectedSeed
  water: 'tool_water',
  sickle: 'tool_sickle',
  axe: 'tool_axe',
};
function selectTool(id) {
  selectedTool = id;
  renderToolbar();
}

// Select tool from hotbar slot (key 1-5 or click)
// Reads inventoryData[slotIndex] — if item is a usable tool, select it.
function selectFromHotbar(slotIndex) {
  const item = inventoryData[slotIndex];
  // Always update active slot (visual highlight) even if item is non-tool
  activeHotbarIndex = slotIndex;
  renderToolbar();
  if (!item) {
    toast('Slot hotbar kosong', 'warn');
    return;
  }
  const usableTools = ['hoe', 'seeds', 'water', 'sickle', 'axe'];
  if (!usableTools.includes(item.id)) {
    // Non-tool item selected (crop/food) — can be used via Spasi to consume
    toast(`Selected: ${item.name} (tekan Spasi untuk pakai)`);
    return;
  }
  selectTool(item.id);
  if (item.id === 'seeds') {
    // cycle seed type
    const idx = SEED_LIST.indexOf(selectedSeed);
    selectedSeed = SEED_LIST[(idx + 1) % SEED_LIST.length];
    // Update inventoryData seed slot
    inventoryData[1] = {
      id: 'seeds',
      name: 'Benih ' + selectedSeed,
      quantity: player.seeds[selectedSeed] ?? 0,
      assetKey: getCropIconKey(selectedSeed),
      type: 'seed',
    };
    renderToolbar();
  }
}

// ===== Use Item dari Hotbar (Spasi/E) =====
// Baca item di slot aktif (inventoryData[activeHotbarIndex]).
// - Tools (hoe/seeds/water/sickle/axe) → useToolOrInteract() (farming action)
// - Crops (parsnip/potato/tomato/corn) → eat (restore energy + decrement)
// - Null → toast "slot kosong"
function useHotbarItem() {
  // Check chest interaction first (Spasi/E near chest → open)
  if (tryInteract()) return;
  const item = inventoryData[activeHotbarIndex];
  if (!item) {
    toast('Slot hotbar kosong — tidak ada item untuk dipakai', 'warn');
    return;
  }
  const usableTools = ['hoe', 'seeds', 'water', 'sickle', 'axe'];
  if (usableTools.includes(item.id)) {
    // Tool → trigger farming action (existing logic)
    useToolOrInteract();
    return;
  }
  // Crop/food → consume (eat)
  const cropId = item.id;
  const cropDef = CROPS[cropId];
  if (cropDef) {
    // Restore energy (crop sell value / 2 as energy)
    const energyGain = Math.max(5, Math.floor(cropDef.sell / 4));
    // fomt food.cc: eating restores stamina + reduces fatigue (FoodInfo.stamina/fatigue)
    const oldStamina = player.stamina;
    adjustStamina(energyGain);                       // +stamina (clamped to maxStamina)
    adjustFatigue(-Math.ceil(energyGain / 3));        // fatigue recovery ~1/3 of stamina gain
    const actualGain = player.stamina - oldStamina;
    // Decrement inventory
    player.inventory[cropId] = Math.max(0, (player.inventory[cropId] || 0) - 1);
    syncInvItem(cropId, player.inventory[cropId]);
    // Popup notification
    showPopup(cropId, cropDef.name, 'pickup', `+${actualGain}⚡`);
    toast(`Dipakai: ${cropDef.name} (+${actualGain} energy)`, 'info');
    // If slot now empty, keep selection but show empty
    if (player.inventory[cropId] === 0 && inventoryData[activeHotbarIndex] && inventoryData[activeHotbarIndex].id === cropId) {
      // Check if this was the only stack — remove from inventoryData if quantity hits 0
      const slot = inventoryData[activeHotbarIndex];
      if (slot && slot.quantity !== undefined) {
        slot.quantity = 0;
        // Find all slots with this crop id; if all 0, clear them
      }
    }
    updateHUD();
    save();
    return;
  }
  // Unknown item type
  toast(`${item.name} tidak bisa dipakai`, 'warn');
}

// Sync inventory item quantity after farming action.
// Finds slot by item.id, updates quantity, re-renders hotbar.
function syncInvItem(id, newQuantity) {
  for (let i = 0; i < INV_SLOTS; i++) {
    if (inventoryData[i] && inventoryData[i].id === id) {
      inventoryData[i].quantity = newQuantity;
      break;
    }
  }
  renderToolbar();   // refresh hotbar to show new count
}

// Update quantities in inventoryData from player state WITHOUT rebuilding structure.
// This preserves user swaps (item positions) while keeping counts in sync.
// Called when opening Bag or after shop transactions.
function syncInvQuantities() {
  for (let i = 0; i < INV_SLOTS; i++) {
    const item = inventoryData[i];
    if (!item) continue;
    if (item.id === 'seeds') {
      item.quantity = player.seeds[selectedSeed] ?? 0;
      item.name = 'Benih ' + selectedSeed;
      item.assetKey = getCropIconKey(selectedSeed);
    } else if (item.id === 'water') {
      item.quantity = player.water;
    } else if (item.id === 'parsnip') {
      item.quantity = player.inventory.parsnip;
    } else if (item.id === 'potato') {
      item.quantity = player.inventory.potato;
    } else if (item.id === 'tomato') {
      item.quantity = player.inventory.tomato;
    } else if (item.id === 'corn') {
      item.quantity = player.inventory.corn;
    } else if (item.id === 'carrot') {
      item.quantity = player.inventory.carrot || 0;
    } else if (item.id === 'pumpkin') {
      item.quantity = player.inventory.pumpkin || 0;
    } else if (item.id === 'cabbage' || ['beetroot','cauliflower','kale','radish','sunflower','wheat'].includes(item.id)) {
      item.quantity = player.inventory[item.id] || 0;
    } else if (item.id === 'parsnip_seed') {
      item.quantity = player.seeds.parsnip;
    } else if (item.id === 'potato_seed') {
      item.quantity = player.seeds.potato;
    }
  }
}

// ---------- Dialog ----------
function showDialog(speaker, lines) {
  if (!Array.isArray(lines)) lines = [lines];
  dialogQueue = lines.map(t => ({ speaker, text: t }));
  dialogActive = true;
  document.getElementById('dialog').classList.add('show');
  renderDialog();
}
function renderDialog() {
  const cur = dialogQueue[0];
  if (!cur) { closeDialog(); return; }
  document.getElementById('dialog-speaker').textContent = cur.speaker;
  document.getElementById('dialog-text').textContent = cur.text;
}
function advanceDialog() {
  dialogQueue.shift();
  if (!dialogQueue.length) { closeDialog(); return; }
  renderDialog();
}
function closeDialog() {
  dialogActive = false;
  dialogQueue = [];
  document.getElementById('dialog').classList.remove('show');
}

// ===== Drop Item System (Right-Click → Instantiate to world) =====
// Drop item dari inventory ke tanah di posisi player.
// Offset Y = +55px (beyond pickup radius: player.radius 16 + pickupRadius 22 = 38px).
function dropItem(slotIndex) {
  const item = inventoryData[slotIndex];
  if (!item) {
    toast('Slot kosong — tidak ada item untuk di-drop', 'warn');
    return;
  }
  // Cari assetKey & name dari item
  let name = item.name || item.id;
  let assetKey = item.assetKey;
  // Untuk crop/seed, ambil dari ItemDatabase-like mapping
  const db = DROP_ITEM_DB[item.id];
  if (db) { name = db.name; assetKey = db.assetKey; }

  // Realtime Object Instantiation
  // Find safe drop position (avoid walls/trees/water via spiral search)
  const dropPos = findDropPosition(player.x, player.y, 0, 55);
  const droppedItem = {
    id: item.id,
    name: name,
    assetKey: assetKey,
    x: dropPos.x,
    y: dropPos.y,
    pickupRadius: 22,
    bobOffset: Math.random() * 6.28,
  };
  itemsInWorld.push(droppedItem);
  AudioManager.playDrop();

  // Array Nullification
  // Sync player.inventory/player.seeds dengan drop (single source of truth)
  if (item.id === 'parsnip' || item.id === 'potato' || item.id === 'tomato' || item.id === 'corn') {
    player.inventory[item.id] = Math.max(0, (player.inventory[item.id] || 0) - 1);
  } else if (item.id === 'seeds') {
    player.seeds[selectedSeed] = Math.max(0, (player.seeds[selectedSeed] || 0) - 1);
  }
  if (item.quantity > 1) {
    item.quantity--;
  } else {
    inventoryData[slotIndex] = null;
  }
  // Visual Re-Sync
  syncInvQuantities();   // update quantities from player state, preserve swaps
  renderInventory();     // re-renders Bag + hotbar
  renderToolbar();

  toast(`🗑️ Dropped: ${name}`, 'info');
  showPopup(item.id, name, 'pickup', '−1');
}

// Item database untuk drop rendering (id → name + assetKey)
const DROP_ITEM_DB = {
  hoe:         { name: 'Cangkul',     assetKey: 'tool_hoe' },
  water:       { name: 'Penyiram',    assetKey: 'tool_water' },
  sickle:      { name: 'Sabit',       assetKey: 'tool_sickle' },
  axe:         { name: 'Kapak',       assetKey: 'tool_axe' },
  pickaxe:     { name: 'Pickaxe',     assetKey: 'tool_pickaxe' },
  seeds:       { name: 'Benih',       assetKey: 'crop_parsnip' },
  // All 13 crop types
  parsnip:     { name: 'Parsnip',     assetKey: 'crop_parsnip' },
  potato:      { name: 'Kentang',     assetKey: 'crop_potato' },
  carrot:      { name: 'Wortel',      assetKey: 'crop_carrot' },
  tomato:      { name: 'Tomat',       assetKey: 'crop_potato' },     // fallback
  corn:        { name: 'Jagung',      assetKey: 'crop_parsnip' },    // fallback
  pumpkin:     { name: 'Labu',        assetKey: 'crop_pumpkin' },
  cabbage:     { name: 'Kubis',      assetKey: 'crop_cabbage' },
  beetroot:    { name: 'Bit',         assetKey: 'crop_beetroot' },
  cauliflower: { name: 'Bunga Kol',   assetKey: 'crop_cauliflower' },
  kale:        { name: 'Kale',        assetKey: 'crop_kale' },
  radish:      { name: 'Lobak',       assetKey: 'crop_radish' },
  sunflower:   { name: 'Bunga Matahari', assetKey: 'crop_sunflower' },
  wheat:       { name: 'Gandum',      assetKey: 'crop_wheat' },
};

// ===== World Items: Pickup Check (Euclidean distance) =====
function checkWorldPickups() {
  if (isMenuOpen || dialogActive || menuOpen) return;
  for (let i = itemsInWorld.length - 1; i >= 0; i--) {
    const item = itemsInWorld[i];
    const dx = player.x - item.x;
    const dy = player.y - item.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    // pickup threshold: player half-size (16) + item pickupRadius (22) = 38px
    if (dist < (16 + item.pickupRadius)) {
      // Pickup attempt: stacking + first empty slot
      if (pickupToWorldItem(item)) {
        itemsInWorld.splice(i, 1);  // Destroy from world
        showPickupPopupWorld(item);
      }
    }
  }
}

// Pickup world item ke inventory (stacking + first empty slot)
function pickupToWorldItem(item) {
  // Loop 1: stack ke slot existing dengan id sama
  for (let i = 0; i < INV_SLOTS; i++) {
    const slot = inventoryData[i];
    if (slot && slot.id === item.id && slot.quantity < 99) {
      slot.quantity++;
      syncInvQuantities();
      renderToolbar();
      if (isMenuOpen && activeTab === 'bag') renderInventory();
      return true;
    }
  }
  // Loop 2: first empty slot
  for (let i = 0; i < INV_SLOTS; i++) {
    if (!inventoryData[i]) {
      inventoryData[i] = { id: item.id, quantity: 1, name: item.name, assetKey: item.assetKey };
      syncInvQuantities();
      renderToolbar();
      if (isMenuOpen && activeTab === 'bag') renderInventory();
      return true;
    }
  }
  // Inventory full
  toast('🎒 Inventory penuh! Tidak bisa pickup', 'warn');
  return false;
}

// Popup untuk world item pickup
function showPickupPopupWorld(item) {
  showPopup(item.id, item.name, 'pickup', '+1');
}

// ===== Render world items di canvas =====
function drawWorldItems() {
  const t = performance.now() / 1000;
  for (const item of itemsInWorld) {
    const sx = item.x - camera.x;
    const sy = item.y - camera.y + Math.sin(t * 2 + item.bobOffset) * 3;
    if (sx < -40 || sx > canvas.clientWidth + 40 || sy < -40 || sy > canvas.clientHeight + 40) continue;

    // Shadow
    ctx.fillStyle = 'rgba(0,0,0,0.3)';
    ctx.beginPath();
    ctx.ellipse(sx, item.y - camera.y + 16, 10, 4, 0, 0, Math.PI * 2);
    ctx.fill();

    // Glow halo saat player dekat
    const dist = Math.hypot(player.x - item.x, player.y - item.y);
    if (dist < item.pickupRadius + 30) {
      const intensity = 1 - (dist / (item.pickupRadius + 30));
      ctx.fillStyle = `rgba(255, 213, 74, ${0.2 * intensity})`;
      ctx.beginPath();
      ctx.arc(sx, sy, 20, 0, Math.PI * 2);
      ctx.fill();
    }

    // Item sprite (real asset)
    const db = DROP_ITEM_DB[item.id];
    const assetKey = db ? db.assetKey : item.assetKey;
    const img = invAssets[assetKey];
    if (img && img.complete && img.naturalWidth) {
      const sw = img.naturalWidth, sh = img.naturalHeight;
      const scale = Math.min(32 / sw, 32 / sh, 3);
      const dw = sw * scale, dh = sh * scale;
      ctx.drawImage(img, 0, 0, sw, sh, sx - dw/2, sy - dh/2, dw, dh);
    } else {
      ctx.fillStyle = '#ffd54a';
      ctx.fillRect(sx - 8, sy - 8, 16, 16);
    }
  }
}

// ===== IInteractable Interface Simulation (Polymorphism via Duck-Typing) =====
// Each interactable object has a .interact() method.
// Engine calls closestObject.interact() without knowing the type.
// Chest → opens + gives loot. Signboard → shows dialog text.

const chestDefs = [
  { gridCol: 16, gridRow: 5,  rewardId: 'potion',  rewardQty: 3 },
  { gridCol: 18, gridRow: 25, rewardId: 'parsnip', rewardQty: 5 },
  { gridCol: 33, gridRow: 20, rewardId: 'potato',  rewardQty: 3 },
];

const signboardDefs = [
  { gridCol: 7,  gridRow: 20, text: 'Selamat datang di rumahmu! Tekan T untuk tidur.' },
  { gridCol: 20, gridRow: 3,  text: 'Toko Benih — Beli benih, jual hasil panen untuk gold!' },
  { gridCol: 14, gridRow: 12, text: 'Area Bertani — Cangkul tanah, tanam benih, siram tiap hari.' },
  { gridCol: 3,  gridRow: 3,  text: 'Kolam — Isi ulang penyiram air di sini saat habis.' },
];

const interactableObjects = [];

// Create chest instances with .interact()
for (const def of chestDefs) {
  const obj = {
    type: 'chest',
    gridCol: def.gridCol, gridRow: def.gridRow,
    x: def.gridCol * TILE, y: def.gridRow * TILE,
    interactionRadius: 48,
    isOpened: false,
    rewardId: def.rewardId, rewardQty: def.rewardQty,
    interact() {
      if (this.isOpened) { toast('Peti sudah dibuka', 'warn'); return; }
      this.isOpened = true;
      AudioManager.playChest();
      const db = CROPS[this.rewardId];
      const name = db ? db.name : this.rewardId;
      for (let i = 0; i < this.rewardQty; i++) {
        if (this.rewardId === 'potion') {
          let stacked = false;
          for (let j = 0; j < INV_SLOTS; j++) {
            if (inventoryData[j] && inventoryData[j].id === this.rewardId && inventoryData[j].quantity < 99) {
              inventoryData[j].quantity++; stacked = true; break;
            }
          }
          if (!stacked) {
            for (let j = 0; j < INV_SLOTS; j++) {
              if (!inventoryData[j]) {
                inventoryData[j] = { id: this.rewardId, quantity: 1, name: 'Potion', assetKey: 'food_milk', type: 'consumable' };
                break;
              }
            }
          }
        } else {
          player.inventory[this.rewardId] = (player.inventory[this.rewardId] || 0) + 1;
        }
      }
      syncInvQuantities(); renderToolbar();
      if (isMenuOpen && activeTab === 'bag') renderInventory();
      showPopup(this.rewardId, name, 'pickup', `+${this.rewardQty}`);
      AudioManager.playPickup();
      toast(`📦 Peti dibuka! Dapat: ${name} ×${this.rewardQty}`, 'info');
    },
  };
  interactableObjects.push(obj);
}

// Create signboard instances with .interact()
for (const def of signboardDefs) {
  const obj = {
    type: 'signboard',
    gridCol: def.gridCol, gridRow: def.gridRow,
    x: def.gridCol * TILE, y: def.gridRow * TILE,
    interactionRadius: 48,
    text: def.text,
    interact() {
      toast(`📜 ${this.text}`, 'info');
      AudioManager.playSign();
    },
  };
  interactableObjects.push(obj);
}

// Keep chests[] reference for backward compat
const chests = interactableObjects.filter(o => o.type === 'chest');

// ===== Interactable Renderer (Chests + Signboards + [E] Indicator) =====
// ===== fomt Power Berry & Kappa Berry renderer =====
// Draws floating collectibles: red berries (+10 max stamina) + green Kappa berry (halves fatigue)
function drawPowerBerries() {
  const t = performance.now() / 600;
  const drawBerry = (spot, color, glowColor) => {
    if (spot.taken) return;
    const sx = spot.x - camera.x + TILE/2;
    const sy = spot.y - camera.y + TILE/2;
    if (sx < -TILE || sy < -TILE || sx > canvas.clientWidth + TILE || sy > canvas.clientHeight + TILE) return;
    const bob = Math.sin(t + spot.x * 0.01) * 3;
    // Glow halo
    const grad = ctx.createRadialGradient(sx, sy + bob, 0, sx, sy + bob, 18);
    grad.addColorStop(0, glowColor);
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(sx, sy + bob, 18, 0, Math.PI * 2); ctx.fill();
    // Shadow
    ctx.fillStyle = 'rgba(0,0,0,0.3)';
    ctx.beginPath();
    ctx.ellipse(sx, sy + 10, 8, 3, 0, 0, Math.PI * 2); ctx.fill();
    // Berry body
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.arc(sx, sy + bob, 7, 0, Math.PI * 2); ctx.fill();
    // Highlight
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.beginPath();
    ctx.arc(sx - 2, sy + bob - 2, 2.5, 0, Math.PI * 2); ctx.fill();
    // Leaf
    ctx.fillStyle = '#4d8a35';
    ctx.beginPath();
    ctx.ellipse(sx + 3, sy + bob - 6, 3, 1.5, -0.5, 0, Math.PI * 2); ctx.fill();
  };
  for (const spot of powerBerrySpots) drawBerry(spot, '#e63946', 'rgba(230,57,70,0.4)');
  drawBerry(kappaBerrySpot, '#3aff7a', 'rgba(58,255,122,0.5)');
}

function drawInteractables() {
  for (const obj of interactableObjects) {
    const sx = obj.x - camera.x;
    const sy = obj.y - camera.y;
    if (sx < -TILE || sy < -TILE || sx > canvas.clientWidth + TILE || sy > canvas.clientHeight + TILE) continue;

    // Shadow
    ctx.fillStyle = 'rgba(0,0,0,0.3)';
    ctx.beginPath();
    ctx.ellipse(sx + TILE/2, sy + TILE - 4, 18, 5, 0, 0, Math.PI * 2);
    ctx.fill();

    // Render based on type
    if (obj.type === 'chest') {
      const chestImg = invAssets.chest_small;
      if (chestImg && chestImg.complete && chestImg.naturalWidth) {
        const frameW = 14, frameH = 16;
        const sx_src = obj.isOpened ? 17 : 1;
        const dh = TILE;
        const dw = TILE * (frameW / frameH);
        const dx = sx + (TILE - dw) / 2;
        const dy = sy;
        ctx.drawImage(chestImg, sx_src, 0, frameW, frameH, dx, dy, dw, dh);
      } else {
        ctx.fillStyle = '#8a5a2a';
        ctx.fillRect(sx + 4, sy + 6, TILE - 8, TILE - 10);
      }
    } else if (obj.type === 'signboard') {
      const signImg = invAssets.signboard;
      if (signImg && signImg.complete && signImg.naturalWidth) {
        const sw = signImg.naturalWidth, sh = signImg.naturalHeight;
        const scale = TILE / Math.max(sw, sh);
        const dw = sw * scale, dh = sh * scale;
        const dx = sx + (TILE - dw) / 2;
        const dy = sy + (TILE - dh) / 2;
        ctx.drawImage(signImg, 0, 0, sw, sh, dx, dy, dw, dh);
      } else {
        // Fallback: brown post with sign
        ctx.fillStyle = '#5a3a1a';
        ctx.fillRect(sx + TILE/2 - 3, sy + 20, 6, 12);
        ctx.fillStyle = '#8a6a3a';
        ctx.fillRect(sx + 6, sy + 8, TILE - 12, 14);
      }
    }

    // Floating [E] indicator when player within interactionRadius
    const dist = Math.hypot(player.x - (obj.x + TILE/2), player.y - (obj.y + TILE/2));
    if (dist < obj.interactionRadius && !(obj.type === 'chest' && obj.isOpened)) {
      const intensity = 1 - (dist / obj.interactionRadius);
      // Highlight border
      ctx.strokeStyle = `rgba(255, 213, 74, ${0.6 + 0.4 * intensity})`;
      ctx.lineWidth = 2;
      ctx.strokeRect(sx + 2, sy + 2, TILE - 4, TILE - 4);
      // Floating [E] bubble
      const bobY = Math.sin(performance.now() / 300) * 3;
      const ex = sx + TILE / 2;
      const ey = sy - 14 + bobY;
      ctx.fillStyle = `rgba(255, 213, 74, ${0.8 + 0.2 * intensity})`;
      ctx.beginPath();
      ctx.arc(ex, ey, 10, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = `rgba(255, 255, 255, ${intensity})`;
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.fillStyle = '#2a1500';
      ctx.font = 'bold 12px system-ui';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('E', ex, ey);
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
    }
  }
}

// ===== Interaction: Find Nearest + Execute .interact() =====
function tryInteract() {
  let closest = null, closestDist = Infinity;
  for (const obj of interactableObjects) {
    if (obj.type === 'chest' && obj.isOpened) continue;
    const dist = Math.hypot(player.x - (obj.x + TILE/2), player.y - (obj.y + TILE/2));
    if (dist < obj.interactionRadius && dist < closestDist) {
      closest = obj; closestDist = dist;
    }
  }
  if (closest) { closest.interact(); AudioManager.playInteract(); return true; }
  return false;
}
// ---------- Toasts ----------
function toast(msg, type = '') {
  const el = document.createElement('div');
  el.className = 'toast ' + type;
  el.textContent = msg;
  document.getElementById('toasts').appendChild(el);
  setTimeout(() => el.remove(), 2400);
}

// ---------- Popup Notification Queue (top-right corner) ----------
// FIFO queue with MAX_POPUPS limit. Auto-fade & destroy via setTimeout + CSS.
const MAX_POPUPS = 3;
const POPUP_LIFETIME_MS = 1800;   // visible duration before fade
const POPUP_FADE_MS = 400;        // fade transition duration
const activePopups = [];           // queue of {el, timers[]}

// assetKey → real asset path (reuse INV_ASSET_PATHS + add more for crops/tools)
const POPUP_ASSET_PATHS = {
  // Tools
  hoe:    INV_ASSET_PATHS.tool_hoe,
  water:  INV_ASSET_PATHS.tool_water,
  sickle: INV_ASSET_PATHS.tool_sickle,
  axe:    INV_ASSET_PATHS.tool_axe,
  pickaxe:INV_ASSET_PATHS.tool_pickaxe,
  // Crops (harvested) — all 13 crop types
  parsnip:    INV_ASSET_PATHS.crop_parsnip,
  potato:     INV_ASSET_PATHS.crop_potato,
  carrot:     INV_ASSET_PATHS.crop_carrot,
  pumpkin:    INV_ASSET_PATHS.crop_pumpkin,
  cabbage:    INV_ASSET_PATHS.crop_cabbage,
  beetroot:   INV_ASSET_PATHS.crop_beetroot,
  cauliflower:INV_ASSET_PATHS.crop_cauliflower,
  kale:       INV_ASSET_PATHS.crop_kale,
  radish:     INV_ASSET_PATHS.crop_radish,
  sunflower:  INV_ASSET_PATHS.crop_sunflower,
  wheat:      INV_ASSET_PATHS.crop_wheat,
  // tomato + corn use fallback (no dedicated sprite in some packs)
  tomato:  INV_ASSET_PATHS.crop_potato,    // fallback
  corn:    INV_ASSET_PATHS.crop_parsnip,   // fallback
  // Food
  egg:  INV_ASSET_PATHS.food_egg,
  fish: INV_ASSET_PATHS.food_fish,
  milk: INV_ASSET_PATHS.food_milk,
  // Gold icon (use milk sprite as gold-ish placeholder)
  gold: INV_ASSET_PATHS.food_milk,
};

// Show popup notification. Falls back gracefully if assetKey not in DB.
//   assetKey: logical key (e.g. 'parsnip', 'hoe', 'gold')
//   name: display name (e.g. 'Parsnip', 'Gold')
//   actionType: 'pickup' | 'harvest' | 'plant' | 'water' | 'buy' | 'sell' | 'gold'
//   countText: badge text (e.g. '+1', '+50g')
function showPopup(assetKey, name, actionType, countText) {
  const container = document.getElementById('popup-container');
  if (!container) return;

  // Map logical key → invAssets key (which matches INV_ASSET_PATHS keys)
  const ASSET_KEY_MAP = {
    // All 13 crop types
    parsnip:    'crop_parsnip',
    potato:     'crop_potato',
    carrot:     'crop_carrot',
    pumpkin:    'crop_pumpkin',
    cabbage:    'crop_cabbage',
    beetroot:   'crop_beetroot',
    cauliflower:'crop_cauliflower',
    kale:       'crop_kale',
    radish:     'crop_radish',
    sunflower:  'crop_sunflower',
    wheat:      'crop_wheat',
    tomato:     'crop_potato',    // fallback (no dedicated sprite)
    corn:       'crop_parsnip',   // fallback
    // Tools
    hoe:     'tool_hoe',
    water:   'tool_water',
    sickle:  'tool_sickle',
    axe:     'tool_axe',
    pickaxe: 'tool_pickaxe',
    seeds:   'crop_parsnip',   // generic seed icon
    // Food
    egg:     'food_egg',
    fish:    'food_fish',
    milk:    'food_milk',
    gold:    'food_milk',      // gold-ish placeholder
  };
  const invKey = ASSET_KEY_MAP[assetKey] || assetKey;
  const assetPath = INV_ASSET_PATHS[invKey];

  // Determine style variant
  let variant = '';
  if (actionType === 'gold' || actionType === 'sell') variant = 'gold';
  else if (actionType === 'buy') variant = 'warn';

  // Create popup DOM
  const popup = document.createElement('div');
  popup.className = 'pickup-popup' + (variant ? ' ' + variant : '');

  // Thumbnail (real asset sprite)
  const thumb = document.createElement('img');
  thumb.className = 'popup-thumb';
  if (assetPath && invAssets[invKey] && invAssets[invKey].complete) {
    thumb.src = 'assets/' + assetPath;
  }
  thumb.alt = name;
  thumb.onerror = () => { thumb.style.display = 'none'; };
  popup.appendChild(thumb);

  // Text content
  const textEl = document.createElement('div');
  textEl.className = 'popup-text';
  const nameEl = document.createElement('div');
  nameEl.className = 'popup-name';
  nameEl.textContent = name;
  textEl.appendChild(nameEl);
  const actionEl = document.createElement('div');
  actionEl.className = 'popup-action';
  const actionLabels = {
    pickup: 'Dipungut',
    harvest: 'Dipanen',
    plant: 'Ditanam',
    water: 'Disiram',
    buy: 'Dibeli',
    sell: 'Terjual',
    gold: 'Gold',
  };
  actionEl.textContent = actionLabels[actionType] || actionType;
  textEl.appendChild(actionEl);
  popup.appendChild(textEl);

  // Count badge
  const countEl = document.createElement('div');
  countEl.className = 'popup-count';
  countEl.textContent = countText;
  popup.appendChild(countEl);

  container.appendChild(popup);

  // Enqueue
  const entry = { el: popup, timers: [] };
  activePopups.push(entry);

  // Queue limit: shift (dequeue) oldest if exceeds MAX_POPUPS
  if (activePopups.length > MAX_POPUPS) {
    const evicted = activePopups.shift();
    if (evicted) {
      evicted.timers.forEach((t) => clearTimeout(t));
      evicted.el.remove();
    }
  }

  // Coroutine: Auto-Fade & Destroy
  const fadeTimer = setTimeout(() => {
    popup.classList.add('fade');
  }, POPUP_LIFETIME_MS);
  entry.timers.push(fadeTimer);

  const destroyTimer = setTimeout(() => {
    popup.remove();
    const idx = activePopups.indexOf(entry);
    if (idx !== -1) activePopups.splice(idx, 1);
  }, POPUP_LIFETIME_MS + POPUP_FADE_MS);
  entry.timers.push(destroyTimer);
}

// ---------- Help modal ----------
function toggleHelp(show) {
  document.getElementById('help-modal').classList.toggle('show', show);
}
document.getElementById('help-btn').addEventListener('click', () => toggleHelp(true));
document.getElementById('help-close').addEventListener('click', () => toggleHelp(false));
document.getElementById('help-modal').addEventListener('click', (e) => {
  if (e.target.id === 'help-modal') toggleHelp(false);
});

// ---------- Tool use ----------
function getFacingTile() {
  const px = Math.floor((player.x + TILE/2) / TILE);
  const py = Math.floor((player.y + TILE/2) / TILE);
  let fx = px, fy = py;
  if (player.dir === 'up') fy--;
  else if (player.dir === 'down') fy++;
  else if (player.dir === 'left') fx--;
  else if (player.dir === 'right') fx++;
  return { px, py, fx, fy };
}

function isWalkable(x, y) {
  if (x < 0 || y < 0 || x >= MAP_W || y >= MAP_H) return false;
  const t = map[y][x];
  if (t === T.TREE || t === T.WATER || t === T.WALL || t === T.SHOP_WALL || t === T.FENCE || t === T.BUSH || t === T.SPRITE_HUT) return false;
  return true;
}

// Check if a pixel position is on a walkable tile (no collision).
// Used by dropItem() to ensure dropped items don't spawn inside walls.
function isPixelWalkable(px, py) {
  const tx = Math.floor(px / TILE);
  const ty = Math.floor(py / TILE);
  return isWalkable(tx, ty);
}

// Find a valid drop position near player (spiral search).
// Tries the preferred offset first, then expands outward in a spiral
// until a walkable tile is found (within maxRadius).
function findDropPosition(centerX, centerY, offsetX, offsetY) {
  const preferredX = centerX + offsetX;
  const preferredY = centerY + offsetY;
  if (isPixelWalkable(preferredX, preferredY)) return { x: preferredX, y: preferredY };

  // Spiral search: try positions in expanding rings around preferred point
  const maxRadius = 3;  // 3 tiles = 96px search radius
  for (let r = 1; r <= maxRadius; r++) {
    for (let dy = -r; dy <= r; dy++) {
      for (let dx = -r; dx <= r; dx++) {
        if (Math.abs(dx) !== r && Math.abs(dy) !== r) continue;  // ring only
        const tx = Math.floor(preferredX / TILE) + dx;
        const ty = Math.floor(preferredY / TILE) + dy;
        if (isWalkable(tx, ty)) {
          // Return center of the walkable tile
          return { x: tx * TILE + TILE / 2, y: ty * TILE + TILE / 2 };
        }
      }
    }
  }
  // Fallback: return player center (always walkable since player is standing there)
  return { x: centerX, y: centerY };
}

// ===== fomt Power Berries & Kappa Berry collectibles =====
// 10 power berries scattered around the map (+10 max stamina each, fomt func_0800EAFC)
// 1 Kappa berry in a hard-to-reach spot (halves fatigue, fomt func_0800EAF0)
let powerBerrySpots = [
  { x: 5 * TILE,  y: 5 * TILE,  taken: false },   // 1: NW corner of town
  { x: 35 * TILE, y: 4 * TILE,  taken: false },   // 2: NE forest edge
  { x: 36 * TILE, y: 27 * TILE, taken: false },   // 3: SE corner
  { x: 3 * TILE,  y: 26 * TILE, taken: false },   // 4: SW corner
  { x: 19 * TILE, y: 2 * TILE,  taken: false },   // 5: top center near shop
  { x: 30 * TILE, y: 12 * TILE, taken: false },   // 6: forest interior
  { x: 22 * TILE, y: 22 * TILE, taken: false },   // 7: forest clearing
  { x: 8 * TILE,  y: 15 * TILE, taken: false },   // 8: town alley
  { x: 14 * TILE, y: 24 * TILE, taken: false },   // 9: south field edge
  { x: 33 * TILE, y: 18 * TILE, taken: false },   // 10: eastern grove
];
let kappaBerrySpot = { x: 38 * TILE, y: 28 * TILE, taken: false }; // far SE corner (hidden)

function useToolOrInteract() {
  // Check nearby action first (shop/sleep/npc/barn/coop/blacksmith/carpenter)
  if (nearbyAction) {
    if (nearbyAction.type === 'shop') openShop();
    else if (nearbyAction.type === 'sleep') trySleep();
    else if (nearbyAction.type === 'blacksmith') openBlacksmith();
    else if (nearbyAction.type === 'barn') openBarn();
    else if (nearbyAction.type === 'coop') openCoop();
    else if (nearbyAction.type === 'carpenter') openCarpenter();
    else if (nearbyAction.type === 'sprites') openSpriteHut();
    else if (nearbyAction.type === 'record_player') openRecordPlayer();
    else if (nearbyAction.type === 'npc') {
      const npc = npcs.find(n => n.id === nearbyAction.id);
      if (npc) {
        npcSetSpokenTo(n);   // fomt npc.cc:82-95 — first meeting only sets met=true
        showDialog(npc.name, npc.dialog);
        updateHUD();
      }
    }
    return;
  }
  const { fx, fy } = getFacingTile();
  if (fx < 0 || fy < 0 || fx >= MAP_W || fy >= MAP_H) return;
  const tile = map[fy][fx];

  if (selectedTool === 'hoe') {
    if (tile === T.GRASS || tile === T.GRASS2 || tile === T.FLOWER) {
      if (isExhausted()) { toast('Kau terlalu lelah untuk bekerja...', 'warn'); return; }
      map[fy][fx] = T.TILLED;
      cropMap[fy][fx] = null;
      adjustStamina(-2);  // fomt tool cost
      toolAddUsage(0, 1);  // fomt ToolLevel.AddUsage — Hoe family index 0
      toast('Tanah dicangkul', 'info');
      spawnParticles(fx*TILE+TILE/2, fy*TILE+TILE/2, '#8a6a3a', 6);
      updateHUD();
      save();
    } else {
      toast('Tidak bisa dicangkul di sini', 'warn');
    }
  }
  else if (selectedTool === 'seeds') {
    if (tile === T.TILLED || tile === T.WATERED) {
      if ((player.seeds[selectedSeed] ?? 0) > 0) {
        if (cropMap[fy][fx]) { toast('Sudah ada tanaman di sini', 'warn'); return; }
        player.seeds[selectedSeed]--;
        syncInvItem('seeds', player.seeds[selectedSeed]);   // sync hotbar count
        cropMap[fy][fx] = {
          type: selectedSeed,
          fomtCropId: CROPS[selectedSeed].fomtCropId,   // fomt crop id (field.cc:597-630)
          stage: 0,             // 0=seed, 1=sprout, 2=mid, 3=mature (game stages)
          fomtStage: window.FOMT_CROPS?.STAGE?.SEED ?? 1, // fomt STAGE (1=SEED) — separate counter to track 1:1 with fomt
          growthDays: 0,       // legacy counter (kept for saves without fomt fields)
          fomtCounter: 0,       // fomt day-counter (separate from growthDays; matches field.cc:666 unk_00_0C)
          wateredToday: (tile === T.WATERED),
        };
        toast(`Ditanam: ${CROPS[selectedSeed].name}`, 'info');
        showPopup(selectedSeed, CROPS[selectedSeed].name, 'plant', '+1');  // popup
        renderToolbar(); updateHUD();
        save();
      } else {
        toast(`Benih ${CROPS[selectedSeed].name} habis! Beli di toko.`, 'warn');
      }
    } else {
      toast('Cangkul dulu tanahnya', 'warn');
    }
  }
  else if (selectedTool === 'water') {
    if (tile === T.WATER) {
      player.water = player.maxWater;
      syncInvItem('water', player.water);   // sync hotbar count
      toast('Penyiram penuh!', 'info');
      updateHUD();
      return;
    }
    if (player.water <= 0) { toast('Penyiram kosong! Isi di kolam.', 'warn'); return; }
    if (isExhausted()) { toast('Tanganmu gemetar... terlalu lelah.', 'warn'); return; }
    if (tile === T.TILLED) {
      map[fy][fx] = T.WATERED;
      if (cropMap[fy][fx]) cropMap[fy][fx].wateredToday = true;
      player.water--;
      adjustStamina(-2);  // fomt tool cost
      syncInvItem('water', player.water);   // sync hotbar count
      spawnParticles(fx*TILE+TILE/2, fy*TILE+TILE/2, '#5ab0ff', 5);
      updateHUD();
      save();
    } else if (tile === T.WATERED) {
      if (cropMap[fy][fx]) {
        cropMap[fy][fx].wateredToday = true;
        player.water--;
        adjustStamina(-2);  // fomt tool cost
        syncInvItem('water', player.water);   // sync hotbar count
        spawnParticles(fx*TILE+TILE/2, fy*TILE+TILE/2, '#5ab0ff', 5);
        updateHUD();
        save();
      } else {
        toast('Sudah basah', 'warn');
      }
    } else {
      toast('Cangkul dulu tanahnya', 'warn');
    }
  }
  else if (selectedTool === 'sickle') {
    const crop = cropMap[fy][fx];
    // Mature when game stage >= 3 (legacy) OR fomtStage is MATURE(5)/GRASS_HARVESTED(7).
    const FOMT_C = window.FOMT_CROPS;
    const matureFomt = FOMT_C && crop && crop.fomtStage != null &&
      (crop.fomtStage === FOMT_C.STAGE.MATURE || crop.fomtStage === FOMT_C.STAGE.GRASS_HARVESTED);
    if (crop && (crop.stage >= 3 || matureFomt)) {
      if (isExhausted()) { toast('Terlalu lelah untuk memanen...', 'warn'); return; }
      adjustStamina(-2);  // fomt tool cost
      toolAddUsage(1, 1);  // fomt ToolLevel.AddUsage — Sickle family index 1
      AudioManager.playPickup();

      // fomt harvest() path: returns {yield, stage, counter}. For regrow crops,
      // stage is set to REGROW_TABLE[cropId].stage and counter to .days. For
      // one-time crops, stage becomes NONE (0) → crop dies.
      let harvestedKey = crop.type;       // game inventory key to credit (default: same as planted seed)
      let regrows = false;                 // true if crop survives this harvest
      if (FOMT_C && crop.fomtStage != null && crop.fomtCropId != null) {
        const r = FOMT_C.harvest(crop.fomtCropId, crop.fomtStage);
        if (r.yield) {
          // Map fomt foodId → game crop key via the reverse lookup
          const foodMap = ensureFomtFoodMap();
          if (foodMap && foodMap[r.yield.id]) {
            harvestedKey = foodMap[r.yield.id];
          }
          // (If foodMap has no entry — e.g. article-yielding flowers — fall back to crop.type.)
        }
        // Determine regrow: new stage is NONE(0) → crop dies. Otherwise crop lives.
        if (r.stage === FOMT_C.STAGE.NONE) {
          regrows = false;
        } else {
          regrows = true;
          crop.fomtStage = r.stage;
          crop.fomtCounter = r.counter;
          crop._harvested = true;       // flag for advanceDay regrowing counter
          crop._wasMature = false;      // reset mature flag so next mature fires a toast
          // Map new fomt stage → game stage for drawing
          if (r.stage === FOMT_C.STAGE.MATURE) crop.stage = 3;
          else if (r.stage === FOMT_C.STAGE.GRASS_HARVESTED) crop.stage = 1;
          else if (r.stage === FOMT_C.STAGE.SEED) crop.stage = 0;
          else crop.stage = Math.min(2, r.stage - 1);
          crop.wilted = false;
        }
      }

      // Credit yield to inventory + sync hotbar
      player.inventory[harvestedKey] = (player.inventory[harvestedKey] || 0) + 1;
      syncInvItem(harvestedKey, player.inventory[harvestedKey]);
      toast(`Dipanen: ${CROPS[harvestedKey].name} (+1)${regrows ? ' 🌿 tumbuh ulang' : ''}`, 'gold');
      showPopup(harvestedKey, CROPS[harvestedKey].name, 'harvest', '+1');  // popup notification
      spawnParticles(fx*TILE+TILE/2, fy*TILE+TILE/2, CROPS[harvestedKey].color, 8);

      if (regrows) {
        // Crop survives harvest — keep tile watered state as-is (will be cleared next day)
        // For grass (GRASS_HARVESTED → regrows next day to stage 1), keep on TILLED/WATERED tile.
      } else {
        // Crop dies (one-time harvest) — clear the plot
        cropMap[fy][fx] = null;
        map[fy][fx] = T.TILLED;
      }
      renderToolbar(); updateHUD();
      save();
    } else if (crop) {
      toast('Belum matang', 'warn');
    } else {
      toast('Tidak ada yang dipanen', 'warn');
    }
  }
  else if (selectedTool === 'axe') {
    if (tile === T.TREE) {
      if (isExhausted()) { toast('Kapak terlalu berat... kau lelah.', 'warn'); return; }
      map[fy][fx] = T.GRASS;
      adjustStamina(-3);  // fomt axe cost (heavier tool)
      toolAddUsage(2, 1);  // fomt ToolLevel.AddUsage — Axe family index 2
      toast('Pohon ditebang 🪵', 'info');
      spawnParticles(fx*TILE+TILE/2, fy*TILE+TILE/2, '#5a3a1a', 8);
      updateHUD();
      save();
    } else {
      toast('Tidak bisa ditebang', 'warn');
    }
  }
}

function tryOpenShop() {
  if (nearbyAction && nearbyAction.type === 'shop') openShop();
  else toast('Pergi ke toko dulu (bangunan utara)', 'warn');
}
function trySleep() {
  if (nearbyAction && nearbyAction.type === 'sleep') {
    // Sleep: advance day
    sleepTransition = 1;
    setTimeout(() => {
      advanceDay();
      sleepTransition = 0;
    }, 500);
  } else {
    toast('Pergi ke rumah untuk tidur', 'warn');
  }
}

function advanceDay() {
  day++;
  seasonDay++;
  const seasonChanged = seasonDay > 28;
  if (seasonChanged) {
    seasonDay = 1;
    const oldSeason = season;
    season = nextSeason(season);
  }
  timeOfDay = 6 * 60;
  // ===== fomt farmer DayUpdate (farmer.cc): stamina = max, fatigue = 0 =====
  player.stamina = player.maxStamina;
  player.fatigue = 0;
  // ===== fomt NPC DayUpdate (npc.cc:108-135) =====
  // arg_00 < 10 = early game (gentler decay). Friendship +1 if spoken today,
  // -1 if ignored AND early game AND has met NPC. days_since_last_spoken caps at 31.
  // Capture pre-update spoken_today for bachelorettes BEFORE we reset it (the fomt
  // Bachelorette::DayUpdate at line 98 reads HasBeenSpokenToToday() BEFORE Npc::DayUpdate
  // resets it; we mirror that order by capturing the pre-reset flag here).
  const earlyGame = day < 10;
  const bachPreState = [];  // [{npc, wasSpokenToday}]
  for (const n of npcs) {
    if (!n.met) continue;   // fomt: never-met NPCs don't tick
    if (n.isBachelorette) {
      bachPreState.push({ npc: n, wasSpokenToday: !!n.spoken_today });
    }
    // ===== fomt 1:1 Npc::DayUpdate (npc.cc:108-135) =====
    // If spoken_today OR gifted_today → days_since_last_spoken = 0 (reset)
    // Else → days_since_last_spoken++ (cap 31) + -1 friendship if early game
    if (!n.spoken_today && !n.gifted_today) {
      if (n.days_since_last_spoken < 31) n.days_since_last_spoken++;
      if (earlyGame) n.friendship = Math.max(0, n.friendship - 1);
    } else {
      n.days_since_last_spoken = 0;
      if (n.spoken_today) n.friendship = Math.min(255, n.friendship + 1);
    }
    n.spoken_today = false;
    n.spoken_just_now = false;
    n.gifted_today = false;
  }
  // ===== fomt Bachelorette::DayUpdate (bachelorette.cc:95-123) =====
  // Called AFTER the Npc::DayUpdate loop, mirroring fomt where Npc::DayUpdate is invoked
  // inside Bachelorette::DayUpdate at line 100 (after the +200 love bonus, before the
  // -200 penalty reads GetDaysSinceLastSpoken()). arg_01 is the year counter (fomt uses
  // 120-day years: 4 seasons × 30 days). decay_love=true means rival is active (year >= 1).
  const bachYear = Math.floor((day - 1) / 120);   // fomt arg_01; 120 days/year (4 seasons × 30 days)
  const bachDecayLove = bachYear >= 1;             // rival becomes active after year 1
  for (const bs of bachPreState) {
    bachDayUpdate(bs.npc, bachDecayLove, bachYear, bs.wasSpokenToday);
  }
  // Grow crops + fomt season-kill (field.cc:593-632)
  // fomt stepGrowth() integration: when window.FOMT_CROPS is loaded, delegate growth to
  // the fomt 1:1 simulation (GROWTH_TABLE lookup, season-kill, grass-special). Legacy
  // growth logic is kept as a fallback for old saves without fomtStage/fomtCounter fields.
  const FOMT_C = window.FOMT_CROPS;
  const FOMT_SEASON = { spring: 0, summer: 1, fall: 2, winter: 3 };
  const fomtSeason = FOMT_SEASON[season] ?? 0;
  let grown = 0, killed = 0, regrowing = 0;
  for (let y = 0; y < MAP_H; y++) {
    for (let x = 0; x < MAP_W; x++) {
      const c = cropMap[y][x];
      if (!c) {
        if (map[y][x] === T.WATERED) map[y][x] = T.TILLED;
        continue;
      }
      // fomt field.cc:593-632: on day 1 of new season, kill out-of-season crops.
      // (stepGrowth also does this internally; we keep the explicit check for
      // legacy-format crops that lack fomtStage. Redundant but harmless.)
      if (seasonChanged && CROPS[c.type].season !== season) {
        cropMap[y][x] = null;
        map[y][x] = (season === 'winter') ? T.GRASS : T.TILLED;  // fomt: winter forces snow state (here: grass)
        killed++;
        continue;
      }
      // fomt stepGrowth path: only for crops that have fomtStage + fomtCounter fields
      // AND when the fomt crop DB is loaded. Otherwise fall back to legacy logic below.
      if (FOMT_C && c.fomtStage != null && c.fomtCounter != null) {
        // Map game tile state → fomt TILE_STATE: T.TILLED=DRY_TILLED(1), T.WATERED=WATERED(2)
        const fomtTileState = (map[y][x] === T.WATERED) ? FOMT_C.TILE_STATE.WATERED : FOMT_C.TILE_STATE.DRY_TILLED;
        const fomtCropId = c.fomtCropId ?? CROPS[c.type].fomtCropId;
        const r = FOMT_C.stepGrowth(
          fomtCropId,
          fomtTileState,
          c.fomtStage,
          c.fomtCounter,
          fomtSeason,
          FOMT_C.WEATHER.SUNNY,
          day
        );
        c.fomtStage = r.stage;
        c.fomtCounter = r.counter;
        // Map fomt stage → game stage for drawing (see task spec section 3)
        if (r.stage === FOMT_C.STAGE.NONE) {
          // crop is dead — clear the tile
          cropMap[y][x] = null;
          map[y][x] = T.TILLED;
          killed++;
          if (map[y][x] === T.WATERED) map[y][x] = T.TILLED;
          continue;
        } else if (r.stage === FOMT_C.STAGE.WILTED) {
          // wilted crop stays on tile but is dried/brown — game stage 0
          c.stage = 0;
          c.wilted = true;
        } else if (r.stage === FOMT_C.STAGE.MATURE) {
          c.stage = 3;
          if (!c._wasMature) { grown++; c._wasMature = true; }
        } else if (r.stage === FOMT_C.STAGE.GRASS_HARVESTED) {
          // grass was harvested; regrows to stage 1 next day. Keep alive at game stage 1.
          c.stage = 1;
          regrowing++;
        } else if (r.stage === FOMT_C.STAGE.SEED) {
          c.stage = 0;
        } else {
          // GROWING_1/2/3 (2/3/4) → game stage 1 or 2 (per spec: Math.min(2, fomtStage-1))
          c.stage = Math.min(2, r.stage - 1);
        }
        // Wilted flag persists across days once set (fomt stage 6). Otherwise clear it
        // if stepGrowth advanced the stage back to a non-wilted state.
        if (r.stage !== FOMT_C.STAGE.WILTED) c.wilted = false;
        // Detect regrowing crops (post-harvest: fomtStage 2/3/4 with non-zero counter
        // after a previous MATURE). Approximation: any non-MATURE, non-SEED crop with
        // a regrow entry that has previously been harvested. Track via c._harvested flag.
        if (c._harvested && r.stage !== FOMT_C.STAGE.MATURE && r.stage > FOMT_C.STAGE.SEED) regrowing++;
      } else {
        // Legacy growth path (old saves without fomt fields, or FOMT_CROPS not loaded)
        if (c.wateredToday && c.stage < 3) {
          c.growthDays++;
          const need = CROPS[c.type].days;
          if (c.growthDays >= need) c.stage = 3;
          else c.stage = Math.min(2, Math.floor(c.growthDays / need * 3));
          if (c.stage === 3) grown++;
          c.wateredToday = false;
        } else {
          c.wateredToday = false;
        }
      }
      if (map[y][x] === T.WATERED) map[y][x] = T.TILLED;
    }
  }
  player.water = player.maxWater;
  // ===== fomt Livestock DayUpdate (animal.cc, livestock.cc, cow/sheep/chicken.cc) =====
  // Tick all cows/sheep/chickens: age++, fed handling, unhappy/sick tracking,
  // pregnancy tick + birth, growth stage recompute, egg laying. Removes dead animals.
  livestockDayUpdate();
  // ===== fomt Harvest Sprite DayUpdate + auto-work (harvest_sprite.cc) =====
  // For each hired sprite (work_days_left > 0, current_task != TASK_NONE):
  //   - TASK_HARVEST: auto-harvest all mature crops (game stage >= 3 OR fomtStage == 5 MATURE)
  //     harvested crops → player.inventory (same as manual harvest)
  //   - TASK_WATER: auto-water all TILLED tiles (sets to WATERED + crop.wateredToday=true)
  //   - TASK_ANIMALS: auto-feed + brush all cows/sheep + feed all chickens
  // Then call hsDayUpdate() — runs Npc::DayUpdate (early game -1 if not spoken, +1 if spoken),
  // resets played_minigame, then TaskDayUpdate (work_days_left--, -2 friendship, clear task if 0).
  for (const sprite of harvestSprites) {
    if (sprite.work_days_left > 0 && sprite.current_task !== HS_TASK_NONE) {
      if (sprite.current_task === HS_TASK_HARVEST) {
        let harvested = 0;
        for (let y = 0; y < MAP_H; y++) {
          for (let x = 0; x < MAP_W; x++) {
            const c = cropMap[y][x];
            if (!c) continue;
            // Mature: fomt STAGE.MATURE == 5 → game stage 3; OR game stage >= 3 directly
            const isMature = (c.fomtStage != null && window.FOMT_CROPS && c.fomtStage === window.FOMT_CROPS.STAGE.MATURE)
                          || (c.stage >= 3);
            if (isMature) {
              player.inventory[c.type] = (player.inventory[c.type] || 0) + 1;
              // Mark regrow flag for crops with regrow table (fomt regrow counter starts on harvest)
              if (window.FOMT_CROPS && window.FOMT_CROPS.REGROW_TABLE) {
                const cid = c.fomtCropId ?? CROPS[c.type].fomtCropId;
                if (window.FOMT_CROPS.REGROW_TABLE[cid]) {
                  c._harvested = true;
                  // Don't clear cropMap — regrow cycle continues. Set stage back to non-mature.
                  c.stage = 2;
                  continue;
                }
              }
              // Non-regrowing: clear the crop, tile becomes TILLED
              cropMap[y][x] = null;
              map[y][x] = T.TILLED;
              harvested++;
            }
          }
        }
        if (harvested > 0) toast(`🌱 ${sprite.name} memanen ${harvested} tanaman!`, 'gold');
      } else if (sprite.current_task === HS_TASK_WATER) {
        let watered = 0;
        for (let y = 0; y < MAP_H; y++) {
          for (let x = 0; x < MAP_W; x++) {
            if (map[y][x] === T.TILLED) {
              map[y][x] = T.WATERED;
              if (cropMap[y][x]) cropMap[y][x].wateredToday = true;
              watered++;
            }
          }
        }
        if (watered > 0) toast(`💧 ${sprite.name} menyiram ${watered} petak!`, 'info');
      } else if (sprite.current_task === HS_TASK_ANIMALS) {
        for (const cow of livestock.cows) { cow.fed = true; cow.brushed = true; }
        for (const sheep of livestock.sheep) { sheep.fed = true; sheep.brushed = true; }
        for (const chicken of livestock.chickens) { chicken.fed = true; }
        toast(`🐄 ${sprite.name} merawat semua hewan!`, 'info');
      }
    }
    // fomt harvest_sprite.cc:118-122 DayUpdate — runs Npc::DayUpdate, played_minigame=false,
    // then TaskDayUpdate (work_days_left--, -2 friendship, clear task if 0).
    hsDayUpdate(sprite, earlyGame);
  }
  // ===== fomt FarmHouse DayUpdate (farm_house.cc:355-390) =====
  // - fireplace_lighted = false (always goes out)
  // - vase flower lifespan-- ; wither if wrong season ; ~39.5% wither when lifespan=0
  fhDayUpdate(season);
  let msg = `🌅 Hari ${day} — ${seasonLabel(season)}`;
  if (grown > 0) msg += `. ${grown} tanaman matang!`;
  if (killed > 0) msg += ` ❌ ${killed} tanaman mati karena musim salah.`;
  if (regrowing > 0) msg += ` 🌿 ${regrowing} tanaman sedang tumbuh ulang.`;
  toast(msg, 'info');
  updateHUD();
  renderToolbar();
  save();
}
function nextSeason(s) {
  const order = ['spring','summer','fall','winter'];
  return order[(order.indexOf(s) + 1) % 4];
}
function seasonLabel(s) {
  return { spring:'Semi', summer:'Panas', fall:'Gugur', winter:'Dingin' }[s];
}
function seasonIcon(s) {
  return { spring:'🌱', summer:'☀️', fall:'🍂', winter:'❄️' }[s];
}

// ---------- Shop ----------
function openShop() {
  menuOpen = 'shop';
  const panel = document.getElementById('menu-panel');
  let html = `<h2>🛒 Toko Benih Harvest Vale</h2>
    <div class="subtitle">Emasmu: <strong style="color:#ffd54a">${player.gold}g</strong></div>
    <h3 style="color:#88e06a; font-size:13px; margin:10px 0 6px;">📥 BELI BENIH</h3>
    <div class="menu-grid">`;
  // Buy seeds
  for (const key of SEED_LIST) {
    const c = CROPS[key];
    const owned = player.seeds[key] || 0;
    // fomt 1:1 shop info: days to mature (DAYS_TO_MATURE), sell price (CROP_SELL_PRICE),
    // and regrow flag (REGROW_TABLE presence). Falls back to legacy `days`/`sell` fields
    // when fomt crop DB is not loaded yet.
    const FOMT_C = window.FOMT_CROPS;
    const cid = c.fomtCropId;
    const fomtDays = (FOMT_C && FOMT_C.DAYS_TO_MATURE && FOMT_C.DAYS_TO_MATURE[cid] != null)
      ? FOMT_C.DAYS_TO_MATURE[cid] : c.days;
    const fomtSell = (FOMT_C && FOMT_C.CROP_SELL_PRICE && FOMT_C.CROP_SELL_PRICE[cid] != null)
      ? FOMT_C.CROP_SELL_PRICE[cid] : c.sell;
    const regrows = !!(FOMT_C && FOMT_C.REGROW_TABLE && FOMT_C.REGROW_TABLE[cid]);
    html += `<div class="menu-item" data-action="buy" data-seed="${key}">
      <div class="emoji">${c.icon}</div>
      <div class="info">
        <div class="name">Benih ${c.name}</div>
        <div class="meta" style="color:#a0b090;">${fomtDays} hari · Jual ${fomtSell}g${regrows ? ' · 🌿 regrow' : ''}</div>
        <div class="qty">Dimiliki: ${owned}</div>
      </div>
      <div class="price buy">${c.seedCost}g</div>
    </div>`;
  }
  html += `</div>
    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">📤 JUAL HASIL PANEN</h3>
    <div class="menu-grid">`;
  // Sell harvested
  for (const key of SEED_LIST) {
    const c = CROPS[key];
    const have = player.inventory[key] || 0;
    const disabled = have <= 0 ? ' disabled' : '';
    html += `<div class="menu-item${disabled ? ' disabled' : ''}" data-action="sell" data-seed="${key}">
      <div class="emoji">${c.icon}</div>
      <div class="info">
        <div class="name">Panen ${c.name}</div>
        <div class="meta" style="color:#a0b090;">Jual hasil panen</div>
        <div class="qty">Stok: ${have}</div>
      </div>
      <div class="price sell">${c.sell}g</div>
    </div>`;
  }
  html += `</div>
    <button class="menu-close" id="shop-close">Tutup (Esc)</button>`;
  panel.innerHTML = html;
  document.getElementById('menu').classList.add('show');
  panel.querySelectorAll('.menu-item').forEach(el => {
    el.addEventListener('click', () => {
      if (el.classList.contains('disabled')) return;
      const action = el.dataset.action;
      const seed = el.dataset.seed;
      if (action === 'buy') {
        const cost = CROPS[seed].seedCost;
        if (player.gold >= cost) {
          player.gold -= cost;
          player.seeds[seed] = (player.seeds[seed] || 0) + 1;
          toast(`Dibeli: Benih ${CROPS[seed].name} (-${cost}g)`, 'gold');
          showPopup(seed, 'Benih ' + CROPS[seed].name, 'buy', `-${cost}g`);  // popup
          updateHUD(); renderToolbar();
          openShop(); // refresh
          save();
        } else {
          toast('Emas tidak cukup!', 'warn');
        }
      } else if (action === 'sell') {
        if ((player.inventory[seed] || 0) > 0) {
          player.inventory[seed]--;
          // ===== fomt 1:1 ShippingBin integration (shipping_bin.cc:150-161) =====
          // Sell goes through the shipping bin, which tracks per-product stats + total value.
          // Map our crop key → fomt product tag, then call shippingBinShip.
          const FOMT_CROP_TAG_MAP = {
            parsnip: 'TURNIP', potato: 'POTATO', tomato: 'TOMATO', corn: 'CORN',
            carrot: 'CARROT', pumpkin: 'PUMPKIN', cabbage: 'CABBAGE', beetroot: 'EGGPLANT',
            cauliflower: 'CUCUMBER', kale: 'SPINACH', radish: 'STRAWBERRY',
            sunflower: 'PINEAPPLE', wheat: 'ONION',
          };
          const fomtTag = FOMT_CROP_TAG_MAP[seed];
          if (window.FOMT && fomtTag && window.FOMT.PRODUCT_BY_TAG[fomtTag]) {
            const prod = window.FOMT.PRODUCT_BY_TAG[fomtTag];
            const price = prod.price;
            shippingBinShip(prod.id, price);                  // tracks stats + valueShipped
            player.gold += price;
            toast(`Terjual: ${CROPS[seed].name} (+${price}g) [shipped: ${shippingBinGetAmount(prod.id)}x]`, 'gold');
            showPopup(seed, CROPS[seed].name, 'sell', `+${price}g`);
          } else {
            // Fallback if fomt data not loaded yet
            player.gold += CROPS[seed].sell;
            toast(`Terjual: ${CROPS[seed].name} (+${CROPS[seed].sell}g)`, 'gold');
            showPopup(seed, CROPS[seed].name, 'sell', `+${CROPS[seed].sell}g`);
          }
          updateHUD(); renderToolbar();
          openShop();
          save();
        }
      }
    });
  });
  document.getElementById('shop-close').addEventListener('click', closeMenu);
}
// ===== Blacksmith — Tool Upgrade UI (fomt farmer.cc func_0800E550) =====
// fomt mechanic: the blacksmith upgrades tool tiers via the func_0800E550 switch.
// Each tier requires a minimum tool usage count (proxy for fomt's "tool experience")
// AND a gold cost. We use SetPendingLevel + Commit immediately (in fomt the smith
// commits the upgrade on the spot — pending only matters for Pickaxe/Cursed tools,
// which we don't model).
//
// Tier ladder (matches fomt ToolLevel enum):
//   LEVEL_0 Iron → LEVEL_1 Copper → LEVEL_2 Silver → LEVEL_3 Gold
//            → LEVEL_4 Mystrile → LEVEL_5 Mythic
//
// Usage requirement + gold cost per tier (task spec):
//   → Copper:   1000g + usage ≥ 100
//   → Silver:   2000g + usage ≥ 200
//   → Gold:     3000g + usage ≥ 400
//   → Mystrile: 5000g + usage ≥ 800
//   → Mythic:  10000g + usage ≥ 1500 (fomt post-game)
const TOOL_TIER_NAMES = ['Iron', 'Copper', 'Silver', 'Gold', 'Mystrile', 'Mythic'];
const TOOL_UPGRADE_COST =     [1000, 2000, 3000, 5000, 10000];   // gold for LEVEL_0→1, 1→2, ..., 4→5
const TOOL_UPGRADE_USAGE_REQ = [ 100,  200,  400,  800,  1500];   // min usage for each upgrade tier
// Map family index → display name (TOOL_FAMILY_NAMES already exists, but we want a
// prettier label with an emoji prefix for the panel)
const TOOL_FAMILY_LABELS = ['⛏️ Hoe', '✂️ Sickle', '🪓 Axe', '🔨 Hammer', '💧 Watering Can', '🎣 Fishing Rod'];
function openBlacksmith() {
  menuOpen = 'blacksmith';
  const panel = document.getElementById('menu-panel');
  let html = `<h2>🔧 Tukang Besi Harvest Vale</h2>
    <div class="subtitle">Emasmu: <strong style="color:#ffd54a">${player.gold}g</strong> · Tingkatkan alatmu supaya lebih efisien!</div>
    <div class="menu-grid">`;
  // List each of the 6 tool families with current level, usage, and upgrade button
  for (let i = 0; i < 6; i++) {
    const tl = toolLevels[i];
    const curTier = tl.committedLevel;
    const curTierName = TOOL_TIER_NAMES[curTier];
    const isMax = curTier >= TOOL_LEVEL_MAX;
    const upgradeCost = isMax ? 0 : TOOL_UPGRADE_COST[curTier];
    const usageReq   = isMax ? 0 : TOOL_UPGRADE_USAGE_REQ[curTier];
    const usage = tl.usage;
    const hasUsage = isMax || usage >= usageReq;
    const hasGold  = isMax || player.gold >= upgradeCost;
    const canUpgrade = !isMax && hasUsage && hasGold;
    const upgradeTo = isMax ? '' : TOOL_TIER_NAMES[curTier + 1];
    // Tier dot indicator (Iron=●, Copper=🟠, Silver=⚪, Gold=🟡, Mystrile=🔵, Mythic=🟣)
    const tierDots = '●'.repeat(curTier) + '○'.repeat(TOOL_LEVEL_MAX - curTier);
    let actionHtml;
    if (isMax) {
      actionHtml = `<div class="price sell" style="color:#88e06a">MAX</div>`;
    } else {
      const reqStr = `${usage}/${usageReq}`;
      const reqColor = hasUsage ? '#88e06a' : '#ff7a6a';
      actionHtml = `<button class="menu-item${canUpgrade ? '' : ' disabled'}" data-action="upgrade" data-family="${i}" style="padding:6px 10px; cursor:pointer; border-radius:8px; border:1px solid #6a8a40; background:rgba(120,180,80,0.15); color:#fff;">
        <div class="info" style="text-align:right">
          <div class="name" style="font-size:12px">${upgradeCost}g → ${upgradeTo}</div>
          <div class="meta" style="color:${reqColor}">Usage ${reqStr}</div>
        </div>
      </button>`;
    }
    html += `<div class="menu-item" style="cursor:default">
      <div class="emoji">${TOOL_FAMILY_LABELS[i].split(' ')[0]}</div>
      <div class="info">
        <div class="name">${TOOL_FAMILY_LABELS[i].split(' ').slice(1).join(' ')} <span style="color:#a0b090; font-weight:400">(${curTierName})</span></div>
        <div class="meta" style="color:#7a8a60">${tierDots} · Usage: ${usage}${isMax ? '' : ` / ${usageReq}`}</div>
      </div>
      ${actionHtml}
    </div>`;
  }
  html += `</div>
    <button class="menu-close" id="black-close">Tutup (Esc)</button>`;
  panel.innerHTML = html;
  document.getElementById('menu').classList.add('show');
  // Wire upgrade buttons
  panel.querySelectorAll('[data-action="upgrade"]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.classList.contains('disabled')) return;
      const familyIdx = parseInt(btn.dataset.family, 10);
      upgradeTool(familyIdx);
    });
  });
  document.getElementById('black-close').addEventListener('click', closeMenu);
}
// upgradeTool(familyIdx): performs the fomt blacksmith upgrade.
//   1. Validate current tier < MAX
//   2. Validate usage ≥ requirement AND gold ≥ cost
//   3. Deduct gold
//   4. toolSetPendingLevel(familyIdx, newLevel) — fomt func_0800EFB4
//   5. toolCommitLevel(familyIdx) — fomt func_0800EFD8 (smith commits on the spot)
//   6. Toast + save + refresh panel
function upgradeTool(familyIdx) {
  const tl = toolLevels[familyIdx];
  if (tl.committedLevel >= TOOL_LEVEL_MAX) {
    toast('Alat ini sudah setingkat Mythic!', 'warn');
    return;
  }
  const newLevel = tl.committedLevel + 1;
  const cost = TOOL_UPGRADE_COST[tl.committedLevel];
  const usageReq = TOOL_UPGRADE_USAGE_REQ[tl.committedLevel];
  if (tl.usage < usageReq) {
    toast(`Pakai ${TOOL_FAMILY_LABELS[familyIdx].split(' ').slice(1).join(' ')} lagi dulu (${tl.usage}/${usageReq}).`, 'warn');
    return;
  }
  if (player.gold < cost) {
    toast(`Emas tidak cukup! Butuh ${cost}g.`, 'warn');
    return;
  }
  // fomt farmer.cc func_0800E550: switch on (toolId, level) → new tool id
  // We model this via SetPendingLevel + Commit (single-step transaction)
  player.gold -= cost;
  toolSetPendingLevel(familyIdx, newLevel);
  toolCommitLevel(familyIdx);
  const newName = TOOL_TIER_NAMES[newLevel];
  const famName = TOOL_FAMILY_LABELS[familyIdx].split(' ').slice(1).join(' ');
  toast(`🔧 ${famName} upgraded to ${newName}! (Usage: ${tl.usage})`, 'gold');
  AudioManager.playPickup();
  updateHUD();
  save();
  // Refresh the blacksmith panel so the new tier shows
  openBlacksmith();
}

// ===== fomt Barn/Coop menu UI (barn.hh Barn, coop.hh Coop) =====
// openBarn(): list cows + sheep, buy animals, buy fodder/medicine, interact with each animal.
//   fomt interactions (Barn::Ent + BarnAnimal): feed, brush, talk, milk (cow), shear (sheep),
//   impregnate (cow/sheep), cure sick animal. Each action is a button next to the animal.
function openBarn() {
  menuOpen = 'barn';
  const panel = document.getElementById('menu-panel');
  const capacity = getBarnCapacity();
  const used = countBarnAnimals();
  // Helper: render one animal row with action buttons
  function renderAnimalRow(a, idx, kindLabel, emoji) {
    const hearts = animalHearts(a);
    const heartStr = '❤'.repeat(hearts) + '🤍'.repeat(10 - hearts);
    const stageNames = (a.kind === 'cow')
      ? ['Baby', 'Medium', 'Adult']
      : ['Lamb', 'Adult'];
    const stageName = stageNames[a.growthStage] || 'Adult';
    const stateParts = [];
    if (a.fed) stateParts.push('✓Fed');
    if (a.brushed) stateParts.push('✓Brush');
    if (a.talked) stateParts.push('✓Talk');
    if (a.sick) stateParts.push('🤒Sick');
    else if (a.unhappy) stateParts.push('😢Unhappy');
    if (a.pregnant) stateParts.push(`🤰${a.days_pregnant}d`);
    if (a.kind === 'cow' && a.milked) stateParts.push('✓Milked');
    if (a.kind === 'sheep' && a.days_until_product > 0) stateParts.push(`✂️${a.days_until_product}d`);
    const stateStr = stateParts.length ? stateParts.join(' · ') : '—';
    // Action buttons (each is a small clickable element)
    const btns = [];
    btns.push(`<button class="ls-btn" data-act="feed" data-idx="${idx}" data-kind="${a.kind}" ${a.fed ? 'disabled' : ''}>Feed</button>`);
    btns.push(`<button class="ls-btn" data-act="brush" data-idx="${idx}" data-kind="${a.kind}" ${a.brushed ? 'disabled' : ''}>Brush</button>`);
    btns.push(`<button class="ls-btn" data-act="talk" data-idx="${idx}" data-kind="${a.kind}" ${a.talked ? 'disabled' : ''}>Talk</button>`);
    if (a.kind === 'cow') {
      btns.push(`<button class="ls-btn" data-act="milk" data-idx="${idx}" data-kind="${a.kind}" ${a.milked ? 'disabled' : ''}>Milk</button>`);
      btns.push(`<button class="ls-btn" data-act="stock" data-idx="${idx}" data-kind="${a.kind}" ${a.milked ? 'disabled' : ''}>📦Stock</button>`);
    } else if (a.kind === 'sheep') {
      btns.push(`<button class="ls-btn" data-act="shear" data-idx="${idx}" data-kind="${a.kind}" ${a.days_until_product > 0 ? 'disabled' : ''}>Shear</button>`);
      btns.push(`<button class="ls-btn" data-act="stock" data-idx="${idx}" data-kind="${a.kind}" ${a.days_until_product > 0 ? 'disabled' : ''}>📦Stock</button>`);
    }
    if (a.sick) {
      btns.push(`<button class="ls-btn" data-act="cure" data-idx="${idx}" data-kind="${a.kind}">💊Cure</button>`);
    } else if (a.kind !== 'chicken' && !a.pregnant) {
      btns.push(`<button class="ls-btn" data-act="impreg" data-idx="${idx}" data-kind="${a.kind}">🤰Preg</button>`);
    }
    return `<div class="ls-animal">
      <div class="ls-animal-info">
        <span class="ls-emoji">${emoji}</span>
        <span class="ls-name">${a.name}</span>
        <span class="ls-stage">(${stageName}, age ${a.age})</span>
        <span class="ls-hearts">${heartStr}</span>
        <span class="ls-state">${stateStr}</span>
      </div>
      <div class="ls-actions">${btns.join('')}</div>
    </div>`;
  }

  let html = `<h2>🐄 Kandang (Barn) — Harvest Vale</h2>
    <div class="subtitle">Kapasitas: ${used}/${capacity} · Fodder: ${barnState.fodder} · 💊 Obat: ${player.medicine || 0} · Emasmu: <strong style="color:#ffd54a">${player.gold}g</strong></div>
    <div style="margin:8px 0;">
      <button class="ls-btn" data-act="open-makers" style="font-size:13px; padding:6px 12px;">🏭 Maker ${makers.mayonnaise || makers.cheese || makers.yarn ? '(' + (makers.mayonnaise?'M':'') + (makers.cheese?'C':'') + (makers.yarn?'Y':'') + ')' : '(belum punya)'}</button>
    </div>
    <h3 style="color:#88e06a; font-size:13px; margin:10px 0 6px;">📥 BELI TERNAK & SUPPLIES</h3>
    <div class="menu-grid">
      <div class="menu-item" data-action="buy-animal" data-animal="cow" style="cursor:pointer">
        <div class="emoji">🐄</div>
        <div class="info"><div class="name">Beli Sapi (Cow)</div><div class="meta" style="color:#a0b090;">Dewasa · Produksi susu harian</div></div>
        <div class="price buy">${COW_BUY_PRICE}g</div>
      </div>
      <div class="menu-item" data-action="buy-animal" data-animal="sheep" style="cursor:pointer">
        <div class="emoji">🐑</div>
        <div class="info"><div class="name">Beli Domba (Sheep)</div><div class="meta" style="color:#a0b090;">Dewasa · Wol setiap 7 hari</div></div>
        <div class="price buy">${SHEEP_BUY_PRICE}g</div>
      </div>
      <div class="menu-item" data-action="buy-supply" data-supply="fodder" style="cursor:pointer">
        <div class="emoji">🌾</div>
        <div class="info"><div class="name">Beli Fodder x10</div><div class="meta" style="color:#a0b090;">Pakan ternak sapi/domba</div></div>
        <div class="price buy">${FODDER_BUY_PRICE * 10}g</div>
      </div>
      <div class="menu-item" data-action="buy-supply" data-supply="medicine" style="cursor:pointer">
        <div class="emoji">💊</div>
        <div class="info"><div class="name">Beli Obat Hewan</div><div class="meta" style="color:#a0b090;">Penyembuh hewan sakit</div></div>
        <div class="price buy">${ANIMAL_MEDICINE_BUY_PRICE}g</div>
      </div>
    </div>
    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🐄 SAPI (${livestock.cows.length})</h3>
    <div class="ls-list">${livestock.cows.length === 0 ? '<div style="color:#888; padding:8px;">Belum ada sapi. Beli di atas!</div>' : livestock.cows.map((c, i) => renderAnimalRow(c, i, 'Cow', '🐄')).join('')}</div>
    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🐑 DOMBA (${livestock.sheep.length})</h3>
    <div class="ls-list">${livestock.sheep.length === 0 ? '<div style="color:#888; padding:8px;">Belum ada domba. Beli di atas!</div>' : livestock.sheep.map((s, i) => renderAnimalRow(s, i, 'Sheep', '🐑')).join('')}</div>
    <button class="menu-close" id="barn-close">Tutup (Esc)</button>`;
  panel.innerHTML = html;
  document.getElementById('menu').classList.add('show');
  // Wire buy buttons
  panel.querySelectorAll('[data-action="buy-animal"]').forEach(el => {
    el.addEventListener('click', () => {
      const animal = el.dataset.animal;
      if (animal === 'cow') buyCow();
      else if (animal === 'sheep') buySheep();
      openBarn();   // refresh
    });
  });
  panel.querySelectorAll('[data-action="buy-supply"]').forEach(el => {
    el.addEventListener('click', () => {
      const supply = el.dataset.supply;
      if (supply === 'fodder') buyFodder(10);
      else if (supply === 'medicine') buyAnimalMedicine(1);
      openBarn();
    });
  });
  // Wire Maker button (opens the Maker processing panel)
  const makerBtn = panel.querySelector('[data-act="open-makers"]');
  if (makerBtn) makerBtn.addEventListener('click', () => { openMakers(); });
  // Wire animal action buttons
  panel.querySelectorAll('.ls-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      const act = btn.dataset.act;
      const idx = parseInt(btn.dataset.idx, 10);
      const kind = btn.dataset.kind;
      let arr = kind === 'cow' ? livestock.cows : (kind === 'sheep' ? livestock.sheep : livestock.chickens);
      const a = arr[idx];
      if (!a) return;
      if (act === 'feed') {
        if (feedAnimal(a)) toast(`🌾 ${a.name} diberi makan. (Fodder: ${barnState.fodder})`, 'info');
        else toast(`Fodder habis! Beli dulu.`, 'warn');
      } else if (act === 'brush') {
        if (brushAnimal(a)) toast(`🧹 ${a.name} disikat. (+1 affection)`, 'gold');
      } else if (act === 'talk') {
        if (talkAnimal(a)) toast(`💬 ${a.name} diajak bicara. (+1 affection)`, 'info');
      } else if (act === 'milk') {
        const r = milkCow(a);
        if (r) creditAnimalProduct(r, `Susu ${a.name}`);
        else toast(`Tidak bisa diperah (sudah/sakit/belum dewasa).`, 'warn');
      } else if (act === 'shear') {
        const r = shearSheep(a);
        if (r) creditAnimalProduct(r, `Wol ${a.name}`);
        else toast(`Tidak bisa digunting (sudah/sakit/belum dewasa).`, 'warn');
      } else if (act === 'stock') {
        // 📦 Stock: same as milk/shear but routes product to storage (fridge for milk, shelf for wool)
        // for later Maker processing. Consumes the same daily product slot (cow.milked / sheep.days_until_product).
        const r = (a.kind === 'cow') ? milkCow(a) : shearSheep(a);
        if (r) stockAnimalProduct(r);
        else toast(`Tidak bisa (sudah/sakit/belum dewasa).`, 'warn');
      } else if (act === 'cure') {
        if (cureAnimal(a)) toast(`💊 ${a.name} sembuh! (Obat: ${player.medicine})`, 'gold');
        else toast(`Obat habis! Beli dulu.`, 'warn');
      } else if (act === 'impreg') {
        if (impregnateAnimal(a)) toast(`🤰 ${a.name} mulai hamil. (Akan lahir 21-30 hari)`, 'gold');
      }
      updateHUD(); save();
      openBarn();   // refresh
    });
  });
  document.getElementById('barn-close').addEventListener('click', closeMenu);
}

// openCoop(): list chickens, buy chickens/feed, collect eggs, incubate eggs.
//   fomt interactions (Coop::Ent + Chicken): feed, collect egg, place egg in incubator.
function openCoop() {
  menuOpen = 'coop';
  const panel = document.getElementById('menu-panel');
  const capacity = getCoopCapacity();
  const used = countChickens();
  // Helper: render one chicken row
  function renderChickenRow(c, idx) {
    const hearts = animalHearts(c);
    const heartStr = '❤'.repeat(hearts) + '🤍'.repeat(10 - hearts);
    const stageName = c.growthStage === 0 ? 'Chick' : 'Adult';
    const stateParts = [];
    if (c.fed) stateParts.push('✓Fed');
    if (c.sick) stateParts.push('🤒Sick');
    else if (c.unhappy) stateParts.push('😢Unhappy');
    if (c.hasEgg) stateParts.push('🥚Egg!');
    const stateStr = stateParts.length ? stateParts.join(' · ') : '—';
    const btns = [];
    btns.push(`<button class="ls-btn" data-act="feed" data-idx="${idx}" ${c.fed ? 'disabled' : ''}>Feed</button>`);
    if (c.hasEgg) {
      btns.push(`<button class="ls-btn" data-act="egg" data-idx="${idx}">🥚Collect</button>`);
      btns.push(`<button class="ls-btn" data-act="stock" data-idx="${idx}">📦Stock</button>`);
    }
    if (c.sick) btns.push(`<button class="ls-btn" data-act="cure" data-idx="${idx}">💊Cure</button>`);
    return `<div class="ls-animal">
      <div class="ls-animal-info">
        <span class="ls-emoji">🐔</span>
        <span class="ls-name">${c.name}</span>
        <span class="ls-stage">(${stageName}, age ${c.age})</span>
        <span class="ls-hearts">${heartStr}</span>
        <span class="ls-state">${stateStr}</span>
      </div>
      <div class="ls-actions">${btns.join('')}</div>
    </div>`;
  }
  // Incubator status
  const inc0 = coopState.incubator[0];
  const inc1 = coopState.incubator[1];
  const incStr = (i) => i.occupied ? `🥚 ${i.daysLeft} hari lagi` : 'Kosong';
  let html = `<h2>🐔 Kandang Ayam (Coop) — Harvest Vale</h2>
    <div class="subtitle">Kapasitas: ${used}/${capacity} · Pakan: ${coopState.feed} · Emasmu: <strong style="color:#ffd54a">${player.gold}g</strong></div>
    <div style="margin:8px 0;">
      <button class="ls-btn" data-act="open-makers" style="font-size:13px; padding:6px 12px;">🏭 Maker ${makers.mayonnaise || makers.cheese || makers.yarn ? '(' + (makers.mayonnaise?'M':'') + (makers.cheese?'C':'') + (makers.yarn?'Y':'') + ')' : '(belum punya)'}</button>
    </div>
    <h3 style="color:#88e06a; font-size:13px; margin:10px 0 6px;">📥 BELI AYAM & PAKAN</h3>
    <div class="menu-grid">
      <div class="menu-item" data-action="buy-animal" data-animal="chicken" style="cursor:pointer">
        <div class="emoji">🐔</div>
        <div class="info"><div class="name">Beli Ayam (Chicken)</div><div class="meta" style="color:#a0b090;">Dewasa · Bertelur harian</div></div>
        <div class="price buy">${CHICKEN_BUY_PRICE}g</div>
      </div>
      <div class="menu-item" data-action="buy-supply" data-supply="feed" style="cursor:pointer">
        <div class="emoji">🌾</div>
        <div class="info"><div class="name">Beli Pakan Ayam x10</div><div class="meta" style="color:#a0b090;">Pakan ayam</div></div>
        <div class="price buy">${CHICKEN_FEED_BUY_PRICE * 10}g</div>
      </div>
    </div>
    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🥚 INKUBATOR</h3>
    <div class="ls-list">
      <div class="ls-animal">
        <div class="ls-animal-info"><span class="ls-emoji">1️⃣</span><span class="ls-state">${incStr(inc0)}</span></div>
        <div class="ls-actions">${inc0.occupied ? '' : '<button class="ls-btn" data-act="incubate" data-idx="0">🥚Taruh Telur</button>'}</div>
      </div>
      <div class="ls-animal">
        <div class="ls-animal-info"><span class="ls-emoji">2️⃣</span><span class="ls-state">${incStr(inc1)}</span></div>
        <div class="ls-actions">${inc1.occupied ? '' : '<button class="ls-btn" data-act="incubate" data-idx="1">🥚Taruh Telur</button>'}</div>
      </div>
    </div>
    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🐔 AYAM (${livestock.chickens.length})</h3>
    <div class="ls-list">${livestock.chickens.length === 0 ? '<div style="color:#888; padding:8px;">Belum ada ayam. Beli di atas!</div>' : livestock.chickens.map((c, i) => renderChickenRow(c, i)).join('')}</div>
    <button class="menu-close" id="coop-close">Tutup (Esc)</button>`;
  panel.innerHTML = html;
  document.getElementById('menu').classList.add('show');
  // Wire buy buttons
  panel.querySelectorAll('[data-action="buy-animal"]').forEach(el => {
    el.addEventListener('click', () => {
      if (el.dataset.animal === 'chicken') buyChicken();
      openCoop();
    });
  });
  panel.querySelectorAll('[data-action="buy-supply"]').forEach(el => {
    el.addEventListener('click', () => {
      if (el.dataset.supply === 'feed') buyChickenFeed(10);
      openCoop();
    });
  });
  // Wire Maker button (opens the Maker processing panel)
  const makerBtn = panel.querySelector('[data-act="open-makers"]');
  if (makerBtn) makerBtn.addEventListener('click', () => { openMakers(); });
  // Wire action buttons
  panel.querySelectorAll('.ls-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      const act = btn.dataset.act;
      const idx = parseInt(btn.dataset.idx, 10);
      if (act === 'incubate') {
        startIncubation(idx);
      } else {
        const c = livestock.chickens[idx];
        if (!c) return;
        if (act === 'feed') {
          if (feedAnimal(c)) toast(`🌾 ${c.name} diberi makan. (Pakan: ${coopState.feed})`, 'info');
          else toast(`Pakan habis! Beli dulu.`, 'warn');
        } else if (act === 'egg') {
          const r = collectEgg(c);
          if (r) creditAnimalProduct(r, `Telur ${c.name}`);
          else toast(`Tidak ada telur untuk dikumpulkan.`, 'warn');
        } else if (act === 'stock') {
          // 📦 Stock: same as collect egg but routes to fridge (food) for Maker processing.
          const r = collectEgg(c);
          if (r) stockAnimalProduct(r);
          else toast(`Tidak ada telur untuk distock.`, 'warn');
        } else if (act === 'cure') {
          if (cureAnimal(c)) toast(`💊 ${c.name} sembuh! (Obat: ${player.medicine})`, 'gold');
          else toast(`Obat habis! Beli dulu.`, 'warn');
        }
      }
      updateHUD(); save();
      openCoop();
    });
  });
  document.getElementById('coop-close').addEventListener('click', closeMenu);
}

// ===== fomt Harvest Sprite Hut UI (harvest_sprite.hh + harvest_sprite.cc) =====
// openSpriteHut(): the 3-sprite team management panel — friendship hearts, task_exp per
// category, minigame_exp per category, current_task + work_days_left. Each sprite has:
//   - "Play Minigame" button (×3 tasks, if not played today) → hsPlayMinigame (random succeed/fail)
//   - "Hire for Harvest (3 days)" / "Hire for Water (3 days)" / "Hire for Animals (3 days)"
//     buttons → hsStartTask (sets current_task + work_days_left=3)
function openSpriteHut() {
  menuOpen = 'sprites';
  const panel = document.getElementById('menu-panel');
  const TASK_LABELS = ['🌾 Panen', '💧 Siram', '🐄 Hewan'];
  // Helper: render one sprite row
  function renderSpriteRow(sprite, idx) {
    const hearts = hsHearts(sprite);
    const heartStr = '❤'.repeat(hearts) + '🤍'.repeat(10 - hearts);
    const metStr = sprite.met ? '' : ' (belum kenal)';
    const taskStr = sprite.work_days_left > 0
      ? `Bekerja: ${hsTaskLabel(sprite.current_task)} · sisa ${sprite.work_days_left} hari`
      : 'Tidak bekerja';
    const expRows = [0, 1, 2].map(t => {
      const te = sprite.task_exp[t] || 0;
      const me = sprite.minigame_exp[t] || 0;
      return `<div style="font-size:11px; color:#a0b090;">
        <span style="display:inline-block; min-width:90px;">${TASK_LABELS[t]}</span>
        <span style="color:#88e06a;">task_exp ${te}/255</span>
        · <span style="color:#c0a0e0;">mini ${me}/31</span>
      </div>`;
    }).join('');
    const minigameBtns = sprite.played_minigame
      ? '<span style="font-size:11px; color:#888;">✓ sudah main hari ini</span>'
      : [0, 1, 2].map(t =>
          `<button class="ls-btn" data-act="hs-play" data-sidx="${idx}" data-task="${t}">🎮 ${TASK_LABELS[t]}</button>`
        ).join('');
    const hireBtns = sprite.work_days_left > 0
      ? '<span style="font-size:11px; color:#888;">(sedang bekerja — tidak bisa menyewa lagi)</span>'
      : [0, 1, 2].map(t =>
          `<button class="ls-btn" data-act="hs-hire" data-sidx="${idx}" data-task="${t}">📝 Sewa ${TASK_LABELS[t]} (3 hari)</button>`
        ).join('');
    return `<div class="ls-animal" style="display:block;">
      <div class="ls-animal-info">
        <span class="ls-emoji">🧚</span>
        <span class="ls-name">${sprite.name}${metStr}</span>
        <span class="ls-hearts">${heartStr}</span>
        <span class="ls-state">${taskStr}</span>
      </div>
      <div style="padding:4px 8px;">${expRows}</div>
      <div class="ls-actions" style="margin:4px 0;">
        <span style="font-size:11px; color:#c0a0e0;">🎮 Mini-game:</span> ${minigameBtns}
      </div>
      <div class="ls-actions" style="margin:4px 0;">
        <span style="font-size:11px; color:#88e06a;">📝 Sewa:</span> ${hireBtns}
      </div>
    </div>`;
  }
  let html = `<h2>🧚 Pondok Harvest Sprite — Harvest Vale</h2>
    <div class="subtitle">3 Sprite: Chef, Timid, Staid · Tiap hari kerja: -2 friendship · Mini-game: +1 friendship · Emasmu: <strong style="color:#ffd54a">${player.gold}g</strong></div>
    <h3 style="color:#88e06a; font-size:13px; margin:10px 0 6px;">🧚 TIM SPRITE</h3>
    <div class="ls-list">${harvestSprites.map((s, i) => renderSpriteRow(s, i)).join('')}</div>
    <div style="margin:10px 0; padding:8px; background:rgba(80,40,120,0.3); border-radius:6px; font-size:11px; color:#c0a0e0;">
      <strong>fomt harvest_sprite.cc:</strong> Tier thresholds for task_exp delta (6/11/17 → +1/+2/+3/+4).
      Mini-game exp cap 31. Task_exp cap 255. Work_days cap 7. Hire for 3 hari: work_days_left=3, -2 friendship tiap hari kerja.
    </div>
    <button class="menu-close" id="sprites-close">Tutup (Esc)</button>`;
  panel.innerHTML = html;
  document.getElementById('menu').classList.add('show');
  // Wire minigame buttons
  panel.querySelectorAll('[data-act="hs-play"]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      const sidx = parseInt(btn.dataset.sidx, 10);
      const task = parseInt(btn.dataset.task, 10);
      hsPlayMinigame(sidx, task);
    });
  });
  // Wire hire buttons
  panel.querySelectorAll('[data-act="hs-hire"]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      const sidx = parseInt(btn.dataset.sidx, 10);
      const task = parseInt(btn.dataset.task, 10);
      const sprite = harvestSprites[sidx];
      if (!sprite) return;
      if (sprite.work_days_left > 0) {
        toast(`${sprite.name} sedang bekerja. Tunggu sampai selesai.`, 'warn');
        return;
      }
      if (sprite.met === false) sprite.met = true;   // first interaction sets met=true
      sprite.spoken_today = true;   // counts as interaction (prevents early-game friendship decay)
      hsStartTask(sprite, task, 3);   // hire for 3 days
      toast(`📝 ${sprite.name} disewa untuk ${hsTaskLabel(task)} selama 3 hari.`, 'gold');
      AudioManager.playPickup();
      updateHUD(); save();
      openSpriteHut();   // refresh
    });
  });
  document.getElementById('sprites-close').addEventListener('click', closeMenu);
}

// ===== Carpenter Shop — fomt carpenter "Gotz" (farm_house.hh FarmHouse upgrade gating) =====
// openCarpenter(): purchase house upgrades + furniture + kitchen tools + makers + vase flowers.
// Mirrors openBlacksmith/openBarn panel style. 4 sections:
//   1. Upgrade House (level 0→1: 3000g, 1→2: 10000g)
//   2. Buy Furniture (fridge/shelf/kitchen/bathroom/largeBed/carpet/recordPlayer/vase/mirror/clock)
//   3. Kitchen Tools (knife/fryingPan/pot/mixer/whisk/rollingPin/oven/seasoningSet — requires kitchen)
//   4. Makers (Mayonnaise 20000g / Cheese 30000g / Yarn 20000g)
//   5. Vase (place flower / remove flower / view current)
function openCarpenter() {
  menuOpen = 'carpenter';
  const panel = document.getElementById('menu-panel');
  // ===== Section 1: Upgrade House =====
  const upgradeLevel = farmHouse.upgradeLevel;
  const isMaxUpgrade = upgradeLevel >= 2;
  const upgradeCost = upgradeLevel === 0 ? CARPENTER_PRICES.houseUpgrade1
                    : upgradeLevel === 1 ? CARPENTER_PRICES.houseUpgrade2 : 0;
  const upgradeLabel = upgradeLevel === 0 ? 'Upgrade Level 1 (3000g)'
                     : upgradeLevel === 1 ? 'Upgrade Level 2 (10000g)' : 'MAX';
  const upgradeDisabled = isMaxUpgrade || player.gold < upgradeCost;
  // ===== Section 2: Furniture items =====
  // Each: { kind, label, cost, gate (bool), owned }
  const furnitureItems = [
    { kind: 'fridge',       label: 'Kulkas (Fridge)',         cost: CARPENTER_PRICES.fridge,       gate: upgradeLevel !== 0, owned: farmHouse.hasFridge },
    { kind: 'shelf',        label: 'Rak (Shelf)',              cost: CARPENTER_PRICES.shelf,        gate: upgradeLevel !== 0, owned: farmHouse.hasShelf },
    { kind: 'carpet',       label: 'Karpet (Carpet)',          cost: CARPENTER_PRICES.carpet,       gate: upgradeLevel !== 0, owned: farmHouse.hasCarpet },
    { kind: 'kitchen',      label: 'Dapur (Kitchen)',          cost: CARPENTER_PRICES.kitchen,      gate: upgradeLevel !== 0 && farmHouse.hasFridge, owned: farmHouse.hasKitchen },
    { kind: 'bathroom',     label: 'Kamar Mandi (Bathroom)',   cost: CARPENTER_PRICES.bathroom,     gate: upgradeLevel === 2,  owned: farmHouse.hasBathroom },
    { kind: 'largeBed',     label: 'Kasur Besar (Large Bed)', cost: CARPENTER_PRICES.largeBed,     gate: upgradeLevel > 1,   owned: farmHouse.hasLargeBed },
    { kind: 'recordPlayer', label: 'Pemutar Rekaman',         cost: CARPENTER_PRICES.recordPlayer, gate: true,              owned: farmHouse.hasRecordPlayer },
    { kind: 'vase',         label: 'Vas Bunga (Vase)',         cost: CARPENTER_PRICES.vase,         gate: true,              owned: farmHouse.hasVase },
    { kind: 'mirror',       label: 'Cermin (Mirror)',         cost: CARPENTER_PRICES.mirror,       gate: true,              owned: farmHouse.hasMirror },
    { kind: 'clock',        label: 'Jam (Clock)',              cost: CARPENTER_PRICES.clock,        gate: true,              owned: farmHouse.hasClock },
  ];
  // ===== Section 3: Kitchen Tools =====
  const kitchenTools = [
    { key: 'knife',        label: 'Kitchen Knife'  },
    { key: 'fryingPan',    label: 'Frying Pan'     },
    { key: 'pot',           label: 'Pot'             },
    { key: 'mixer',         label: 'Mixer'          },
    { key: 'whisk',         label: 'Whisk'          },
    { key: 'rollingPin',    label: 'Rolling Pin'   },
    { key: 'oven',          label: 'Oven'           },
    { key: 'seasoningSet', label: 'Seasoning Set' },
  ];
  const kitchenToolOwned = {
    knife: farmHouse.hasKitchenKnife, fryingPan: farmHouse.hasKitchenFryingPan,
    pot: farmHouse.hasKitchenPot, mixer: farmHouse.hasKitchenMixer,
    whisk: farmHouse.hasKitchenWhisk, rollingPin: farmHouse.hasKitchenRollingPin,
    oven: farmHouse.hasKitchenOven, seasoningSet: farmHouse.hasKitchenSeasoningSet,
  };
  // ===== Section 4: Makers =====
  const makerItems = [
    { kind: 'mayonnaise', label: 'Mayonnaise Maker', cost: MAKER_BUY_PRICES.mayonnaise, owned: makers.mayonnaise },
    { kind: 'cheese',     label: 'Cheese Maker',     cost: MAKER_BUY_PRICES.cheese,     owned: makers.cheese },
    { kind: 'yarn',       label: 'Yarn Maker',       cost: MAKER_BUY_PRICES.yarn,       owned: makers.yarn },
  ];

  // ===== Section 5: Vase Flower =====
  let vaseSection = '';
  if (farmHouse.hasVase) {
    if (farmHouse.vaseArticleId !== null) {
      const info = VASE_FLOWER_INFO[farmHouse.vaseArticleId];
      vaseSection = `<div class="ls-animal">
        <div class="ls-animal-info">
          <span class="ls-emoji">🌷</span>
          <span class="ls-name">${info ? info.name : 'Bunga'}</span>
          <span class="ls-state">Umur: ${farmHouse.vaseArticleLifespan} hari · Musim: ${info ? info.season : '?'}</span>
        </div>
        <div class="ls-actions"><button class="ls-btn" data-act="vase-remove">🌸 Buang</button></div>
      </div>`;
    } else {
      // Show flower placement options (buy for 200g each — proxy for fomt foraging)
      const flowerBtns = Object.keys(VASE_FLOWER_INFO).map(id => {
        const aid = parseInt(id, 10);
        const info = VASE_FLOWER_INFO[aid];
        return `<button class="ls-btn" data-act="vase-place" data-aid="${aid}">🌷${info.name.split(' ')[0]} (${VASE_FLOWER_BUY_PRICE}g)</button>`;
      }).join('');
      vaseSection = `<div class="ls-animal">
        <div class="ls-animal-info">
          <span class="ls-emoji">🏺</span>
          <span class="ls-name">Vas Kosong</span>
          <span class="ls-state">Letakkan bunga (200g)</span>
        </div>
        <div class="ls-actions">${flowerBtns}</div>
      </div>`;
    }
  } else {
    vaseSection = '<div style="color:#888; padding:8px;">Beli Vas dulu di Section 2.</div>';
  }

  // ===== Section 6: Record Player Albums =====
  // fomt RecordPlayer (furniture.hh:75) holds one album at a time. Carpenter sells 15
  // albums (ARTICLE_ALBUM_1..15, ids 0x40..0x4E) at CARPENTER_PRICES.album each.
  // Albums are stored in the shelf. Insert/eject is done via the in-house Record Player
  // panel (openRecordPlayer — accessed by walking to the furniture tile inside the house).
  let albumSection = '';
  if (farmHouse.hasRecordPlayer) {
    const albumRows = [];
    for (let i = 0; i < RECORD_PLAYER_ALBUM_COUNT; i++) {
      const aid = RECORD_PLAYER_ALBUM_ARTICLE_BASE + i;
      const owned = storageGetAmount(shelf, aid) > 0;
      const disabled = owned || player.gold < CARPENTER_PRICES.album;
      albumRows.push(`<div class="menu-item${disabled ? ' disabled' : ''}" data-action="buy-album" data-aid="${aid}" style="cursor:pointer">
        <div class="emoji">💿</div>
        <div class="info"><div class="name">Album ${i + 1}${owned ? ' ✓' : ''}</div>
        <div class="meta" style="color:#a0b090;">${RECORD_PLAYER_SONG_NAMES[i]} · Song ${RECORD_PLAYER_SONG_IDS[i]}</div></div>
        <div class="price buy">${owned ? '✓' : CARPENTER_PRICES.album + 'g'}</div>
      </div>`);
    }
    albumSection = `<h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🎵 ALBUM REKAMAN (${RECORD_PLAYER_ALBUM_COUNT})</h3>
      <div class="menu-grid">${albumRows.join('')}</div>`;
  } else {
    albumSection = '<div style="color:#888; padding:8px;">Beli Pemutar Rekaman di Section 2 untuk membeli album.</div>';
  }

  // ===== Section 7: Blue Feather (marriage proposal item) =====
  // fomt BLUE_FEATHER (article id 0x4B). Sold by Carpenter once a bachelorette reaches
  // orange heart (~30000 love). Player can buy only ONE.
  const anyOrangeHeart = npcs.some(n => n.isBachelorette && (n.love || 0) >= 30000);
  const blueFeatherUnlocked = anyOrangeHeart && !player.blueFeather;
  const blueFeatherSection = `<h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🪶 BLUE FEATHER (Lamaran)</h3>
    <div class="menu-grid">
      <div class="menu-item${player.blueFeather || !anyOrangeHeart || player.gold < CARPENTER_PRICES.blueFeather ? ' disabled' : ''}" data-action="buy-bluefeather" style="cursor:pointer">
        <div class="emoji">🪶</div>
        <div class="info"><div class="name">Blue Feather${player.blueFeather ? ' ✓' : ''}</div>
        <div class="meta" style="color:#a0b090;">${player.blueFeather ? 'Sudah dimiliki' : (anyOrangeHeart ? 'Untuk melamar bachelorette (love 9+)' : 'Bachelorette belum 5 hati')}</div></div>
        <div class="price buy">${player.blueFeather ? '✓' : (anyOrangeHeart ? CARPENTER_PRICES.blueFeather + 'g' : 'Terkunci')}</div>
      </div>
    </div>`;

  // ===== Render full panel =====
  let html = `<h2>🔨 Tukang Kayu (Carpenter) — Harvest Vale</h2>
    <div class="subtitle">Level Rumah: <strong style="color:#88e06a">${upgradeLevel}/2</strong> · Emasmu: <strong style="color:#ffd54a">${player.gold}g</strong></div>

    <h3 style="color:#88e06a; font-size:13px; margin:10px 0 6px;">🏠 UPGRADE RUMAH</h3>
    <div class="menu-grid">
      <div class="menu-item${upgradeDisabled ? ' disabled' : ''}" data-action="buy-upgrade" style="cursor:pointer">
        <div class="emoji">🏠</div>
        <div class="info"><div class="name">${upgradeLabel}</div>
        <div class="meta" style="color:#a0b090;">Buka furniture dapur + kamar mandi</div></div>
        <div class="price buy">${isMaxUpgrade ? 'MAX' : upgradeCost + 'g'}</div>
      </div>
    </div>

    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🪑 FURNITURE</h3>
    <div class="menu-grid">`;
  for (const item of furnitureItems) {
    const disabled = item.owned || !item.gate || player.gold < item.cost;
    const reqStr = item.gate ? '' : ' (perlu upgrade)';
    html += `<div class="menu-item${disabled ? ' disabled' : ''}" data-action="buy-furniture" data-kind="${item.kind}" style="cursor:pointer">
      <div class="emoji">🪑</div>
      <div class="info"><div class="name">${item.label}${item.owned ? ' ✓' : ''}</div>
      <div class="meta" style="color:#a0b090;">${reqStr || 'Furniture rumah'}</div></div>
      <div class="price buy">${item.owned ? '✓' : item.cost + 'g'}</div>
    </div>`;
  }
  html += `</div>
    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🍴 KITCHEN TOOLS ${farmHouse.hasKitchen ? '' : '(perlu Dapur)'}</h3>
    <div class="menu-grid">`;
  for (const tool of kitchenTools) {
    const owned = kitchenToolOwned[tool.key];
    const disabled = owned || !farmHouse.hasKitchen || player.gold < CARPENTER_PRICES.kitchenTool;
    html += `<div class="menu-item${disabled ? ' disabled' : ''}" data-action="buy-kitchentool" data-tool="${tool.key}" style="cursor:pointer">
      <div class="emoji">🍴</div>
      <div class="info"><div class="name">${tool.label}${owned ? ' ✓' : ''}</div>
      <div class="meta" style="color:#a0b090;">Untuk masak resep fomt</div></div>
      <div class="price buy">${owned ? '✓' : CARPENTER_PRICES.kitchenTool + 'g'}</div>
    </div>`;
  }
  html += `</div>
    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🏭 MAKERS</h3>
    <div class="menu-grid">`;
  for (const m of makerItems) {
    const disabled = m.owned || player.gold < m.cost;
    html += `<div class="menu-item${disabled ? ' disabled' : ''}" data-action="buy-maker" data-maker="${m.kind}" style="cursor:pointer">
      <div class="emoji">🏭</div>
      <div class="info"><div class="name">${m.label}${m.owned ? ' ✓' : ''}</div>
      <div class="meta" style="color:#a0b090;">Proses produk ternak jadi nilai lebih tinggi</div></div>
      <div class="price buy">${m.owned ? '✓' : m.cost + 'g'}</div>
    </div>`;
  }
  html += `</div>
    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🌷 VAS BUNGA</h3>
    <div class="ls-list">${vaseSection}</div>
    ${albumSection}
    ${blueFeatherSection}
    <button class="menu-close" id="carp-close">Tutup (Esc)</button>`;
  panel.innerHTML = html;
  document.getElementById('menu').classList.add('show');
  // Wire buy-upgrade
  const upgradeEl = panel.querySelector('[data-action="buy-upgrade"]');
  if (upgradeEl) upgradeEl.addEventListener('click', () => {
    if (upgradeEl.classList.contains('disabled')) return;
    if (buyHouseUpgrade()) openCarpenter();
  });
  // Wire buy-furniture
  panel.querySelectorAll('[data-action="buy-furniture"]').forEach(el => {
    el.addEventListener('click', () => {
      if (el.classList.contains('disabled')) return;
      if (buyFurniture(el.dataset.kind)) openCarpenter();
    });
  });
  // Wire buy-kitchentool
  panel.querySelectorAll('[data-action="buy-kitchentool"]').forEach(el => {
    el.addEventListener('click', () => {
      if (el.classList.contains('disabled')) return;
      if (buyKitchenTool(el.dataset.tool)) openCarpenter();
    });
  });
  // Wire buy-maker
  panel.querySelectorAll('[data-action="buy-maker"]').forEach(el => {
    el.addEventListener('click', () => {
      if (el.classList.contains('disabled')) return;
      if (buyMaker(el.dataset.maker)) openCarpenter();
    });
  });
  // Wire vase actions
  panel.querySelectorAll('[data-act="vase-place"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const aid = parseInt(btn.dataset.aid, 10);
      if (buyVaseFlower(aid)) openCarpenter();
    });
  });
  const removeBtn = panel.querySelector('[data-act="vase-remove"]');
  if (removeBtn) removeBtn.addEventListener('click', () => {
    if (fhRemoveVaseFlower()) openCarpenter();
  });
  // Wire buy-album (Section 6 — fomt RecordPlayer albums ARTICLE_ALBUM_1..15)
  panel.querySelectorAll('[data-action="buy-album"]').forEach(el => {
    el.addEventListener('click', () => {
      if (el.classList.contains('disabled')) return;
      const aid = parseInt(el.dataset.aid, 10);
      if (buyAlbum(aid)) openCarpenter();
    });
  });
  // Wire buy-bluefeather (Section 7 — fomt BLUE_FEATHER)
  const blueFeatherEl = panel.querySelector('[data-action="buy-bluefeather"]');
  if (blueFeatherEl) blueFeatherEl.addEventListener('click', () => {
    if (blueFeatherEl.classList.contains('disabled')) return;
    if (buyBlueFeather()) openCarpenter();
  });
  document.getElementById('carp-close').addEventListener('click', closeMenu);
}

// ===== fomt Record Player panel (record_player.cc + furniture.hh:75-86) =====
// openRecordPlayer(): interact with the in-house Record Player furniture. Allows the player
// to insert/eject albums (ARTICLE_ALBUM_1..15) and "play" the currently-inserted album
// (toast notification — full BGM swap is a future polish). Mirrors openCarpenter panel style.
function openRecordPlayer() {
  if (!farmHouse.hasRecordPlayer) {
    toast('Beli Pemutar Rekaman dulu di Carpenter!', 'warn');
    return;
  }
  menuOpen = 'record_player';
  const panel = document.getElementById('menu-panel');

  // Current album display
  const hasAlbum = rpHasAlbum();
  const songId = rpGetSongId();
  const songName = rpGetSongName();
  const currentAlbumIdx = farmHouse.recordPlayerAlbumId || 0;

  // Inventory of albums in shelf (fomt Shelf::GetAmount per article id 0x40..0x4E)
  const ownedAlbums = [];
  for (let i = 0; i < RECORD_PLAYER_ALBUM_COUNT; i++) {
    const aid = RECORD_PLAYER_ALBUM_ARTICLE_BASE + i;
    const count = storageGetAmount(shelf, aid);
    if (count > 0) ownedAlbums.push({ idx: i, articleId: aid, count });
  }

  // Build album grid (15 albums)
  const albumItems = [];
  for (let i = 0; i < RECORD_PLAYER_ALBUM_COUNT; i++) {
    const aid = RECORD_PLAYER_ALBUM_ARTICLE_BASE + i;
    const owned = storageGetAmount(shelf, aid) > 0;
    const inserted = hasAlbum && currentAlbumIdx === i;
    albumItems.push({
      idx: i, articleId: aid, name: RECORD_PLAYER_SONG_NAMES[i],
      songId: RECORD_PLAYER_SONG_IDS[i], owned, inserted,
    });
  }

  let html = `<h2>🎵 Pemutar Rekaman (Record Player) — Harvest Vale</h2>
    <div class="subtitle">Album sekarang: <strong style="color:#88e06a">${hasAlbum ? `Album ${currentAlbumIdx + 1} — ${songName}` : 'Kosong'}</strong> · Song ID: <strong style="color:#ffd54a">${songId}</strong></div>

    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🎶 ALBUM SAAT INI</h3>
    <div class="ls-list">
      <div class="ls-animal">
        <div class="ls-animal-info">
          <span class="ls-emoji">${hasAlbum ? '💿' : '⬛'}</span>
          <span class="ls-name">${hasAlbum ? `Album ${currentAlbumIdx + 1} — ${songName}` : 'Tidak ada album'}</span>
          <span class="ls-state">${hasAlbum ? `Song ID ${songId}` : 'Masukkan album di bawah'}</span>
        </div>
        <div class="ls-actions">
          ${hasAlbum ? '<button class="ls-btn" data-act="rp-remove">⏏️ Keluarkan Album</button>' : ''}
          ${hasAlbum ? '<button class="ls-btn" data-act="rp-play">▶️ Putar Lagu</button>' : ''}
        </div>
      </div>
    </div>

    <h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">💿 KOLEKSI ALBUM (${ownedAlbums.length}/${RECORD_PLAYER_ALBUM_COUNT})</h3>
    <div class="ls-list">`;
  if (albumItems.length === 0) {
    html += '<div style="color:#888; padding:8px;">Tidak ada album. Beli di Carpenter (1000g/album).</div>';
  } else {
    for (const a of albumItems) {
      const stateStr = a.inserted ? 'Sedang diputar' : (a.owned ? 'Di rak' : 'Belum dibeli');
      const btnLabel = a.inserted ? 'Sedang Diputar' : (a.owned ? 'Masukkan' : 'Beli di Carpenter');
      const disabled = a.inserted || !a.owned;
      html += `<div class="ls-animal">
        <div class="ls-animal-info">
          <span class="ls-emoji">${a.inserted ? '🎶' : (a.owned ? '💿' : '⬜')}</span>
          <span class="ls-name">Album ${a.idx + 1} — ${a.name}</span>
          <span class="ls-state">${stateStr} · Song ID ${a.songId}</span>
        </div>
        <div class="ls-actions">
          <button class="ls-btn" data-act="rp-insert" data-aid="${a.articleId}" ${disabled ? 'disabled' : ''}>${btnLabel}</button>
        </div>
      </div>`;
    }
  }
  html += `</div>
    <button class="menu-close" id="rp-close">Tutup (Esc)</button>`;
  panel.innerHTML = html;
  document.getElementById('menu').classList.add('show');

  // Wire play/remove/insert actions
  const playBtn = panel.querySelector('[data-act="rp-play"]');
  if (playBtn) playBtn.addEventListener('click', () => {
    const id = rpGetSongId();
    const name = rpGetSongName();
    toast(`🎶 Memutar: ${name} (Song ID ${id})`, 'gold');
    AudioManager.playPickup();
    // fomt would call AudioManager.playBGM(trackId) — we don't have per-song files
    // so this is a notification-only "play" for now. Future polish: swap BGM track.
    openRecordPlayer();
  });
  const removeBtn = panel.querySelector('[data-act="rp-remove"]');
  if (removeBtn) removeBtn.addEventListener('click', () => {
    const oldAid = rpRemoveAlbum();
    if (oldAid != null) {
      storageAdd(shelf, 'article', oldAid, 1);   // return old album to shelf
      const oldIdx = oldAid - RECORD_PLAYER_ALBUM_ARTICLE_BASE;
      toast(`⏏️ Album ${oldIdx + 1} dikeluarkan.`, 'info');
      AudioManager.playPickup();
      save();
    }
    openRecordPlayer();
  });
  panel.querySelectorAll('[data-act="rp-insert"]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      const aid = parseInt(btn.dataset.aid, 10);
      // Remove from shelf first (player must own it)
      const removed = storageRemoveAmount(shelf, aid, 1);
      if (removed < 1) { toast('Tidak punya album itu di rak.', 'warn'); return; }
      // SetAlbum returns OLD album article id (or null if first insertion)
      const oldAid = rpSetAlbum(aid);
      if (oldAid != null) {
        storageAdd(shelf, 'article', oldAid, 1);   // return old album to shelf
        const oldIdx = oldAid - RECORD_PLAYER_ALBUM_ARTICLE_BASE;
        const newIdx = aid - RECORD_PLAYER_ALBUM_ARTICLE_BASE;
        toast(`🔄 Album ditukar: Album ${oldIdx + 1} → Album ${newIdx + 1}.`, 'gold');
      } else {
        const newIdx = aid - RECORD_PLAYER_ALBUM_ARTICLE_BASE;
        toast(`▶️ Album ${newIdx + 1} diputar.`, 'gold');
      }
      AudioManager.playPickup();
      updateHUD(); save();
      openRecordPlayer();
    });
  });
  document.getElementById('rp-close').addEventListener('click', closeMenu);
}

// ===== Maker Processing Panel — accessible from Barn menu =====
// openMakers(): shows owned makers + lets player process eggs/milk/wool into higher-value
// products. Reads inputs from fridge (eggs/milk food) and shelf (wool articles), ships
// the output via fomt ShippingBin (auto-credits gold + stats).
function openMakers() {
  menuOpen = 'makers';
  const panel = document.getElementById('menu-panel');
  // Build sections for each owned maker
  let html = `<h2>🏭 Maker — Proses Produk Ternak</h2>
    <div class="subtitle">Emasmu: <strong style="color:#ffd54a">${player.gold}g</strong> · Stok: Telur/Susu di kulkas, Wol di rak</div>`;
  // Helper: build rows for each rank showing stock + process button
  function rankRows(getStock, processFn, makerLabel) {
    let rows = '';
    for (let r = 0; r < 6; r++) {
      const stock = getStock(r);
      const rankLabel = MAKER_RANK_LABELS[r];
      rows += `<div class="ls-animal">
        <div class="ls-animal-info">
          <span class="ls-emoji">${r === 0 ? '⬜' : r === 5 ? '⭐' : '▪️'}</span>
          <span class="ls-name">Rank ${rankLabel}</span>
          <span class="ls-state">Stok: ${stock}</span>
        </div>
        <div class="ls-actions"><button class="ls-btn" data-rank="${r}" ${stock === 0 ? 'disabled' : ''}>Proses</button></div>
      </div>`;
    }
    return rows;
  }
  // Mayonnaise maker section
  if (makers.mayonnaise) {
    html += `<h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🥚→🥚 Mayonnaise Maker</h3>
      <div class="ls-list">${rankRows(r => storageGetAmount(fridge, EGG_FOOD_IDS[r]), 'mayo', 'Mayo')}</div>`;
  }
  // Cheese maker section
  if (makers.cheese) {
    html += `<h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🥛→🧀 Cheese Maker</h3>
      <div class="ls-list">${rankRows(r => storageGetAmount(fridge, MILK_FOOD_IDS[r]), 'cheese', 'Cheese')}</div>`;
  }
  // Yarn maker section
  if (makers.yarn) {
    html += `<h3 style="color:#88e06a; font-size:13px; margin:14px 0 6px;">🧶→🧶 Yarn Maker</h3>
      <div class="ls-list">${rankRows(r => storageGetAmount(shelf, WOOL_ARTICLE_IDS[r]), 'yarn', 'Yarn')}</div>`;
  }
  if (!makers.mayonnaise && !makers.cheese && !makers.yarn) {
    html += '<div style="color:#888; padding:12px;">Belum punya Maker. Beli di Tukang Kayu (Carpenter).</div>';
  }
  html += `<button class="menu-close" id="maker-close">Tutup (Esc)</button>`;
  panel.innerHTML = html;
  document.getElementById('menu').classList.add('show');
  // Wire process buttons — figure out which maker section they belong to by index
  // (each maker section has 6 rank rows; we section them by data-maker attribute added below)
  // To keep wiring simple: we re-iterate rankRows and tag each button with data-maker
  // by re-walking the panel DOM in section order.
  const sections = [];
  if (makers.mayonnaise) sections.push('mayo');
  if (makers.cheese)    sections.push('cheese');
  if (makers.yarn)      sections.push('yarn');
  const allBtns = panel.querySelectorAll('.ls-btn[data-rank]');
  allBtns.forEach((btn, idx) => {
    const sectionIdx = Math.floor(idx / 6);
    const maker = sections[sectionIdx];
    const rank = parseInt(btn.dataset.rank, 10);
    btn.addEventListener('click', () => {
      if (btn.disabled) return;
      if (maker === 'mayo')   processMayo(rank);
      else if (maker === 'cheese') processCheese(rank);
      else if (maker === 'yarn')   processYarn(rank);
      openMakers();   // refresh
    });
  });
  document.getElementById('maker-close').addEventListener('click', closeMenu);
}

function closeMenu() {
  menuOpen = null;
  document.getElementById('menu').classList.remove('show');
}

// ---------- Particles ----------
function spawnParticles(x, y, color, count) {
  for (let i = 0; i < count; i++) {
    particles.push({
      x, y,
      vx: (Math.random() - 0.5) * 3,
      vy: -Math.random() * 3 - 1,
      life: 1,
      color,
      size: 2 + Math.random() * 3,
    });
  }
}
function updateParticles(dt) {
  for (const p of particles) {
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.15;
    p.life -= dt * 1.5;
  }
  particles = particles.filter(p => p.life > 0);
}

// ---------- Movement ----------
function updatePlayer(dt) {
  if (isMenuOpen || dialogActive || menuOpen) { player.moving = false; return; }
  let dx = 0, dy = 0;
  if (keys['w'] || keys['arrowup'] || mobileMove.up) dy -= 1;
  if (keys['s'] || keys['arrowdown'] || mobileMove.down) dy += 1;
  if (keys['a'] || keys['arrowleft'] || mobileMove.left) dx -= 1;
  if (keys['d'] || keys['arrowright'] || mobileMove.right) dx += 1;
  if (dx !== 0 && dy !== 0) { dx *= 0.707; dy *= 0.707; }

  if (dx !== 0 || dy !== 0) {
    if (Math.abs(dx) > Math.abs(dy)) player.dir = dx > 0 ? 'right' : 'left';
    else player.dir = dy > 0 ? 'down' : 'up';
    const speed = PLAYER_SPEED * (dt * 60);
    const newX = player.x + dx * speed;
    const newY = player.y + dy * speed;
    // Collision check (corners)
    const half = TILE * 0.35;
    const checkPoints = [
      [newX - half, newY - half],
      [newX + half, newY - half],
      [newX - half, newY + half],
      [newX + half, newY + half],
    ];
    let blocked = false;
    for (const [cx, cy] of checkPoints) {
      const tx = Math.floor(cx / TILE);
      const ty = Math.floor(cy / TILE);
      if (!isWalkable(tx, ty)) { blocked = true; break; }
    }
    if (!blocked) {
      player.x = newX;
      player.y = newY;
    }
    player.moving = true;
    player.walkTime += dt;
    player.walkFrame = Math.floor(player.walkTime * 8) % 4;
    AudioManager.playFootstep();
  } else {
    player.moving = false;
    player.walkFrame = 0;
  }

  // Clamp to map
  player.x = Math.max(TILE, Math.min((MAP_W-2) * TILE, player.x));
  player.y = Math.max(TILE, Math.min((MAP_H-2) * TILE, player.y));

  // ===== fomt Power Berry & Kappa Berry pickup detection =====
  // Player picks up berry when within ~1 tile of spot center
  const pickupRadius = TILE * 0.6;
  for (const spot of powerBerrySpots) {
    if (spot.taken) continue;
    const dx = player.x - spot.x, dy = player.y - spot.y;
    if (dx*dx + dy*dy < pickupRadius * pickupRadius) {
      spot.taken = true;
      if (acquirePowerBerry()) {
        toast(`🍓 Power Berry! +10 Max Stamina (${player.powerBerries}/10)`, 'gold');
        AudioManager.playPickup();
        spawnParticles(spot.x + TILE/2, spot.y + TILE/2, '#ff4466', 16);
        updateHUD();
        save();
      }
    }
  }
  if (!kappaBerrySpot.taken) {
    const dx = player.x - kappaBerrySpot.x, dy = player.y - kappaBerrySpot.y;
    if (dx*dx + dy*dy < pickupRadius * pickupRadius) {
      kappaBerrySpot.taken = true;
      if (acquireKappaBerry()) {
        toast(`🟢 Kappa Berry! Fatigue sekarang setengah lebih ringan.`, 'gold');
        AudioManager.playPickup();
        spawnParticles(kappaBerrySpot.x + TILE/2, kappaBerrySpot.y + TILE/2, '#3aff7a', 20);
        updateHUD();
        save();
      }
    }
  }
}

// ===== fomt NPC Schedule Movement (ScheduleInfo → Schedule → time_entries) =====
// updateNpcSchedule(npc, dt): drives NPCs to walk toward the schedule entry whose
// `hour` is the largest <= current game hour (fomt selects the active time_entry
// the same way: largest entry.time <= current time). Once at the target the NPC
// faces the entry's `dir` and idles. Frozen when paused/dialog/menu open (matches
// player.freeze behaviour). If !met, NPC stays at schedule[0] (home) — invisible
// to game time until first contact. After midnight (hour 0-5) the last entry wins
// (NPC stays asleep).
//
// Stuck detection: if the NPC has been moving toward a target for >STUCK_FRAMES
// frames without making >STUCK_MIN_PROGRESS px of progress, it enters DETOUR mode
// for DETOUR_FRAMES frames, walking perpendicular to the target axis. This lets
// the NPC route around small obstacles (bushes, fence corners, trees) without a
// full A* pathfinder. The schedule keeps re-evaluating the target each frame, so
// the NPC resumes the direct path once the detour is done.
const NPC_STUCK_FRAMES     = 30;   // 0.5s @ 60fps — if no progress in this many frames, detour
const NPC_STUCK_MIN_PROG  = 1.0;   // px of movement below which counts as "no progress"
const NPC_DETOUR_FRAMES    = 60;    // 1s @ 60fps of perpendicular movement before retry
function updateNpcSchedule(npc, dt) {
  // Defensive: skip NPCs without a schedule (e.g. legacy saves pre-schedule patch).
  if (!npc.schedule || npc.schedule.length === 0) return;

  // Freeze with the game: same gating as updatePlayer/updateTime.
  if (isPaused || dialogActive || menuOpen || isMenuOpen) {
    npc.moving = false;
    npc.walkFrame = 0;
    return;
  }

  // Pick the active schedule entry: largest hour <= current hour.
  // After midnight (hour 0-5), no entry satisfies hour<=currentHour except
  // schedule[0] (hour 6) — but we want NPC to STAY at the night entry, so we
  // default to the LAST entry when current hour < schedule[0].hour.
  const currentHour = Math.floor(timeOfDay / 60);
  let entry;
  if (currentHour < npc.schedule[0].hour) {
    // Pre-dawn (00:00–05:59): NPC remains at the last (sleeping) entry.
    entry = npc.schedule[npc.schedule.length - 1];
  } else {
    entry = npc.schedule[0];
    for (const s of npc.schedule) {
      if (s.hour <= currentHour) entry = s;
      else break;
    }
  }

  // fomt "met" gate: until the player has met the NPC, the NPC stays at home.
  if (!npc.met) {
    const home = npc.schedule[0];
    npc.scheduleTargetX = home.x;
    npc.scheduleTargetY = home.y;
    npc.scheduleTargetDir = home.dir;
  } else {
    npc.scheduleTargetX = entry.x;
    npc.scheduleTargetY = entry.y;
    npc.scheduleTargetDir = entry.dir;
  }

  // Walk toward target (Euclidean). dt is seconds; baseline 60fps → dt*60 ≈ 1.
  let dx = npc.scheduleTargetX - npc.x;
  let dy = npc.scheduleTargetY - npc.y;
  const dist = Math.sqrt(dx * dx + dy * dy);

  if (dist > 2) {
    // ===== Stuck-detection detour =====
    // Track position delta from last frame to detect "moving but not progressing".
    const lastX = npc._lastSchedX ?? npc.x;
    const lastY = npc._lastSchedY ?? npc.y;
    const moved = Math.hypot(npc.x - lastX, npc.y - lastY);
    npc._lastSchedX = npc.x;
    npc._lastSchedY = npc.y;
    if (moved < NPC_STUCK_MIN_PROG) {
      npc._stuckFrames = (npc._stuckFrames || 0) + 1;
    } else {
      npc._stuckFrames = 0;
    }
    // Enter detour mode if stuck too long; expire detour after DETOUR_FRAMES.
    if ((npc._stuckFrames || 0) > NPC_STUCK_FRAMES && !(npc._detourFrames > 0)) {
      npc._detourFrames = NPC_DETOUR_FRAMES;
      // Pick a perpendicular axis to slide along. Prefer the axis with the
      // smaller |delta| (i.e. the NPC's body is roughly aligned with the target
      // on the dominant axis, so the obstacle is likely on the minor axis).
      // Randomize sign so we don't always try the same side.
      const sign = Math.random() < 0.5 ? 1 : -1;
      if (Math.abs(dx) > Math.abs(dy)) {
        // Mostly moving on X — detour on Y.
        npc._detourDir = sign > 0 ? 'down' : 'up';
      } else {
        // Mostly moving on Y — detour on X.
        npc._detourDir = sign > 0 ? 'right' : 'left';
      }
    }
    // Apply detour: override (dx, dy) with a unit vector along the detour axis.
    if (npc._detourFrames > 0) {
      npc._detourFrames -= 1;
      if (npc._detourFrames === 0) npc._stuckFrames = 0;  // give the direct path a fresh chance
      // Build a synthetic target offset along the detour direction.
      const DETOUR_MAG = 4 * TILE;  // aim 4 tiles along detour axis
      if (npc._detourDir === 'left')  dx = -DETOUR_MAG;
      else if (npc._detourDir === 'right') dx =  DETOUR_MAG;
      else if (npc._detourDir === 'up')    dy = -DETOUR_MAG;
      else                                  dy =  DETOUR_MAG;
    }

    const detourDist = Math.sqrt(dx * dx + dy * dy) || 1;
    const speed = (npc.scheduleSpeed || 1.0) * (dt * 60);
    const stepX = (dx / detourDist) * speed;
    const stepY = (dy / detourDist) * speed;

    // Face the dominant axis of movement (matches player.dir logic).
    if (Math.abs(dx) > Math.abs(dy)) npc.dir = dx > 0 ? 'right' : 'left';
    else                              npc.dir = dy > 0 ? 'down'  : 'up';

    // Collision: try full move; if blocked, slide along X or Y; if both blocked, stop.
    const fullClear  = npcIsPositionClear(npc, npc.x + stepX, npc.y + stepY);
    const xClear     = npcIsPositionClear(npc, npc.x + stepX, npc.y);
    const yClear     = npcIsPositionClear(npc, npc.x,         npc.y + stepY);
    if (fullClear)              { npc.x += stepX; npc.y += stepY; }
    else if (xClear)            { npc.x += stepX; }
    else if (yClear)            { npc.y += stepY; }
    else {
      // Both axes blocked — end detour early so we can try the other side next frame.
      if (npc._detourFrames > 0) {
        npc._detourFrames = 0;
        npc._stuckFrames = 0;
      }
    }

    npc.moving = true;
    npc.walkTime += dt;
    npc.walkFrame = Math.floor(npc.walkTime * 8) % 4;
  } else {
    // Arrived — face the scheduled direction and idle.
    npc.dir = npc.scheduleTargetDir;
    npc.moving = false;
    npc.walkFrame = 0;
    npc.walkTime = 0;
    // Reset stuck/detour state on arrival.
    npc._stuckFrames = 0;
    npc._detourFrames = 0;
    npc._lastSchedX = null;
    npc._lastSchedY = null;
  }

  // Clamp to map bounds (same fence as player).
  npc.x = Math.max(TILE, Math.min((MAP_W - 2) * TILE, npc.x));
  npc.y = Math.max(TILE, Math.min((MAP_H - 2) * TILE, npc.y));
}

// npcIsPositionClear(self, x, y): true if a proposed NPC centre position (x, y)
// is walkable for that NPC — i.e. all four collision corners land on walkable
// tiles AND the new position doesn't overlap the player or another NPC.
// Mirrors updatePlayer's corner-based collision check, then adds soft-body
// avoidance vs. the player and other NPCs so NPCs never walk through them.
function npcIsPositionClear(self, x, y) {
  const half = TILE * 0.35;
  const corners = [
    [x - half, y - half],
    [x + half, y - half],
    [x - half, y + half],
    [x + half, y + half],
  ];
  for (const [cx, cy] of corners) {
    const tx = Math.floor(cx / TILE);
    const ty = Math.floor(cy / TILE);
    if (!isWalkable(tx, ty)) return false;
  }
  // Soft avoidance vs player and other NPCs (within 0.7 tile = ~22px).
  const minSep = TILE * 0.7;
  if (Math.hypot(player.x - x, player.y - y) < minSep) return false;
  for (const other of npcs) {
    if (other === self) continue;
    if (Math.hypot(other.x - x, other.y - y) < minSep) return false;
  }
  return true;
}

function updateNearbyAction() {
  nearbyAction = null;
  // ===== fomt Record Player furniture proximity (furniture.hh:75 — in-house furniture tile) =====
  // Player must own the record player (hasRecordPlayer=true). When near the interior tile
  // (RECORD_PLAYER_INTERIOR_TILE at (5, 23)), pressing E opens openRecordPlayer(). This
  // check runs BEFORE the sleep door so the player can interact with the record player
  // without being routed to trySleep. (Tile is well inside the house, ~3 tiles from the
  // door, so the sleep door proximity check (radius 2.2) doesn't fire here.)
  if (farmHouse.hasRecordPlayer) {
    const rpTx = RECORD_PLAYER_INTERIOR_TILE.tx;
    const rpTy = RECORD_PLAYER_INTERIOR_TILE.ty;
    const rpX = rpTx * TILE + TILE/2;
    const rpY = rpTy * TILE + TILE/2;
    if (Math.hypot(player.x - rpX, player.y - rpY) < TILE * 1.4) {
      nearbyAction = { type: 'record_player' };
    }
  }
  // Check shop door proximity
  const shopX = 30, shopY = 4, shopW = 7, shopH = 5;
  const shopDoorX = (shopX + Math.floor(shopW/2)) * TILE + TILE/2;
  const shopDoorY = (shopY + shopH - 1) * TILE + TILE/2;
  if (Math.hypot(player.x - shopDoorX, player.y - shopDoorY) < TILE * 2.2) {
    nearbyAction = { type: 'shop' };
  }
  // Blacksmith door proximity (top-center building — fomt farmer.cc:73-183 tool upgrade NPC)
  const blackX = 22, blackY = 4, blackW = 7, blackH = 5;
  const blackDoorX = (blackX + Math.floor(blackW/2)) * TILE + TILE/2;
  const blackDoorY = (blackY + blackH - 1) * TILE + TILE/2;
  if (Math.hypot(player.x - blackDoorX, player.y - blackDoorY) < TILE * 2.2) {
    nearbyAction = { type: 'blacksmith' };
  }
  // Barn door proximity (top-left building — fomt Barn struct houses cows + sheep)
  const barnX = 2, barnY = 4, barnW = 8, barnH = 6;
  const barnDoorX = (barnX + Math.floor(barnW/2)) * TILE + TILE/2;
  const barnDoorY = (barnY + barnH - 1) * TILE + TILE/2;
  if (Math.hypot(player.x - barnDoorX, player.y - barnDoorY) < TILE * 2.2) {
    nearbyAction = { type: 'barn' };
  }
  // Coop door proximity (top-center-left building — fomt Coop struct houses chickens + incubator)
  const coopX = 11, coopY = 4, coopW = 6, coopH = 5;
  const coopDoorX = (coopX + Math.floor(coopW/2)) * TILE + TILE/2;
  const coopDoorY = (coopY + coopH - 1) * TILE + TILE/2;
  if (Math.hypot(player.x - coopDoorX, player.y - coopDoorY) < TILE * 2.2) {
    nearbyAction = { type: 'coop' };
  }
  // House door proximity
  const houseX = 4, houseY = 22, houseW = 7, houseH = 5;
  const houseDoorX = (houseX + Math.floor(houseW/2)) * TILE + TILE/2;
  const houseDoorY = (houseY + houseH - 1) * TILE + TILE/2;
  if (Math.hypot(player.x - houseDoorX, player.y - houseDoorY) < TILE * 2.2) {
    nearbyAction = { type: 'sleep' };
  }
  // Carpenter door proximity (bottom-right building — fomt carpenter "Gotz" cottage)
  // Sells house upgrades + furniture + kitchen tools + makers + vase flowers.
  const carpX = 30, carpY = 22, carpW = 7, carpH = 5;
  const carpDoorX = (carpX + Math.floor(carpW/2)) * TILE + TILE/2;
  const carpDoorY = (carpY + carpH - 1) * TILE + TILE/2;
  if (Math.hypot(player.x - carpDoorX, player.y - carpDoorY) < TILE * 2.2) {
    nearbyAction = { type: 'carpenter' };
  }
  // ===== fomt Harvest Sprite hut proximity (harvest_sprite.hh) =====
  // 1-tile hut at (37, 4). Player approaches from the south (y >= 5) and presses E to
  // open openSpriteHut() — the 3-sprite team management panel (hire/play minigame).
  const spriteHutX = 37, spriteHutY = 4;
  const hutCenterX = spriteHutX * TILE + TILE/2;
  const hutCenterY = spriteHutY * TILE + TILE/2;
  if (Math.hypot(player.x - hutCenterX, player.y - hutCenterY) < TILE * 2.0) {
    nearbyAction = { type: 'sprites' };
  }
  // NPC proximity
  for (const n of npcs) {
    if (Math.hypot(player.x - (n.x + TILE/2), player.y - (n.y + TILE/2)) < TILE * 1.8) {
      nearbyAction = { type: 'npc', id: n.id };
      break;
    }
  }
}

// ---------- Time ----------
function updateTime(dt) {
  if (dialogActive || menuOpen) return;
  // 4 real minutes = 18 game hours (06:00 -> 00:00) -> 1 hour per ~13.3s
  timeOfDay += dt * (18 * 60 / (DAY_LENGTH_MS / 1000)); // minutes per second
  if (timeOfDay >= 24 * 60) {
    // Force sleep / next day
    timeOfDay = 6 * 60;
    advanceDay();
  }
}

// ---------- Rendering ----------
function resizeCanvas() {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width = Math.floor(window.innerWidth * dpr);
  canvas.height = Math.floor(window.innerHeight * dpr);
  canvas.style.width = window.innerWidth + 'px';
  canvas.style.height = window.innerHeight + 'px';
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.imageSmoothingEnabled = false;
}
window.addEventListener('resize', resizeCanvas);

function drawTile(tile, x, y) {
  const px = x * TILE - camera.x;
  const py = y * TILE - camera.y;
  if (px < -TILE || py < -TILE || px > canvas.clientWidth + TILE || py > canvas.clientHeight + TILE) return;

  // Terrain is textured from the included world atlas, not a flat rectangle.
  switch (tile) {
    case T.GRASS:
      drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
      break;
    case T.GRASS2:
      drawAssetTileOrFallback('grassAlt', px, py, '#346024', '#b7df83');
      break;
    case T.FLOWER: {
      drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
      const flower = getAsset('Elements/Plants/spr_deco_mushroom_red_01_strip4.png');
      if (flower && flower.naturalWidth) {
        const fw = flower.naturalWidth / 4;
        ctx.drawImage(flower, 0, 0, fw, flower.naturalHeight, px + 6, py + 7, 20, 24);
      } else {
        ctx.fillStyle = '#ff8ad4'; ctx.fillRect(px + 12, py + 12, 8, 8);
        ctx.fillStyle = '#ffe04a'; ctx.fillRect(px + 14, py + 14, 4, 4);
      }
      break;
    }
    case T.TILLED: {
      drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
      const soil = getAsset('Elements/Crops/soil_00.png');
      if (soil) ctx.drawImage(soil, 0, 0, soil.naturalWidth, soil.naturalHeight, px, py + 5, TILE, TILE - 5);
      else {
        ctx.fillStyle = '#6a4a2a'; ctx.fillRect(px, py + 5, TILE, TILE - 5);
        ctx.fillStyle = '#5a3a1a'; ctx.fillRect(px, py + 5, TILE, 2);
        ctx.fillRect(px, py + 16, TILE, 2); ctx.fillRect(px, py + 27, TILE, 2);
      }
      break;
    }
    case T.WATERED: {
      drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
      const wet = getAsset('Elements/Crops/soil_04.png');
      if (wet) ctx.drawImage(wet, 0, 0, wet.naturalWidth, wet.naturalHeight, px, py + 5, TILE, TILE - 5);
      else { ctx.fillStyle = '#3a2a14'; ctx.fillRect(px, py + 5, TILE, TILE - 5); }
      break;
    }
    case T.WATER:
      if (!drawAtlasTile('water', px, py)) {
        ctx.fillStyle = '#2a5a9a'; ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#3a6aba';
        ctx.fillRect(px + 2, py + 6, 8, 3); ctx.fillRect(px + 18, py + 14, 8, 3); ctx.fillRect(px + 6, py + 22, 8, 3);
      }
      break;
    case T.SAND:
      if (!drawAtlasTile('sand', px, py)) {
        ctx.fillStyle = '#d4c08a'; ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#c4b07a'; ctx.fillRect(px + 6, py + 8, 2, 2); ctx.fillRect(px + 20, py + 18, 2, 2);
      }
      break;
    case T.PATH:
      if (!drawAtlasTile('dirt', px, py, '#d6bb8b')) {
        ctx.fillStyle = '#8a7a5a'; ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#7a6a4a'; ctx.fillRect(px, py + TILE - 4, TILE, 4);
      }
      break;
    case T.FLOOR:
      if (!drawAtlasTile('woodFloor', px, py)) {
        ctx.fillStyle = '#5a3a2a'; ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#4a2a1a'; ctx.fillRect(px, py, TILE, 2); ctx.fillRect(px, py + TILE - 2, TILE, 2);
      }
      break;
    case T.WALL:
      if (!drawAtlasTile('woodWall', px, py)) {
        ctx.fillStyle = '#6a3a2a'; ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#5a2a1a'; ctx.fillRect(px, py, TILE, 6);
        ctx.fillStyle = '#8a5a3a'; ctx.fillRect(px + 4, py + 4, TILE - 8, 4);
      }
      break;
    case T.SHOP_FLOOR:
      if (!drawAtlasTile('shopFloor', px, py)) {
        ctx.fillStyle = '#4a3a2a'; ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#3a2a1a'; ctx.fillRect(px + 2, py + 2, 6, 6); ctx.fillRect(px + 22, py + 22, 6, 6);
      }
      break;
    case T.SHOP_WALL:
      if (!drawAtlasTile('shopWall', px, py)) {
        ctx.fillStyle = '#7a5a3a'; ctx.fillRect(px, py, TILE, TILE);
        ctx.fillStyle = '#5a3a2a'; ctx.fillRect(px, py, TILE, 6);
        ctx.fillStyle = '#9a7a5a'; ctx.fillRect(px + 4, py + 8, 4, 12); ctx.fillRect(px + 24, py + 8, 4, 12);
      }
      break;
    case T.TREE: {
      // Trunk remains in the collision layer; the leafy crown is rendered in Layer 4.
      drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
      const treeStrip = getAsset('Elements/Plants/spr_deco_tree_01_strip4.png');
      if (treeStrip && treeStrip.naturalWidth) {
        const fw = treeStrip.naturalWidth / 4;
        const fi = Math.floor(performance.now() / 360) % 4;
        ctx.drawImage(treeStrip, fi * fw, 20, fw, 14, px + 2, py + 16, TILE - 4, 18);
      } else {
        ctx.fillStyle = '#5a3a1a'; ctx.fillRect(px + 13, py + 16, 6, 16);
        ctx.fillStyle = '#4a2a0a'; ctx.fillRect(px + 13, py + 16, 2, 16);
      }
      break;
    }
    case T.BUSH: {
      drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
      const bush = getAsset('Tileset/spr_tileset_sunnysideworld_forest_32px.png');
      if (bush && bush.naturalWidth >= 32 && bush.naturalHeight >= 32) {
        ctx.drawImage(bush, 0, 0, 32, 32, px, py, TILE, TILE);
      } else if (!drawAtlasTile('bush', px, py)) {
        ctx.fillStyle = '#2a5a1a'; ctx.fillRect(px + 6, py + 10, 20, 18);
        ctx.fillStyle = '#3a7a2a'; ctx.fillRect(px + 8, py + 12, 6, 6); ctx.fillRect(px + 18, py + 16, 6, 6);
      }
      break;
    }
    case T.FENCE:
      if (!drawAtlasTile('fence', px, py)) {
        drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
        ctx.fillStyle = '#8a6a3a'; ctx.fillRect(px + 4, py + 6, 4, 22); ctx.fillRect(px + 24, py + 6, 4, 22);
        ctx.fillRect(px + 2, py + 12, 28, 4); ctx.fillRect(px + 2, py + 22, 28, 4);
      }
      break;
    case T.POND_EDGE:
      if (!drawAtlasTile('sand', px, py)) {
        ctx.fillStyle = '#d4c08a'; ctx.fillRect(px, py, TILE, TILE);
      }
      break;
    case T.SPRITE_HUT: {
      // fomt Harvest Sprite hut — small mushroom-shaped cottage in the forest.
      // Drawn as a rounded mushroom-cap roof over a wooden door (1-tile building).
      drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
      // Base hut body (wooden walls)
      ctx.fillStyle = '#7a5a3a'; ctx.fillRect(px + 3, py + 12, TILE - 6, TILE - 12);
      ctx.fillStyle = '#5a3a1a'; ctx.fillRect(px + 3, py + 12, 2, TILE - 12);
      ctx.fillRect(px + TILE - 5, py + 12, 2, TILE - 12);
      // Door (dark recessed)
      ctx.fillStyle = '#3a1a0a'; ctx.fillRect(px + 12, py + 18, 8, 14);
      ctx.fillStyle = '#5a3a1a'; ctx.fillRect(px + 12, py + 18, 1, 14);
      ctx.fillRect(px + 19, py + 18, 1, 14);
      // Mushroom-cap roof (red with white spots) — Harvest Sprite signature
      ctx.fillStyle = '#c43a3a';
      ctx.beginPath();
      ctx.ellipse(px + TILE/2, py + 12, TILE/2 - 1, 10, 0, Math.PI, 0);
      ctx.fill();
      ctx.fillStyle = '#fff4d4';   // white spots
      ctx.fillRect(px + 8,  py + 8, 3, 3);
      ctx.fillRect(px + 18, py + 6, 3, 3);
      ctx.fillRect(px + 13, py + 10, 2, 2);
      // Hovering sparkle to signal "interact"
      const spark = (Math.sin(performance.now() / 300) + 1) / 2;
      ctx.fillStyle = `rgba(255, 230, 90, ${0.5 + spark * 0.5})`;
      ctx.fillRect(px + TILE - 8, py + 2, 3, 3);
      break;
    }
    default:
      drawAssetTileOrFallback('grass', px, py, '#3a6a2a');
  }
}

function drawCrop(crop, x, y) {
  const px = x * TILE - camera.x;
  const py = y * TILE - camera.y;
  const c = CROPS[crop.type];
  const cropBase = CROP_ASSETS[crop.type];
  // Sunnyside supplies individual PNGs for six growth stages.
  if (cropBase) {
    const stageIndex = [0, 2, 4, 5][Math.min(3, Math.max(0, crop.stage | 0))];
    const sprite = getAsset(cropBase + '_' + String(stageIndex).padStart(2, '0') + '.png');
    if (sprite) {
      const size = crop.stage >= 3 ? 30 : 25;
      ctx.drawImage(sprite, px + (TILE - size) / 2, py + TILE - size - 1, size, size);
      if (crop.stage >= 3) {
        ctx.fillStyle = '#fff4a3';
        ctx.fillRect(px + TILE - 9, py + 3, 2, 2);
        ctx.fillRect(px + TILE - 6, py + 6, 2, 2);
        ctx.fillRect(px + TILE - 11, py + 7, 2, 2);
      }
      // ===== fomt wilted/regrow overlays (per task spec section 5) =====
      // Wilted (fomt STAGE.WILTED = 6): tint the sprite brown/dried.
      if (crop.wilted) {
        ctx.save();
        ctx.globalAlpha = 0.55;
        ctx.fillStyle = '#6b4a1a';   // dried brown
        ctx.fillRect(px + 1, py + 1, TILE - 2, TILE - 2);
        ctx.restore();
      }
      // Regrowing indicator (post-harvest, fomtStage 2/3/4 with _harvested flag):
      // small green dot at bottom-right of the tile.
      if (crop._harvested && crop.fomtStage != null &&
          window.FOMT_CROPS &&
          crop.fomtStage > window.FOMT_CROPS.STAGE.SEED &&
          crop.fomtStage < window.FOMT_CROPS.STAGE.MATURE) {
        ctx.fillStyle = '#5aff5a';
        ctx.fillRect(px + TILE - 7, py + TILE - 7, 4, 4);
        ctx.fillStyle = '#1a6a1a';
        ctx.fillRect(px + TILE - 6, py + TILE - 6, 2, 2);
      }
      return;
    }
  }

  // Original canvas-rendered crop remains as a fallback for types without matching sprites.
  const cx = px + TILE/2;
  const baseY = py + TILE - 4;
  // Wilted crops override the stem/fruit palette with dried-brown tones.
  const stemColor = crop.wilted ? '#6b5a3a' : c.stem;
  const fruitColor = crop.wilted ? '#8a6a3a' : c.color;
  if (crop.stage === 0) {
    ctx.fillStyle = '#3a2a14';
    ctx.fillRect(cx - 3, baseY - 4, 6, 4);
    ctx.fillStyle = fruitColor;
    ctx.fillRect(cx - 2, baseY - 5, 4, 2);
  } else if (crop.stage === 1) {
    ctx.fillStyle = stemColor;
    ctx.fillRect(cx - 1, baseY - 8, 2, 8);
    ctx.fillRect(cx - 4, baseY - 8, 3, 3);
    ctx.fillRect(cx + 1, baseY - 8, 3, 3);
  } else if (crop.stage === 2) {
    ctx.fillStyle = stemColor;
    ctx.fillRect(cx - 1, baseY - 14, 2, 14);
    ctx.fillRect(cx - 6, baseY - 12, 4, 4);
    ctx.fillRect(cx + 2, baseY - 14, 4, 4);
    ctx.fillRect(cx - 4, baseY - 16, 3, 3);
    ctx.fillRect(cx + 1, baseY - 18, 3, 3);
  } else {
    ctx.fillStyle = stemColor;
    ctx.fillRect(cx - 1, baseY - 18, 2, 18);
    ctx.fillRect(cx - 6, baseY - 14, 4, 6);
    ctx.fillRect(cx + 2, baseY - 16, 4, 6);
    ctx.fillStyle = fruitColor;
    ctx.fillRect(cx - 5, baseY - 22, 5, 5);
    ctx.fillRect(cx + 1, baseY - 24, 5, 5);
    ctx.fillRect(cx - 2, baseY - 26, 5, 5);
    ctx.fillStyle = '#fff';
    ctx.fillRect(px + TILE - 8, py + 2, 2, 2);
    ctx.fillRect(px + TILE - 6, py + 4, 2, 2);
    ctx.fillRect(px + TILE - 10, py + 4, 2, 2);
  }
  // ===== fomt wilted/regrow overlays for the canvas-rendered fallback path =====
  if (crop._harvested && crop.fomtStage != null &&
      window.FOMT_CROPS &&
      crop.fomtStage > window.FOMT_CROPS.STAGE.SEED &&
      crop.fomtStage < window.FOMT_CROPS.STAGE.MATURE) {
    ctx.fillStyle = '#5aff5a';
    ctx.fillRect(px + TILE - 7, py + TILE - 7, 4, 4);
    ctx.fillStyle = '#1a6a1a';
    ctx.fillRect(px + TILE - 6, py + TILE - 6, 2, 2);
  }
}
function drawNPC(n) {
  const px = n.x - camera.x - TILE/2;
  const py = n.y - camera.y - TILE/2 + 4;  // same offset as player
  // Pass movement state separately from the walk-cycle index: when n.moving is
  // true the sprite uses the walk strip (row cycles 0,1,0,2); when false it uses
  // the idle strip. drawCharacter() derives `walking = frame !== 0`, so we pass
  // 1 while moving and 0 while idle — same convention as drawPlayer().
  drawCharacter(px, py, n.dir, n.color, 'sprite:' + (n.sprite || 'base'), n.moving ? 1 : 0, n.name);
}

function drawPlayer() {
  const px = player.x - camera.x - TILE/2;
  const py = player.y - camera.y - TILE/2 + 4; // slight offset
  // Pass movement state separately from the walk-cycle index: walkFrame can be 0
  // during movement, which previously switched the sprite back to idle for one frame.
  // Player uses Ninja Adventure 'Boy' sprite (complete character, 16x16 frames in 4x4 grid)
  drawCharacter(px, py, player.dir, '#4a8aff', 'sprite:Boy', player.moving ? 1 : 0);
}

// ---------- Ninja Adventure character sprite system ----------
// Ninja Adventure Walk.png format: 64x64 grid = 4 rows x 4 cols of 16x16 frames
//   Row 0: standing pose (4 directions: down, up, left, right)
//   Row 1: right foot forward (4 directions)
//   Row 2: left foot forward (4 directions)
//   Row 3: standing pose (4 directions, same as row 0)
// Ninja Adventure Idle.png format: 64x16 = 1 row x 4 cols of 16x16 frames (4 directions)
const CHAR_NINJA_TILE = 16;  // native sprite frame size
const DIR_COL = { down: 0, up: 1, left: 2, right: 3 };  // direction -> sprite column
// Walk cycle: stand -> right foot -> stand -> left foot (alternating)
const WALK_CYCLE = [0, 1, 0, 2];

// Map sprite name -> asset path under /assets/
const CHAR_SPRITES = {
  Boy:      'ninja-adventure/Characters/Boy_walk.png',
  Princess: 'ninja-adventure/Characters/Princess_walk.png',
  OldMan:   'ninja-adventure/Characters/OldMan_walk.png',
};
const CHAR_IDLE_SPRITES = {
  Boy:      'ninja-adventure/Characters/Boy_idle.png',
  Princess: 'ninja-adventure/Characters/Princess_idle.png',
  OldMan:   'ninja-adventure/Characters/OldMan_idle.png',
};

function drawCharacter(px, py, dir, shirt, hair, frame, name) {
  const walking = frame !== 0;
  // Resolve sprite name from 'sprite:<Name>' convention (default: Boy)
  let spriteName = 'Boy';
  if (typeof hair === 'string' && hair.startsWith('sprite:')) {
    spriteName = hair.slice(7);
  }

  // Try Ninja Adventure complete character sprite first
  const walkPath = CHAR_SPRITES[spriteName];
  const idlePath = CHAR_IDLE_SPRITES[spriteName];
  const walkSprite = walkPath ? getAsset(walkPath) : null;
  const idleSprite = idlePath ? getAsset(idlePath) : null;

  if (walkSprite && walkSprite.complete && walkSprite.naturalWidth) {
    // Pick the right sprite: idle sprite for non-walking, walk sprite for walking
    const useIdle = !walking && idleSprite && idleSprite.complete && idleSprite.naturalWidth;
    const sprite = useIdle ? idleSprite : walkSprite;

    // Column: direction (down=0, up=1, left=2, right=3)
    const col = DIR_COL[dir] ?? 0;
    // Row: walk cycle (only row 0 for idle; cycle 0,1,0,2 for walk)
    let row = 0;
    if (walking && !useIdle) {
      const idx = Math.floor(performance.now() / 160) % WALK_CYCLE.length;
      row = WALK_CYCLE[idx];
    }

    const sx = col * CHAR_NINJA_TILE;
    const sy = row * CHAR_NINJA_TILE;

    // Shadow ellipse at feet
    ctx.fillStyle = 'rgba(0,0,0,0.25)';
    ctx.beginPath();
    ctx.ellipse(px + 16, py + 28, 10, 3, 0, 0, Math.PI * 2);
    ctx.fill();

    // Draw character (32x32 on screen = 2x scale of 16x16 native)
    // No flipping needed - sprite has all 4 directions built-in
    ctx.drawImage(sprite, sx, sy, CHAR_NINJA_TILE, CHAR_NINJA_TILE, px, py, 32, 32);

    // Name label above character
    if (name) {
      ctx.font = 'bold 10px system-ui';
      ctx.textAlign = 'center';
      const tw = ctx.measureText(name).width;
      ctx.fillStyle = 'rgba(0,0,0,0.7)';
      ctx.fillRect(px + 16 - tw/2 - 4, py - 14, tw + 8, 13);
      ctx.fillStyle = '#ffe04a';
      ctx.fillText(name, px + 16, py - 4);
      ctx.textAlign = 'left';
    }
    return;
  }

  // ===== Fallback: procedural character drawing (when sprite not loaded) =====

  // shadow
  ctx.fillStyle = 'rgba(0,0,0,0.25)';
  ctx.fillRect(px + 8, py + 26, 16, 4);
  // legs (walk animation)
  ctx.fillStyle = '#2a1a0a';
  const legOffset = (frame === 1) ? 1 : (frame === 3) ? -1 : 0;
  ctx.fillRect(px + 10, py + 22, 4, 6 + legOffset);
  ctx.fillRect(px + 18, py + 22, 4, 6 - legOffset);
  // body
  ctx.fillStyle = shirt;
  ctx.fillRect(px + 8, py + 12, 16, 12);
  // arms
  ctx.fillStyle = shirt;
  ctx.fillRect(px + 6, py + 14, 4, 8);
  ctx.fillRect(px + 22, py + 14, 4, 8);
  // head
  ctx.fillStyle = '#f4c896';
  ctx.fillRect(px + 10, py + 4, 12, 10);
  // hair
  ctx.fillStyle = hair;
  ctx.fillRect(px + 9, py + 2, 14, 5);
  ctx.fillRect(px + 9, py + 4, 3, 6);
  ctx.fillRect(px + 20, py + 4, 3, 6);
  // face direction
  ctx.fillStyle = '#1a1a1a';
  if (dir === 'down') {
    ctx.fillRect(px + 13, py + 8, 2, 2);
    ctx.fillRect(px + 17, py + 8, 2, 2);
  } else if (dir === 'up') {
    // hair covers, no eyes
  } else if (dir === 'left') {
    ctx.fillRect(px + 12, py + 8, 2, 2);
  } else if (dir === 'right') {
    ctx.fillRect(px + 18, py + 8, 2, 2);
  }
  // name label — positioned higher to avoid overlap with [E] indicator
  if (name) {
    ctx.font = 'bold 10px system-ui';
    ctx.textAlign = 'center';
    const nameY = py - 22;
    ctx.fillStyle = 'rgba(0,0,0,0.75)';
    const tw = ctx.measureText(name).width;
    ctx.fillRect(px + 16 - tw/2 - 4, nameY - 2, tw + 8, 13);
    ctx.fillStyle = '#ffe04a';
    ctx.fillText(name, px + 16, nameY + 8);
    ctx.textAlign = 'left';
  }
}


function drawParticles() {
  for (const p of particles) {
    ctx.globalAlpha = Math.max(0, p.life);
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x - camera.x, p.y - camera.y, p.size, p.size);
  }
  ctx.globalAlpha = 1;
}

function drawActionHint() {
  if (!nearbyAction || dialogActive || menuOpen) return;
  const px = player.x - camera.x;
  const py = player.y - camera.y - 30;
  let label = '';
  if (nearbyAction.type === 'shop') label = '🛒 Toko (B)';
  else if (nearbyAction.type === 'sleep') label = '🛏️ Tidur (T)';
  else if (nearbyAction.type === 'blacksmith') label = '🔧 Tukang Besi (E)';
  else if (nearbyAction.type === 'barn') label = '🐄 Kandang (E)';
  else if (nearbyAction.type === 'coop') label = '🐔 Kandang Ayam (E)';
  else if (nearbyAction.type === 'carpenter') label = '🔨 Tukang Kayu (E)';
  else if (nearbyAction.type === 'sprites') label = '🧚 Pondok Sprite (E)';
  else if (nearbyAction.type === 'record_player') {
    const songId = rpGetSongId();
    label = rpHasAlbum() ? `🎵 Pemutar Rekaman (E) · Lagu #${songId}` : '🎵 Pemutar Rekaman (E)';
  }
  else if (nearbyAction.type === 'npc') {
    // fomt gift-giving: show gift hint when player has 'seeds' tool selected
    // (selectedSeed indicates which crop will be gifted via G key)
    label = selectedTool === 'seeds' ? '💬 Bicara (E) · 🎁 Hadiah (G)' : '💬 Bicara (E)';
  }
  ctx.font = 'bold 11px system-ui';
  const w = ctx.measureText(label).width + 14;
  ctx.fillStyle = 'rgba(0,0,0,0.8)';
  ctx.fillRect(px - w/2, py - 12, w, 16);
  ctx.fillStyle = '#ffe04a';
  ctx.textAlign = 'center';
  ctx.fillText(label, px, py);
  ctx.textAlign = 'left';
}

function drawToolCursor() {
  if (dialogActive || menuOpen) return;
  const { fx, fy } = getFacingTile();
  if (fx < 0 || fy < 0 || fx >= MAP_W || fy >= MAP_H) return;
  const px = fx * TILE - camera.x;
  const py = fy * TILE - camera.y;
  ctx.strokeStyle = 'rgba(255, 224, 74, 0.8)';
  ctx.lineWidth = 2;
  ctx.strokeRect(px + 1, py + 1, TILE - 2, TILE - 2);
  ctx.lineWidth = 1;
}

function drawSkyOverlay() {
  // Dim screen at night based on time of day
  const h = timeOfDay / 60;
  let dim = 0;
  if (h < 7) dim = (7 - h) / 3 * 0.45;
  else if (h > 20) dim = (h - 20) / 4 * 0.55;
  if (dim > 0) {
    ctx.fillStyle = `rgba(20, 25, 60, ${Math.min(0.55, dim)})`;
    ctx.fillRect(0, 0, canvas.clientWidth, canvas.clientHeight);
  }
}

function drawSleepFade() {
  if (sleepTransition > 0) {
    ctx.fillStyle = `rgba(0,0,0,${sleepTransition})`;
    ctx.fillRect(0, 0, canvas.clientWidth, canvas.clientHeight);
  }
}

// ===== 5-LAYER RENDER PIPELINE =====
// Classify a map tile into its render layer (1=Ground, 2=WalkInFront, 3=Collision).
// Used by render() to draw tiles in correct depth order across 3 sub-passes.
function tileRenderLayer(tileId) {
  switch (tileId) {
    // Layer 1 (Ground): base terrain only — terrain and structural floor tiles.
    case T.GRASS: case T.GRASS2: case T.SAND: case T.WATER:
    case T.FLOOR: case T.SHOP_FLOOR: case T.PATH:
      return 1;
    // Layer 2 (WalkInFront): soil state and ground-level overlays.
    case T.TILLED: case T.WATERED: case T.FLOWER:
      return 2;
    // Layer 3 (Collision): solid blocking tiles — walls, fences, trees, bushes, sprite hut
    case T.WALL: case T.SHOP_WALL: case T.FENCE: case T.BUSH: case T.TREE:
    case T.POND_EDGE: case T.SPRITE_HUT:
      return 3;
    default:
      return 1;
  }
}

// ===== Layer 4: WalkBehind (canopy / roof overhangs) =====
// Renders AFTER player so canopy covers the player when they walk under.
function drawCanopyTile(canopyId, x, y) {
  const px = x * TILE - camera.x;
  const py = y * TILE - camera.y;
  if (px < -TILE || py < -TILE || px > canvas.clientWidth + TILE || py > canvas.clientHeight + TILE) return;
  const t = performance.now() / 1000;

  switch (canopyId) {
    case C.TREE_CANOPY: {
      // ===== Layer 4 (WalkBehind): LEAVES with downward overhang =====
      // Draw the leafy crown at the canopy tile, extending DOWNWARD past the
      // tile boundary so it visually connects with the trunk in the tile below.
      // Player walking onto this canopy tile is covered by these leaves
      // (Layer 4 renders above player = WalkBehind effect).
      const treeStrip = getAsset('Elements/Plants/spr_deco_tree_01_strip4.png');
      if (treeStrip && treeStrip.complete && treeStrip.naturalWidth) {
        const fw = treeStrip.naturalWidth / 4;
        const fh = treeStrip.naturalHeight;  // 34
        const fi = Math.floor(t * 3) % 4;
        // Crop LEAVES region of sprite: top portion (y=0 to y=24, ~24px)
        // Draw at canopy tile, overhanging DOWN past tile boundary to meet trunk below:
        //   dest y: py + 0 (top of canopy tile)
        //   dest height: TILE + 16 (extends 16px into trunk tile below)
        // This visually connects canopy leaves with trunk drawn at trunk tile.
        ctx.drawImage(treeStrip, fi * fw, 0, fw, 24, px - 4, py, TILE + 8, TILE + 16);
      } else {
        // Procedural fallback: bushy green canopy with overhang
        ctx.fillStyle = '#1a4a0a';
        ctx.beginPath(); ctx.arc(px + 16, py + 14, 18, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#2a6a1a';
        ctx.beginPath(); ctx.arc(px + 10, py + 12, 12, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(px + 22, py + 16, 12, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#3a8a2a';
        ctx.beginPath(); ctx.arc(px + 14, py + 10, 6, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(px + 20, py + 14, 6, 0, Math.PI * 2); ctx.fill();
        // Lower overhang into trunk tile
        ctx.fillStyle = '#2a6a1a';
        ctx.fillRect(px + 4, py + TILE, TILE - 8, 12);
      }
      break;
    }
    case C.TREE_TOP: {
      // C.TREE_TOP is no longer generated (canopy already covers full tree height
      // via overhang). Kept as no-op for backward compatibility with old saves.
      break;
    }
    case C.ROOF_HOUSE: {
      // Red-brown peaked roof overhang (player walks behind house)
      ctx.fillStyle = '#8a3a2a';
      ctx.fillRect(px, py, TILE, TILE);
      ctx.fillStyle = '#6a2a1a';
      ctx.fillRect(px, py, TILE, 6);                    // top edge shadow
      ctx.fillStyle = '#a04a3a';
      for (let i = 0; i < 4; i++) {
        ctx.fillRect(px + i * 8 + 1, py + 6, 6, TILE - 8); // roof shingles
      }
      ctx.fillStyle = '#5a1a0a';
      ctx.fillRect(px, py + TILE - 3, TILE, 3);        // bottom edge
      break;
    }
    case C.ROOF_SHOP: {
      // Blue-teal shop roof overhang
      ctx.fillStyle = '#3a5a8a';
      ctx.fillRect(px, py, TILE, TILE);
      ctx.fillStyle = '#2a4a7a';
      ctx.fillRect(px, py, TILE, 6);
      ctx.fillStyle = '#4a6a9a';
      for (let i = 0; i < 4; i++) {
        ctx.fillRect(px + i * 8 + 1, py + 6, 6, TILE - 8);
      }
      ctx.fillStyle = '#1a3a6a';
      ctx.fillRect(px, py + TILE - 3, TILE, 3);
      break;
    }
  }
}

// ===== Layer 5: Decor (top-most — fireflies, sparkles) =====
// Renders LAST, above everything including canopy and player.
let nightFireflies = [];  // dynamically spawned firefly particles
function spawnNightFireflies() {
  const h = timeOfDay / 60;
  const isNight = (h < 6 || h >= 19);
  // Target count: more fireflies at night, none during day
  const target = isNight ? 18 : 0;
  // Spawn near the player's vicinity
  while (nightFireflies.length < target) {
    nightFireflies.push({
      x: player.x + (Math.random() - 0.5) * 600,
      y: player.y + (Math.random() - 0.5) * 400,
      phase: Math.random() * Math.PI * 2,
      speed: 0.3 + Math.random() * 0.5,
      brightness: 0.5 + Math.random() * 0.5,
    });
  }
  // Despawn excess (when day comes, they fade out)
  if (nightFireflies.length > target) {
    nightFireflies = nightFireflies.slice(0, target);
  }
}

function updateFireflies(dt) {
  const t = performance.now() / 1000;
  for (const f of nightFireflies) {
    // Gentle wandering motion
    f.x += Math.cos(t * f.speed + f.phase) * 0.4;
    f.y += Math.sin(t * f.speed * 1.3 + f.phase) * 0.3;
    // Flicker brightness
    f.brightness = 0.4 + 0.6 * (0.5 + 0.5 * Math.sin(t * 3 + f.phase));
  }
}

function drawDecorTile(decorId, x, y) {
  const px = x * TILE - camera.x;
  const py = y * TILE - camera.y;
  if (px < -TILE || py < -TILE || px > canvas.clientWidth + TILE || py > canvas.clientHeight + TILE) return;
  const t = performance.now() / 1000;

  switch (decorId) {
    case D.SPARKLE: {
      // Twinkling 4-pointed star above flowers
      const flicker = 0.5 + 0.5 * Math.sin(t * 4 + x * 3 + y * 7);
      ctx.globalAlpha = flicker;
      ctx.fillStyle = '#fff5a0';
      const cx = px + 16, cy = py + 10;
      // 4-pointed star
      ctx.beginPath();
      ctx.moveTo(cx, cy - 5);
      ctx.lineTo(cx + 2, cy - 2);
      ctx.lineTo(cx + 5, cy);
      ctx.lineTo(cx + 2, cy + 2);
      ctx.lineTo(cx, cy + 5);
      ctx.lineTo(cx - 2, cy + 2);
      ctx.lineTo(cx - 5, cy);
      ctx.lineTo(cx - 2, cy - 2);
      ctx.closePath();
      ctx.fill();
      ctx.globalAlpha = 1;
      break;
    }
  }
}

function drawFireflies() {
  for (const f of nightFireflies) {
    const sx = f.x - camera.x;
    const sy = f.y - camera.y;
    if (sx < -20 || sx > canvas.clientWidth + 20 || sy < -20 || sy > canvas.clientHeight + 20) continue;
    // Glow halo
    const grad = ctx.createRadialGradient(sx, sy, 0, sx, sy, 8);
    grad.addColorStop(0, `rgba(255, 240, 120, ${f.brightness * 0.6})`);
    grad.addColorStop(1, 'rgba(255, 240, 120, 0)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(sx, sy, 8, 0, Math.PI * 2);
    ctx.fill();
    // Core dot
    ctx.fillStyle = `rgba(255, 255, 200, ${f.brightness})`;
    ctx.beginPath();
    ctx.arc(sx, sy, 1.5, 0, Math.PI * 2);
    ctx.fill();
  }
}

// ===== Virtual Camera: Smooth Lerp Follow + Confiner Clamp =====
// Called BEFORE render() in game loop. Computes camera position with:
//   Step 1: target = player - viewport/2  (center player on screen)
//   Step 2: camera += (target - camera) * dampening  (lerp ease-out)
//   Step 3: camera = clamp(camera, 0, mapSize - viewport)  (confiner)
function updateCamera() {
  const vw = canvas.clientWidth, vh = canvas.clientHeight;
  // Step 1: Ideal target (player centered on screen)
  camera.targetX = player.x - vw / 2;
  camera.targetY = player.y - vh / 2;
  // Step 2: Smooth dampening via Linear Interpolation
  // Lower dampening = smoother/slower follow, higher = snappier
  camera.x += (camera.targetX - camera.x) * CAMERA_CONFIG.dampening;
  camera.y += (camera.targetY - camera.y) * CAMERA_CONFIG.dampening;
  // Step 3: Cinemachine Confiner — clamp to MapBounds
  // Prevents camera from showing area outside the map (no black bleed)
  const maxX = MAP_W * TILE - vw;
  const maxY = MAP_H * TILE - vh;
  camera.x = Math.max(0, Math.min(maxX, camera.x));
  camera.y = Math.max(0, Math.min(maxY, camera.y));
}

function render() {
  const vw = canvas.clientWidth, vh = canvas.clientHeight;
  ctx.fillStyle = '#2d4a2d';
  ctx.fillRect(0, 0, vw, vh);

  // Note: camera.x/y are now updated in updateCamera() BEFORE render()
  // (called in game loop). This keeps render() pure (no state mutation).

  // Visible tile range
  const startX = Math.max(0, Math.floor(camera.x / TILE));
  const endX = Math.min(MAP_W - 1, Math.ceil((camera.x + vw) / TILE));
  const startY = Math.max(0, Math.floor(camera.y / TILE));
  const endY = Math.min(MAP_H - 1, Math.ceil((camera.y + vh) / TILE));

  // ===== PASS 1: Layer 1 (Ground) — base terrain =====
  for (let y = startY; y <= endY; y++) {
    for (let x = startX; x <= endX; x++) {
      if (tileRenderLayer(map[y][x]) === 1) drawTile(map[y][x], x, y);
    }
  }
  // ===== PASS 2: Layer 2 (WalkInFront) — paths, flowers, crops =====
  for (let y = startY; y <= endY; y++) {
    for (let x = startX; x <= endX; x++) {
      if (tileRenderLayer(map[y][x]) === 2) drawTile(map[y][x], x, y);
    }
  }
  // Crops render in Layer 2 (on top of ground, below player)
  for (let y = startY; y <= endY; y++) {
    for (let x = startX; x <= endX; x++) {
      if (cropMap[y][x]) drawCrop(cropMap[y][x], x, y);
    }
  }
  // World items (dropped items on ground) — render above crops, below player
  drawWorldItems();
  drawInteractables();            // Interactable objects (chests + signboards)
  drawPowerBerries();             // fomt collectibles (10 power berries + kappa berry)
  // ===== PASS 3: Layer 3 (Collision) — walls, trees, fences =====
  for (let y = startY; y <= endY; y++) {
    for (let x = startX; x <= endX; x++) {
      if (tileRenderLayer(map[y][x]) === 3) drawTile(map[y][x], x, y);
    }
  }
  // ===== PASS 3.5: Layer 3.5 (Player + NPCs) — Y-sorted dynamic entities =====
  const drawables = [];
  for (const n of npcs) drawables.push({ y: n.y + TILE/2, kind: 'npc', ref: n });
  for (const a of ambientAnimals) drawables.push({ y: a.y + TILE - 2, kind: 'animal', ref: a });
  for (const p of ambientProps) drawables.push({ y: p.y + TILE - 2, kind: 'prop', ref: p });
  drawables.push({ y: player.y, kind: 'player' });
  drawables.sort((a, b) => a.y - b.y);
  for (const d of drawables) {
    if (d.kind === 'npc') drawNPC(d.ref);
    else if (d.kind === 'animal') drawAmbientAnimal(d.ref);
    else if (d.kind === 'prop') drawAmbientProp(d.ref);
    else drawPlayer();
  }
  // ===== PASS 4: Layer 4 (WalkBehind) — tree canopies, roof overhangs =====
  // Renders ABOVE player — canopy covers player when they walk under.
  for (let y = startY; y <= endY; y++) {
    for (let x = startX; x <= endX; x++) {
      if (canopyMap[y][x]) drawCanopyTile(canopyMap[y][x], x, y);
    }
  }
  // ===== PASS 5: Layer 5 (Decor) — sparkles, fireflies (top-most) =====
  for (let y = startY; y <= endY; y++) {
    for (let x = startX; x <= endX; x++) {
      if (decorMap[y][x]) drawDecorTile(decorMap[y][x], x, y);
    }
  }
  // ===== fomt Record Player furniture tile (furniture.hh:75) =====
  // Drawn dynamically each frame when farmHouse.hasRecordPlayer is true. The tile is
  // fixed at RECORD_PLAYER_INTERIOR_TILE inside the player's house. Albums that are
  // currently inserted get a small spinning-disc indicator above the player.
  drawRecordPlayerFurniture();
  // Dynamic fireflies (spawned at night, float freely — not tile-locked)
  drawFireflies();

  // ===== UI overlays (above all game layers) =====
  drawToolCursor();
  drawParticles();
  drawActionHint();
  drawSkyOverlay();
  drawSleepFade();
  // fomt schedule debug overlay (toggle with M) — draws each NPC's current target
  // and a line from NPC to target so QA can verify the schedule is moving NPCs.
  if (scheduleDebug) drawScheduleDebug();
}

// ===== fomt NPC Schedule Debug Overlay =====
// Press M to toggle. Renders an on-canvas overlay showing each NPC's schedule:
//   - yellow ring at the NPC's current target tile
//   - thin yellow line from NPC centre to the target
//   - small label "Name → HH:00 (x,y)" near the target
// plus a header line listing the active game hour.
function drawScheduleDebug() {
  const h = Math.floor(timeOfDay / 60);
  const m = Math.floor(timeOfDay % 60);
  // Header (top-left of viewport).
  ctx.font = 'bold 11px system-ui';
  ctx.textAlign = 'left';
  const headerLines = [
    `[SCHEDULE DEBUG] game time ${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')} (hour ${h})`,
    ...npcs.map(n => {
      if (!n.schedule || n.schedule.length === 0) return `  ${n.name}: no schedule`;
      const cur = currentScheduleEntry(n);
      const tgt = n.met ? cur : n.schedule[0];
      const tx = Math.floor(tgt.x / TILE), ty = Math.floor(tgt.y / TILE);
      const met = n.met ? 'met' : '!met';
      const mov = n.moving ? 'walking' : 'idle';
      return `  ${n.name} → ${String(tgt.hour).padStart(2,'0')}:00 @(${tx},${ty}) ${tgt.dir} [${met}/${mov}]`;
    }),
  ];
  const headerH = headerLines.length * 14 + 8;
  ctx.fillStyle = 'rgba(0,0,0,0.75)';
  ctx.fillRect(8, 8, 360, headerH);
  ctx.fillStyle = '#ffe04a';
  for (let i = 0; i < headerLines.length; i++) {
    ctx.fillText(headerLines[i], 14, 22 + i * 14);
  }

  // Per-NPC target ring + connector line.
  for (const n of npcs) {
    if (!n.schedule || n.schedule.length === 0) continue;
    const cur = currentScheduleEntry(n);
    const tgt = n.met ? cur : n.schedule[0];
    const sx = n.x - camera.x;
    const sy = n.y - camera.y;
    const tx = tgt.x - camera.x;
    const ty = tgt.y - camera.y;
    // Connector line NPC → target
    ctx.strokeStyle = 'rgba(255,224,74,0.65)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(sx, sy);
    ctx.lineTo(tx, ty);
    ctx.stroke();
    // Target ring
    ctx.strokeStyle = '#ffe04a';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(tx, ty, 10, 0, Math.PI * 2);
    ctx.stroke();
    ctx.fillStyle = 'rgba(255,224,74,0.25)';
    ctx.beginPath();
    ctx.arc(tx, ty, 10, 0, Math.PI * 2);
    ctx.fill();
  }
}

// Helper used by drawScheduleDebug: pick the active schedule entry for an NPC
// using the same rule as updateNpcSchedule (largest hour <= current hour; if
// current hour < schedule[0].hour, returns the last entry for "sleeping").
function currentScheduleEntry(npc) {
  if (!npc.schedule || npc.schedule.length === 0) return null;
  const currentHour = Math.floor(timeOfDay / 60);
  if (currentHour < npc.schedule[0].hour) return npc.schedule[npc.schedule.length - 1];
  let entry = npc.schedule[0];
  for (const s of npc.schedule) {
    if (s.hour <= currentHour) entry = s;
    else break;
  }
  return entry;
}

// ---------- HUD ----------
function updateHUD() {
  document.getElementById('hud-gold').textContent = player.gold;
  document.getElementById('hud-day').textContent = day;
  document.getElementById('hud-season').textContent = seasonLabel(season) + ' (' + seasonDay + ')';
  document.getElementById('hud-season-icon').src = 'assets/UI/plant.png';
  const h = Math.floor(timeOfDay / 60);
  const m = Math.floor(timeOfDay % 60);
  const timeStr = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
  document.getElementById('hud-time').textContent = timeStr;
  document.getElementById('hud-time-icon').src = (h >= 6 && h < 19) ? 'assets/UI/stopwatch.png' : 'assets/UI/sandtimer.png';
  // Update zone label in HUD
  const hudZoneEl = document.getElementById('hud-zone');
  if (hudZoneEl) {
    const z = zoneRegistry.find(zn => zn.id === currentZoneId);
    hudZoneEl.textContent = z ? z.name : '—';
  }
}

// ---------- Main loop ----------
function loop(now) {
  const dt = Math.min(0.05, (now - lastFrame) / 1000);
  lastFrame = now;
  if (gameStarted) {
    // ===== Pause System: bypass ALL updates when paused (freeze frame) =====
    if (!isPaused) {
      updatePlayer(dt);
      // fomt NPC schedule movement — NPCs walk toward time-of-day targets each frame.
      for (const npc of npcs) updateNpcSchedule(npc, dt);
      updateAmbientLife(dt);
      updateNearbyAction();
      updateTime(dt);
      updateParticles(dt);
      spawnNightFireflies();
      updateFireflies(dt);
      checkWorldPickups();
      updateCurrentZone();
      updateCamera();
    }
    render();   // Always render — frozen frame stays visible
    updateHUD();
    // Debug: expose game state for testing (5-layer + camera verification)
    window.__gameDebug = {
      playerTile: { x: Math.floor((player.x) / TILE), y: Math.floor((player.y) / TILE) },
      playerPx: { x: Math.round(player.x), y: Math.round(player.y) },
      camera: { x: Math.round(camera.x), y: Math.round(camera.y), targetX: Math.round(camera.targetX), targetY: Math.round(camera.targetY) },
      canopyAtPlayer: canopyMap[Math.floor(player.y / TILE)]?.[Math.floor(player.x / TILE)] || 0,
      mapAtPlayer: map[Math.floor(player.y / TILE)]?.[Math.floor(player.x / TILE)] || 0,
      timeOfDay: Math.floor(timeOfDay / 60) + ':' + String(Math.floor(timeOfDay % 60)).padStart(2, '0'),
    };
  }
  requestAnimationFrame(loop);
}

// ===== UI Menu Functions =====
// Switch active tab page (Status/Bag/Map)
function switchTab(tabName) {
  activeTab = tabName;
  document.querySelectorAll('.ui-tab-btn').forEach((btn) => {
    btn.classList.toggle('active', btn.dataset.tab === tabName);
  });
  document.querySelectorAll('.ui-tab-page').forEach((page) => {
    page.classList.toggle('active', page.dataset.tab === tabName);
  });
  if (tabName === 'bag') {
    syncInvQuantities();   // sync counts, preserve swaps
    renderInventory();
  } else if (tabName === 'status') {
    renderStatusTab();
    drawPortrait();
  } else if (tabName === 'map') { renderZoneCards(); updateMapTab(); }
}
// Tab button click handlers
document.querySelectorAll('.ui-tab-btn').forEach((btn) => {
  btn.addEventListener('click', () => switchTab(btn.dataset.tab));
});
// Close button
document.getElementById('ui-close').addEventListener('click', () => {
  isMenuOpen = false;
  document.getElementById('ui-menu').classList.remove('open');
  toast('✅ Menu ditutup');
});

// ===== Pause Menu Button Handlers =====
document.getElementById('pause-resume').addEventListener('click', () => {
  AudioManager.init(); AudioManager.playUI();
  isPaused = false;
  document.getElementById('pause-menu').classList.remove('open');
  toast('▶ Game dilanjutkan', 'info');
});
document.getElementById('pause-settings').addEventListener('click', () => {
  toast('⚙ Settings — belum tersedia di versi ini', 'warn');
});
document.getElementById('pause-quit').addEventListener('click', () => {
  toast('✕ Quit — refresh halaman untuk restart', 'warn');
});

// ===== Status Tab Renderer =====
function renderStatusTab() {
  const grid = document.getElementById('ui-status-grid');
  if (!grid) return;
  const h = Math.floor(timeOfDay / 60);
  const m = Math.floor(timeOfDay % 60);
  const timeStr = `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
  const totalCrops = Object.values(player.inventory).reduce((a, b) => a + b, 0);
  const totalSeeds = Object.values(player.seeds).reduce((a, b) => a + b, 0);
  // fomt crop field stats: planted (alive), regrowing (post-harvest), wilted.
  const FOMT_C = window.FOMT_CROPS;
  let planted = 0, regrowing = 0, wilted = 0, mature = 0;
  if (cropMap) {
    for (let y = 0; y < MAP_H; y++) {
      for (let x = 0; x < MAP_W; x++) {
        const c = cropMap[y][x];
        if (!c) continue;
        planted++;
        if (c.wilted) wilted++;
        if (c.stage >= 3) mature++;
        if (c._harvested && c.fomtStage != null && FOMT_C &&
            c.fomtStage > FOMT_C.STAGE.SEED &&
            c.fomtStage < FOMT_C.STAGE.MATURE) regrowing++;
      }
    }
  }
  const title = document.getElementById('ui-title');
  if (title) title.textContent = `HARVEST VALE — ${seasonLabel(season)}, Day ${day}`;
  grid.innerHTML = `
    <div class="ui-status-row"><span class="label">💰 Gold</span><span class="value">${player.gold}g</span></div>
    <div class="ui-status-row"><span class="label">📦 Shipped</span><span class="value">${shippingBin.valueShipped.toLocaleString()}g</span></div>
    <div class="ui-status-row"><span class="label">💪 Stamina</span><span class="value">${player.stamina} / ${player.maxStamina}</span></div>
    <div class="ui-status-row"><span class="label">😵 Fatigue</span><span class="value">${Math.floor(player.fatigue / 2)} / 100${player.kappaBerry ? ' 🟢' : ''}</span></div>
    <div class="ui-status-row"><span class="label">🍓 Power Berries</span><span class="value">${player.powerBerries} / 10</span></div>
    <div class="ui-status-row"><span class="label">🎒 Rucksack</span><span class="value">${rucksackUpgradeLevel() === 0 ? 'Lv.0 (2 slot)' : rucksackUpgradeLevel() === 1 ? 'Lv.1 (4 slot)' : 'Lv.2 (8 slot)'}</span></div>
    <div class="ui-status-row"><span class="label">📅 Day</span><span class="value">${day}</span></div>
    <div class="ui-status-row"><span class="label">🌿 Season</span><span class="value">${seasonLabel(season)} (${seasonDay})</span></div>
    <div class="ui-status-row"><span class="label">🕐 Time</span><span class="value">${timeStr}</span></div>
    <div class="ui-status-row"><span class="label">💧 Water</span><span class="value">${player.water} / ${player.maxWater}</span></div>
    <div class="ui-status-row"><span class="label">🌾 Crops</span><span class="value">${totalCrops}</span></div>
    <div class="ui-status-row"><span class="label">🌱 Seeds</span><span class="value">${totalSeeds}</span></div>
    <div class="ui-status-row"><span class="label">🌾 Field</span><span class="value">${planted} planted · ${mature} mature${regrowing ? ` · 🌿 ${regrowing} regrow` : ''}${wilted ? ` · 🥀 ${wilted} wilted` : ''}</span></div>
    <div class="ui-status-row" style="border-top:1px solid #444;margin-top:6px;padding-top:8px;">
      <span class="label">🐄 Livestock</span><span class="value">${countBarnAnimals()}/${getBarnCapacity()} barn · ${countChickens()}/${getCoopCapacity()} coop</span>
    </div>
    <div class="ui-status-row"><span class="label">🐄 Cows</span><span class="value">${livestock.cows.length} (${livestock.cows.filter(c => c.growthStage >= 2).length} adult) · 🌾 Fodder: ${barnState.fodder} · 💊 Obat: ${player.medicine || 0}</span></div>
    ${livestock.cows.length > 0 ? livestock.cows.map(c => {
      const h = animalHearts(c);
      const stage = c.growthStage === 2 ? 'Adult' : c.growthStage === 1 ? 'Medium' : 'Baby';
      return `<div class="ui-status-row"><span class="label">  🐄 ${c.name}</span><span class="value">${'❤'.repeat(h)}${'🤍'.repeat(10-h)} · ${stage}${c.sick ? ' · 🤒sick' : ''}${c.pregnant ? ` · 🤰${c.days_pregnant}d` : ''}</span></div>`;
    }).join('') : ''}
    <div class="ui-status-row"><span class="label">🐑 Sheep</span><span class="value">${livestock.sheep.length} (${livestock.sheep.filter(s => s.growthStage >= 1).length} adult)</span></div>
    ${livestock.sheep.length > 0 ? livestock.sheep.map(s => {
      const h = animalHearts(s);
      const stage = s.growthStage === 1 ? 'Adult' : 'Lamb';
      return `<div class="ui-status-row"><span class="label">  🐑 ${s.name}</span><span class="value">${'❤'.repeat(h)}${'🤍'.repeat(10-h)} · ${stage}${s.sick ? ' · 🤒sick' : ''}${s.days_until_product > 0 ? ` · ✂️${s.days_until_product}d` : ''}</span></div>`;
    }).join('') : ''}
    <div class="ui-status-row"><span class="label">🐔 Chickens</span><span class="value">${livestock.chickens.length} (${livestock.chickens.filter(c => c.growthStage >= 1).length} adult) · 🌾 Pakan: ${coopState.feed}</span></div>
    ${livestock.chickens.length > 0 ? livestock.chickens.map(c => {
      const h = animalHearts(c);
      const stage = c.growthStage === 1 ? 'Adult' : 'Chick';
      return `<div class="ui-status-row"><span class="label">  🐔 ${c.name}</span><span class="value">${'❤'.repeat(h)}${'🤍'.repeat(10-h)} · ${stage}${c.sick ? ' · 🤒sick' : ''}${c.hasEgg ? ' · 🥚egg!' : ''}</span></div>`;
    }).join('') : ''}
    <div class="ui-status-row" style="border-top:1px solid #444;margin-top:6px;padding-top:8px;">
      <span class="label">🔧 Tool Levels</span><span class="value"></span>
    </div>
    ${toolLevels.map((tl, i) => {
      const tier = TOOL_TIER_NAMES[tl.committedLevel] || 'Iron';
      const isMax = tl.committedLevel >= TOOL_LEVEL_MAX;
      const usageReq = isMax ? 0 : (TOOL_UPGRADE_USAGE_REQ[tl.committedLevel] || 0);
      const famLabel = TOOL_FAMILY_LABELS[i] || TOOL_FAMILY_NAMES[i];
      return `<div class="ui-status-row"><span class="label">${famLabel}</span><span class="value">${tier}${isMax ? ' ★' : ` · ${tl.usage}/${usageReq}`}</span></div>`;
    }).join('')}
    <div class="ui-status-row" style="border-top:1px solid #444;margin-top:6px;padding-top:8px;">
      <span class="label">💬 Friendship</span><span class="value"></span>
    </div>
    ${npcs.map(n => {
      // 🎁 icon marks NPCs that have been gifted today (fomt gifted_today flag)
      const giftIcon = n.gifted_today ? ' 🎁' : '';
      return `<div class="ui-status-row"><span class="label">${n.name}${giftIcon}</span><span class="value">${'❤'.repeat(npcHearts(n))}${'🤍'.repeat(10 - npcHearts(n))} (${n.met ? (n.friendship||0) : '?'})</span></div>`;
    }).join('')}
    ${npcs.filter(n => n.isBachelorette && n.met).map(n => {
      // fomt Bachelorette love points (bachelorette.hh:26 — love:16). 10 hearts.
      // Each heart = floor(love/6554). Capped 0..65535.
      const h = bachLoveHearts(n);
      const proposeReady = (n.love || 0) >= BACH_PROPOSE_LOVE_THRESHOLD;
      const featherIcon = player.blueFeather ? ' 🪶' : '';
      const proposeIcon = proposeReady && player.blueFeather ? ' 💍' : '';
      return `<div class="ui-status-row"><span class="label">💕 ${n.name}${featherIcon}</span><span class="value">${'💖'.repeat(h)}${'🤍'.repeat(10 - h)} (${n.love}/65535)${proposeIcon}</span></div>`;
    }).join('')}
    <div class="ui-status-row" style="border-top:1px solid #444;margin-top:6px;padding-top:8px;">
      <span class="label">🏠 FarmHouse</span><span class="value">Lv.${farmHouse.upgradeLevel}/2${farmHouse.fireplaceLighted ? ' · 🔥fire' : ''}</span>
    </div>
    <div class="ui-status-row"><span class="label">🪑 Furniture</span><span class="value">${[
      farmHouse.hasFridge ? 'Fridge' : '', farmHouse.hasShelf ? 'Shelf' : '',
      farmHouse.hasKitchen ? 'Kitchen' : '', farmHouse.hasBathroom ? 'Bath' : '',
      farmHouse.hasLargeBed ? 'Bed' : '', farmHouse.hasCarpet ? 'Carpet' : '',
      farmHouse.hasRecordPlayer ? 'Rec' : '', farmHouse.hasVase ? 'Vase' : '',
      farmHouse.hasMirror ? 'Mirror' : '', farmHouse.hasClock ? 'Clock' : '',
    ].filter(s => s).join(' · ') || '—'}</span></div>
    ${farmHouse.hasKitchen ? `<div class="ui-status-row"><span class="label">🍴 Kitchen Tools</span><span class="value">${[
      farmHouse.hasKitchenKnife ? 'Knife' : '', farmHouse.hasKitchenFryingPan ? 'Pan' : '',
      farmHouse.hasKitchenPot ? 'Pot' : '', farmHouse.hasKitchenMixer ? 'Mixer' : '',
      farmHouse.hasKitchenWhisk ? 'Whisk' : '', farmHouse.hasKitchenRollingPin ? 'Pin' : '',
      farmHouse.hasKitchenOven ? 'Oven' : '', farmHouse.hasKitchenSeasoningSet ? 'Season' : '',
    ].filter(s => s).join(' · ') || '—'}</span></div>` : ''}
    ${farmHouse.hasVase ? (() => {
      if (farmHouse.vaseArticleId !== null) {
        const info = VASE_FLOWER_INFO[farmHouse.vaseArticleId];
        return `<div class="ui-status-row"><span class="label">🌷 Vase</span><span class="value">${info ? info.name : 'Flower'} (${farmHouse.vaseArticleLifespan}d · ${info ? info.season : '?'})</span></div>`;
      }
      return `<div class="ui-status-row"><span class="label">🌷 Vase</span><span class="value">kosong</span></div>`;
    })() : ''}
    ${farmHouse.hasRecordPlayer ? (() => {
      // fomt RecordPlayer (furniture.hh:75) — show current album + song id (record_player.cc)
      const songId = rpGetSongId();
      const name = rpGetSongName();
      const idx = (farmHouse.recordPlayerAlbumId || 0) + 1;
      return rpHasAlbum()
        ? `<div class="ui-status-row"><span class="label">🎵 Record Player</span><span class="value">Album #${idx} · ${name} (Song #${songId})</span></div>`
        : `<div class="ui-status-row"><span class="label">🎵 Record Player</span><span class="value">Kosong (Song #${songId})</span></div>`;
    })() : ''}
    ${player.blueFeather ? `<div class="ui-status-row"><span class="label">🪶 Blue Feather</span><span class="value">Sudah dimiliki (siap lamar)</span></div>` : ''}
    <div class="ui-status-row"><span class="label">🏭 Makers</span><span class="value">${
      [makers.mayonnaise ? 'Mayo' : '', makers.cheese ? 'Cheese' : '', makers.yarn ? 'Yarn' : ''].filter(s => s).join(' · ') || '—'
    }</span></div>
    <div class="ui-status-row" style="border-top:1px solid #444;margin-top:6px;padding-top:8px;">
      <span class="label">🧚 Harvest Sprites</span><span class="value"></span>
    </div>
    ${harvestSprites.map(s => {
      const hearts = hsHearts(s);
      const heartStr = '❤'.repeat(hearts) + '🤍'.repeat(10 - hearts);
      const taskStr = s.work_days_left > 0
        ? `${hsTaskLabel(s.current_task)} (${s.work_days_left}d)`
        : '—';
      return `<div class="ui-status-row"><span class="label">🧚 ${s.name}</span><span class="value">${heartStr} (${s.met ? (s.friendship|0) : '?'}) · ${taskStr}</span></div>`;
    }).join('')}
  `;
}

// ===== Portrait Renderer =====
function drawPortrait() {
  const pc = document.getElementById('ui-portrait');
  if (!pc) return;
  const pctx = pc.getContext('2d');
  pctx.imageSmoothingEnabled = false;
  pctx.clearRect(0, 0, 64, 64);
  const img = invAssets.player_face;
  if (img && img.complete && img.naturalWidth) {
    pctx.drawImage(img, 0, 0, img.naturalWidth, img.naturalHeight, 0, 0, 64, 64);
  } else {
    // Fallback: draw player sprite
    pctx.fillStyle = '#ff5722';
    pctx.fillRect(20, 20, 24, 24);
  }
}

// ===== Map Tab Live Update =====
// ===== Dynamic Zone Registry & Find Method =====
// Zone database with boundary boxes. Runtime: Array.find() detects zone.
// Harvest Vale map (40×30 tiles, TILE=32): Town (left half) + Forest (right half)
const zoneRegistry = [
  {
    id: 'town',
    name: 'Town',
    icon: '🏠',
    desc: 'Area desa dengan pondok, toko, kolam & area bertani.',
    minX: 0, maxX: 20 * TILE - 1,   // cols 0-19 (left half)
    minY: 0, maxY: MAP_H * TILE - 1,
  },
  {
    id: 'forest',
    name: 'Forest',
    icon: '🌲',
    desc: 'Hutan dengan pohon tinggi & peti harta tersembunyi.',
    minX: 20 * TILE, maxX: MAP_W * TILE - 1,   // cols 20-39 (right half)
    minY: 0, maxY: MAP_H * TILE - 1,
  },
];
let currentZoneId = null;

// Runtime Find: detect zone via Array.prototype.find()
function updateCurrentZone() {
  const zone = zoneRegistry.find(z =>
    player.x >= z.minX && player.x <= z.maxX &&
    player.y >= z.minY && player.y <= z.maxY
  );
  const newZoneId = zone ? zone.id : null;
  if (newZoneId !== currentZoneId) {
    const oldZoneId = currentZoneId;
    currentZoneId = newZoneId;
    if (zone && oldZoneId !== null) {
      // Only show toast/popup on actual zone transition (not initial detection)
      toast(`📍 Memasuki: ${zone.name}`, 'info');
      AudioManager.playZone();
      showPopup(zone.id === 'town' ? 'parsnip' : 'pumpkin', zone.name, 'pickup', zone.icon);
    }
    updateZoneHighlight();
    const label = zone ? zone.name : 'Unknown';
    const el1 = document.getElementById('ui-current-zone');
    if (el1) el1.textContent = label;
    const el2 = document.getElementById('ui-map-zone');
    if (el2) el2.textContent = label;
  }
}

function renderZoneCards() {
  const grid = document.getElementById('zoneGrid');
  if (!grid) return;
  grid.innerHTML = '';
  for (const zone of zoneRegistry) {
    const card = document.createElement('div');
    card.className = 'zone-card' + (zone.id === currentZoneId ? ' highlighted' : '');
    card.dataset.zoneId = zone.id;
    card.innerHTML = `
      <div class="zone-icon">${zone.icon}</div>
      <div class="zone-name">${zone.name}</div>
      <div class="zone-desc">${zone.desc}</div>
      <div class="zone-coords">x: ${zone.minX}-${zone.maxX} | y: ${zone.minY}-${zone.maxY}</div>
    `;
    grid.appendChild(card);
  }
}

function updateZoneHighlight() {
  document.querySelectorAll('.zone-card').forEach(card => {
    card.classList.toggle('highlighted', card.dataset.zoneId === currentZoneId);
  });
  const zone = zoneRegistry.find(z => z.id === currentZoneId);
  const label = zone ? zone.name : 'Unknown';
  const el1 = document.getElementById('ui-current-zone');
  if (el1) el1.textContent = label;
  const el2 = document.getElementById('ui-map-zone');
  if (el2) el2.textContent = label;
}

function updateMapTab() {
  const tile = document.getElementById('ui-map-tile');
  const px = document.getElementById('ui-map-px');
  const cam = document.getElementById('ui-map-cam');
  if (tile) tile.textContent = `(${Math.floor(player.x / TILE)}, ${Math.floor(player.y / TILE)})`;
  if (px) px.textContent = `(${Math.round(player.x)}, ${Math.round(player.y)})`;
  if (cam) cam.textContent = `(${Math.round(camera.x)}, ${Math.round(camera.y)})`;
}

// ===== Inventory Grid Renderer (Drag-and-Drop) =====
function renderInventory() {
  const grid = document.getElementById('inventoryGrid');
  if (!grid) return;
  grid.innerHTML = '';
  let occupied = 0;
  for (let i = 0; i < INV_SLOTS; i++) {
    const slot = document.createElement('div');
    slot.className = 'inv-slot';
    slot.dataset.slotIndex = i;
    if (!inventoryData[i]) slot.classList.add('empty');

    // Drop target listeners
    slot.addEventListener('dragover', handleDragOver);
    slot.addEventListener('drop', handleDrop);
    slot.addEventListener('dragleave', handleDragLeave);

    const item = inventoryData[i];
    if (item) {
      occupied++;
      const itemEl = document.createElement('div');
      itemEl.className = 'inv-item';
      itemEl.draggable = true;
      itemEl.dataset.slotIndex = i;
      itemEl.dataset.itemId = item.id;

      // Render real sprite to canvas (NOT placeholder colors)
      const itemCanvas = document.createElement('canvas');
      itemCanvas.width = 48;
      itemCanvas.height = 48;
      const ictx = itemCanvas.getContext('2d');
      ictx.imageSmoothingEnabled = false;
      const img = invAssets[item.assetKey];
      if (img && img.complete && img.naturalWidth) {
        const sw = img.naturalWidth, sh = img.naturalHeight;
        const scale = Math.min(48 / sw, 48 / sh, 4);
        const dw = sw * scale, dh = sh * scale;
        ictx.drawImage(img, 0, 0, sw, sh, (48 - dw) / 2, (48 - dh) / 2, dw, dh);
      } else {
        ictx.fillStyle = '#444';
        ictx.fillRect(8, 8, 32, 32);
      }
      itemEl.appendChild(itemCanvas);

      // Drag source listeners
      itemEl.addEventListener('dragstart', handleDragStart);
      itemEl.addEventListener('dragend', handleDragEnd);
      // Right-click → Drop item (Context Menu Hijacking)
      itemEl.addEventListener('contextmenu', (e) => {
        e.preventDefault();   // block browser context menu
        dropItem(i);
      });

      if (item.quantity > 1) {
        const count = document.createElement('div');
        count.className = 'inv-count';
        count.textContent = '×' + item.quantity;
        slot.appendChild(count);
      }

      const tip = document.createElement('div');
      tip.className = 'inv-tooltip';
      tip.textContent = `${item.name} (${item.type})`;
      slot.appendChild(tip);

      slot.appendChild(itemEl);
    }
    grid.appendChild(slot);
  }
  const countEl = document.getElementById('ui-inv-count');
  if (countEl) countEl.textContent = `${occupied} / ${INV_SLOTS}`;
}

// ===== Drag-and-Drop Handlers (HTML5 API → Unity lifecycle mimic) =====
let draggedFromSlot = null;
function handleDragStart(e) {
  const slotIndex = parseInt(e.target.dataset.slotIndex, 10);
  draggedFromSlot = slotIndex;
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', String(slotIndex));
  e.target.closest('.inv-slot').classList.add('dragging');
  toast(`📤 Picked up: ${inventoryData[slotIndex]?.name || 'item'}`);
}
function handleDragOver(e) {
  e.preventDefault();   // MUST preventDefault to allow drop
  e.dataTransfer.dropEffect = 'move';
  e.currentTarget.classList.add('drag-over');
}
function handleDragLeave(e) {
  e.currentTarget.classList.remove('drag-over');
}
function handleDrop(e) {
  e.preventDefault();
  const targetSlot = parseInt(e.currentTarget.dataset.slotIndex, 10);
  const sourceSlot = parseInt(e.dataTransfer.getData('text/plain') || draggedFromSlot, 10);
  e.currentTarget.classList.remove('drag-over');
  document.querySelectorAll('.inv-slot.dragging').forEach((s) => s.classList.remove('dragging'));
  if (isNaN(sourceSlot) || sourceSlot === targetSlot) {
    draggedFromSlot = null;
    return;
  }
  // SWAP LOGIC: exchange inventoryData[source] ↔ inventoryData[target]
  const tmp = inventoryData[targetSlot];
  inventoryData[targetSlot] = inventoryData[sourceSlot];
  inventoryData[sourceSlot] = tmp;
  renderInventory();
  renderToolbar();   // sync hotbar with swapped inventory (slots 0-4)
  const moved = inventoryData[targetSlot];
  toast(moved ? `🔄 Swapped: ${moved.name} → slot ${targetSlot + 1}` : `🔄 Moved to slot ${targetSlot + 1}`);
  draggedFromSlot = null;
}
function handleDragEnd(e) {
  document.querySelectorAll('.inv-slot.dragging, .inv-slot.drag-over').forEach((s) => {
    s.classList.remove('dragging', 'drag-over');
  });
  draggedFromSlot = null;
}

// ===== Async load inventory assets =====
function loadInvAssets() {
  return new Promise((resolve) => {
    const keys = Object.keys(INV_ASSET_PATHS);
    let loaded = 0;
    if (keys.length === 0) { resolve(); return; }
    keys.forEach((key) => {
      const img = new Image();
      img.onload = img.onerror = () => {
        loaded++;
        if (img.naturalWidth) invAssets[key] = img;
        if (loaded === keys.length) resolve();
      };
      img.src = 'assets/' + INV_ASSET_PATHS[key];
    });
  });
}

// ---------- Init ----------
function init() {
  resizeCanvas();
  generateMap();
  const loaded = load();
  // Build ambient entities after loading so spawn points match the actual saved map.
  createAmbientLife();
  if (!loaded) {
    // first time - show intro
    renderToolbar();
    updateHUD();
    setTimeout(() => {
      toggleHelp(true);
    }, 300);
  } else {
    renderToolbar();
    updateHUD();
  }
  // Pre-load inventory assets (async, non-blocking — game starts immediately)
  loadInvAssets().then(() => {
    // Refresh bag if currently open
    if (isMenuOpen && activeTab === 'bag') renderInventory();
    if (isMenuOpen && activeTab === 'status') drawPortrait();
  });
  // Initialize zone detection + Map tab zone cards
  renderZoneCards();
  updateCurrentZone();
  // Auto-save every 5 sec
  setInterval(save, 5000);
  gameStarted = true;
  // Hide loading
  setTimeout(() => {
    document.getElementById('loading').style.display = 'none';
  }, 400);
  lastFrame = performance.now();
  AudioManager.playBGM();   // Start background music (real .ogg file)
  // Init AudioContext on first click too (browser gesture policy)
  document.addEventListener('click', () => { AudioManager.init(); AudioManager.resume(); }, { once: true });
  requestAnimationFrame(loop);
}

// ===== fomt 1:1 item database integration =====
// Loads fomt-data.js (81 tools, 171 foods, 95 articles, 103 products) and
// fomt-crops.js (21 crops, growth table, season/yield/regrow tables) as ES modules.
// Exposed as window.FOMT for the legacy non-module inline script to consume.
window.FOMT = null;
window.FOMT_CROPS = null;
// Called when fomt item DB finishes loading — initializes tool chest + shipping bin pre-display
window.onFomtDataReady = function() {
  // Only seed if ToolChest is empty (fresh game) — preserves saves with existing tools
  let chestEmpty = true;
  for (let i = 0; i < STORAGE_CAPACITY; i++) if (toolChest[i]) { chestEmpty = false; break; }
  if (chestEmpty) initToolChestFomt();
  // Only init shipping bin pre-display if no products have been shipped yet (fresh game)
  let anyShipped = shippingBin.valueShipped > 0;
  if (!anyShipped) initShippingBinFomt();
  if (typeof updateHUD === 'function') updateHUD();
  save();
};
window.onFomtCropDataReady = function() {
  // fomt crop DB loaded — build the fomt foodId → game crop key map (used by harvest).
  // Attach fomtCropId to any legacy cropMap entries that lack it (safe — doesn't change
  // growth behavior since advanceDay only takes the fomt path when BOTH fomtStage AND
  // fomtCounter are present). Legacy crops stay on the legacy growth path until replanted.
  if (typeof ensureFomtFoodMap === 'function') ensureFomtFoodMap();
  if (typeof cropMap !== 'undefined' && cropMap && window.FOMT_CROPS) {
    for (let y = 0; y < MAP_H; y++) {
      if (!cropMap[y]) continue;     // cropMap may not be populated yet (module loads before init)
      for (let x = 0; x < MAP_W; x++) {
        const c = cropMap[y][x];
        if (!c) continue;
        if (c.fomtCropId == null && CROPS[c.type]) c.fomtCropId = CROPS[c.type].fomtCropId;
      }
    }
  }
  if (typeof updateHUD === 'function') updateHUD();
};
import('./fomt-data.js').then(m => {
  window.FOMT = m;
  console.log('[fomt] Item DB loaded:', m.TOOLS.length, 'tools,', m.FOODS.length, 'foods,', m.ARTICLES.length, 'articles,', m.PRODUCTS.length, 'products');
  // If game has already booted before this resolves, refresh the shop/HUD
  if (typeof window.onFomtDataReady === 'function') window.onFomtDataReady();
}).catch(e => console.warn('[fomt] data load failed:', e));
import('./fomt-crops.js').then(m => {
  window.FOMT_CROPS = m;
  console.log('[fomt] Crop DB loaded:', Object.keys(m.CROP_SEASON).length, 'crop types,', m.FIELD_PLOTS, 'field plots');
  if (typeof window.onFomtCropDataReady === 'function') window.onFomtCropDataReady();
}).catch(e => console.warn('[fomt] crop load failed:', e));

window.addEventListener('load', init);
</script>
</body>
</html>
