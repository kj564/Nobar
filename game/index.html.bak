const invAssets = {};  // loaded async at init
let toastList = [];
let nearbyAction = null; // {type:'shop'|'sleep'|'npc', x, y}
let npcs = [];
// Ambient wildlife and scenery use the installed Sunnyside sprite strips.
// They are visual world entities, separate from solid map collision.
let ambientAnimals = [];
