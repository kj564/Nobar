{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "installCommand": "bun install",
  "outputDirectory": ".next",
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/cdn-proxy/bcdnxw/:path*",
      "destination": "https://bcdnxw.hakunaymatata.com/:path*",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "Referer" },
          "args": "https://mzfi.me/"
        },
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "User-Agent" },
          "args": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        }
      ]
    }
  ]
}
